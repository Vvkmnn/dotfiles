brew "colima"
brew "shellcheck"
brew "xcodes"
brew "supabase/tap/supabase"
# window manager stack
brew "koekeishiya/formulae/yabai"
brew "koekeishiya/formulae/skhd"
brew "felixkratz/formulae/sketchybar"
# brew "felixkratz/formulae/borders"   # off fleet-wide 2026-07-11 — sketchybar signals focus; borders were noise
brew "crissnb/dynamicisland/dynamicislandsketchybar"
brew "acsandmann/tap/menuanywhere"
brew "macmon"                                    # Apple Silicon power/temp/cpu/gpu telemetry — sketchybar bar-daemon pipes it (helpers/bar-daemon.swift:917)
brew "joachimbrindeau/ccusage-monitor/ccusage-monitor"
# GUI apps
cask "ghostty"
