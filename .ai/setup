  cat <<'BREW'
tap "koekeishiya/formulae"
tap "felixkratz/formulae"
tap "crissnb/dynamicisland"
tap "acsandmann/tap"
tap "supabase/tap"
tap "joachimbrindeau/ccusage-monitor"
# core CLI
brew "coreutils"
brew "openssl@3"
brew "xz"
brew "zlib"
brew "bash"
brew "bat"
brew "fd"
brew "fzf"
brew "ripgrep"
brew "eza"
brew "zoxide"
brew "atuin"
brew "yazi"
brew "lf"
brew "jless"
brew "jq"
brew "pngpaste"
brew "neovim"
brew "lua"
brew "luarocks"
brew "tree-sitter"
brew "git"
brew "gh"
brew "git-delta"
brew "git-crypt"
brew "git-lfs"
brew "gnupg"
