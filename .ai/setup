brew "koekeishiya/formulae/skhd"
brew "felixkratz/formulae/sketchybar"
brew "felixkratz/formulae/borders"
brew "crissnb/dynamicisland/dynamicislandsketchybar"
brew "acsandmann/tap/menuanywhere"
brew "macmon"                                    # Apple Silicon power/temp/cpu/gpu telemetry — sketchybar bar-daemon pipes it (helpers/bar-daemon.swift:917)
