#!/usr/bin/env bash
# setup — the ONE self-contained command to bring this Mac to fleet parity.
#
#   ~/.ai/setup            run all: packages → fonts → services → macos → gate → doctor
#   ~/.ai/setup packages   brew bundle (inline list, tap-trust, one sudo, Xcode 2nd pass)
#   ~/.ai/setup fonts      install vendored SFMono Nerd Font → ~/Library/Fonts
#   ~/.ai/setup services   yabai/skhd/sketchybar/menuanywhere + tmux plugins
#   ~/.ai/setup xcode      headless Xcode via xcodes (Apple ID from 1Password) — one 2FA code
#   ~/.ai/setup macos      apply curated macOS defaults (sudo-free)
#   ~/.ai/setup gate       open the manual TCC panes + checklist
#   ~/.ai/setup doctor     verify the machine (self-contained)
#   ~/.ai/setup help
#
# SELF-CONTAINED on purpose: the package list + macOS defaults live INLINE here —
# this is the source of truth Claude/the owner edit. `~/.setup/` is frozen
# reference (the laptop's fuller macos.sh/Brewfile) for inspiration + maintenance.
# Plain bash (no just/make — must run on a fresh Mac). Every phase is idempotent.
# Assumes the dotfiles are deployed + git-crypt unlocked (fonts need it).
#
# ─────────────────────────────────────────────────────────────────────────────
# DESIGN NOTES & CHANGELOG  (read before editing — keep this current)
#
# 2026-06-26 — created + consolidated for vBookNeo (8GB A18 Pro, macOS 26 Tahoe).
#   WHY self-contained: the package list (_brewfile) + macOS defaults (phase_macos)
#     live INLINE so a future Claude edits ONE place. `~/.setup/` (the laptop's
#     fuller macos.sh ~886L + Brewfile) is FROZEN REFERENCE — inspiration/maintenance,
#     not called at runtime. Collapsed 3 parallel impls (this, an old `ai.sh`, and
#     AI.md's inline bash) down to this one file.
#   WHY plain bash (no just/make): chicken-egg — a task runner needs `brew install`
#     first, but this must run on a FRESH Mac before anything exists. bash is always
#     present; `setup <phase>` gives the same discoverability as `just <recipe>`.
#   WHY curated defaults (not macos.sh verbatim): macos.sh carries dead-app cruft
#     (Spectacle/Twitter/SizeUp/Transmission/Opera/GPGMail) + Safari/Chrome/Mail/iCal/
#     TextEdit app tweaks + sudo pmset/nvram bits that error on Apple silicon. Kept
#     ONLY the UX-defining, user-domain (sudo-free) set. To re-curate: diff against
#     ~/.setup/macos.sh and pull in what you actually use.
#   WHY fonts vendored (not a cask): the epk `font-sf-mono-nerd-font` cask registers
#     as family "SF Mono", but sketchybar/Ghostty reference "SFMono Nerd Font" → glyphs
#     render as `?`. The 12 hand-patched .otf (correct family) are vendored via
#     git-crypt in .assets/fonts and copied by `setup fonts`. Binary → can't inline.
#   WHY the gate is manual/honest: macOS won't let a script grant TCC or approve a
#     system extension, and can't reliably VERIFY them either (reading TCC.db needs
#     Full Disk Access — itself a gate). So `setup gate` only opens panes + instructs.
#   WHY macos is sudo-free: every curated default is user-domain. Only `packages`
#     needs sudo (casks + xcode-select), via need_sudo's one-prompt keep-alive.
#
# MAINTENANCE: edit `_brewfile()` (packages) + `phase_macos()` (defaults) here — they
#   are the source of truth. Keep `~/.setup/` as reference. Log gotchas in
#   ~/.ai/ISSUES.md so they aren't re-hit. After any edit: `bash -n ~/.ai/setup`.
#   When you change something, add a dated line to this changelog explaining WHY.
# ─────────────────────────────────────────────────────────────────────────────

set -uo pipefail

FONTS_SRC="$HOME/.assets/fonts"   # vendored .otf (binary — can't inline); git-crypt

# ── tiny UI ───────────────────────────────────────────────────────────────────
say()  { printf '\n\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m⚠\033[0m %s\n' "$*"; }
die()  { printf '\n\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

command -v brew >/dev/null 2>&1 || eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null)"

# ── one sudo + keep-alive, started on demand (only 'packages' needs it: casks) ──
_sudo_started=
need_sudo() {
  [ -n "$_sudo_started" ] && return 0
  say "sudo — one prompt, kept alive for the whole run"
  sudo -v || die "sudo is required here"
  ( while true; do sudo -n true; sleep 60; kill -0 "$$" 2>/dev/null || exit; done ) &
  trap 'kill %1 2>/dev/null' EXIT
  _sudo_started=1
  ok "sudo cached + refreshing every 60s"
}

# ── the package set (inline source of truth; .setup/Resources/Brewfile = reference) ──
