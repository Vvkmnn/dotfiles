cask "font-symbols-only-nerd-font"   # Symbols Nerd Font Mono — the glyph-fallback
                                     # superset (wifi/weather/dev-logo icons live ONLY
                                     # here; SFMono Nerd Font doesn't carry them).
# FONTS, two pieces:
#  1) SFMono Nerd Font (primary mono face) — NOT a cask: the epk cask registers as
#     family "SF Mono" (wrong); sketchybar/Ghostty need "SFMono Nerd Font". Vendored
#     as .otf in .assets/fonts (git-crypt), installed by `setup fonts`.
#  2) Symbols Nerd Font Mono (above) — CoreText fallback for glyphs SFMono lacks.
# Dropped `font-sf-pro` (rare, sudo .pkg): the sketchybar plugins (network_boxes,
# clock_analog) were switched to SFMono Nerd Font, so SF Pro is no longer referenced.
# NOTE: a fresh font install needs a re-login (restart) for CoreText to rebuild its
# fallback cache — otherwise some glyphs render as `?` until reboot.
BREW
}

# ── phases ────────────────────────────────────────────────────────────────────
phase_packages() {
  pgrep -f 'Library/Homebrew/brew' >/dev/null 2>&1 && die "another brew is running — let it finish, then re-run"
  command -v brew >/dev/null 2>&1 || die "Homebrew not found — install it first (AI.md P2)"
  need_sudo
  say "taps — trust the third-party ones (Homebrew 4.6+ tap-trust)"
  local t
  for t in koekeishiya/formulae felixkratz/formulae crissnb/dynamicisland acsandmann/tap supabase/tap joachimbrindeau/ccusage-monitor; do
    brew tap "$t" >/dev/null 2>&1; brew trust "$t" >/dev/null 2>&1 && ok "trusted $t"
  done
  say "brew bundle (Xcode is large + shows no progress — be patient)"
  brew bundle install --file=<(_brewfile) || warn "first pass had failures (menuanywhere needs Xcode) — run 'setup xcode' then re-run"
  local xc; xc=$(ls -d /Applications/Xcode*.app 2>/dev/null | sort -V | tail -1)
  if [ -n "$xc" ]; then
    sudo xcode-select -s "$xc/Contents/Developer" 2>/dev/null && ok "xcode-select → $(basename "$xc")"
    sudo xcodebuild -license accept 2>/dev/null && ok "Xcode license accepted"
    brew bundle install --file=<(_brewfile) >/dev/null 2>&1 && ok "Xcode-dependent items (menuanywhere) built"
  fi
  # Materialize mise-managed runtimes (python · node · cmake · rust) from the tracked
  # ~/.config/mise/config.toml. brew installs `mise` but never populates it — without
  # this, python3 is missing → the shell warns every init and p10k instant prompt breaks.
  # rust (core:rust) also sets the rustup default toolchain → `cargo` works afterward.
  if command -v mise >/dev/null 2>&1; then
    mise install -y >/dev/null 2>&1 && ok "mise tools installed (python · node · cmake · rust)" || warn "mise install had issues — run 'mise install'"
  fi

  # cargo-installed tools (not in Homebrew). Needs the rust toolchain above; --locked is
  # idempotent (no-op when current). Future cargo tools just join the `for` list.
  if command -v cargo >/dev/null 2>&1; then
    local c
    for c in terminal_gameboy; do
      cargo install --locked "$c" >/dev/null 2>&1 && ok "cargo: $c" || warn "cargo install $c failed"
    done
  fi
}

phase_fonts() {
  # Family must be exactly "SFMono Nerd Font" for sketchybar + Ghostty. Vendored
  # .otf (git-crypt) in .assets/fonts — the epk cask registers as "SF Mono" (wrong).
  say "fonts — install vendored SFMono Nerd Font"
  [ -d "$FONTS_SRC" ] || { warn "no $FONTS_SRC (pull dotfiles + git-crypt unlock first)"; return 0; }
  local probe; probe=$(ls "$FONTS_SRC"/*.otf "$FONTS_SRC"/*.ttf 2>/dev/null | head -1)
  if [ -n "$probe" ] && head -c 9 "$probe" 2>/dev/null | grep -q GITCRYPT; then
    die "fonts still git-crypt-encrypted — unlock first (op document get Dotfiles → git-crypt unlock)"
  fi
  local n=0 f
  for f in "$FONTS_SRC"/*.otf "$FONTS_SRC"/*.ttf; do
    [ -e "$f" ] || continue
    cp "$f" "$HOME/Library/Fonts/" && n=$((n+1))
  done
  ok "installed $n font file(s) → ~/Library/Fonts"
  command -v sketchybar >/dev/null 2>&1 && brew services restart sketchybar >/dev/null 2>&1 && ok "sketchybar reloaded"
  warn "quit + relaunch Ghostty to pick up the font"
}

phase_services() {
  say "services — window manager + tmux plugins"
  command -v yabai >/dev/null 2>&1 && { yabai --start-service 2>/dev/null; ok "yabai"; }
  command -v skhd  >/dev/null 2>&1 && { skhd  --start-service 2>/dev/null; ok "skhd"; }
  # Compile the sketchybar bar-daemon (Swift). The binary is gitignored, so it must be
  # built on each machine BEFORE sketchybar starts (startup_cascade.sh launches it).
  # Without it: no /tmp/sketchybar_cache → cpu/gpu/temp/memory/power show no data.
  local bd="$HOME/.config/sketchybar/helpers"
  if [ -f "$bd/bar-daemon.swift" ] && command -v swiftc >/dev/null 2>&1; then
    if [ ! -x "$bd/bar-daemon" ] || [ "$bd/bar-daemon.swift" -nt "$bd/bar-daemon" ]; then
      ( cd "$bd" && swiftc -O -o bar-daemon bar-daemon.swift ) 2>/dev/null \
        && ok "bar-daemon compiled" || warn "bar-daemon compile failed (run: swiftc -O -o $bd/bar-daemon $bd/bar-daemon.swift)"
    else
      ok "bar-daemon up to date"
    fi
  fi
  local svc
  for svc in sketchybar menuanywhere; do   # borders off (see _brewfile)
    command -v "$svc" >/dev/null 2>&1 && { brew services start "$svc" >/dev/null 2>&1; ok "$svc"; }
  done
  if [ -x "$HOME/.config/tmux/plugins/tpm/bin/install_plugins" ]; then
    "$HOME/.config/tmux/plugins/tpm/bin/install_plugins" >/dev/null 2>&1 && ok "tmux plugins (tpm)"
  fi
}

phase_xcode() {
  say "Xcode — headless install via xcodes (Apple ID from 1Password)"
  local xc; xc=$(ls -d /Applications/Xcode*.app 2>/dev/null | sort -V | tail -1)
  [ -n "$xc" ] && { ok "already present: $(basename "$xc")"; return 0; }
  command -v xcodes >/dev/null 2>&1 || { warn "xcodes missing — 'setup packages' installs it"; return 0; }
  command -v op     >/dev/null 2>&1 || { warn "1Password CLI (op) needed — see README (secrets)"; return 0; }
  warn "you'll enter a one-time 2FA code (Apple policy — codes expire in ~30s, use the freshest)"
  XCODES_USERNAME="op://Personal/Apple/username" XCODES_PASSWORD="op://Personal/Apple/password" \
    op run -- xcodes install --latest || warn "xcodes failed (retry with a fresh 2FA code)"
}

phase_macos() {
  # Curated UX defaults (sudo-free — user domain only). Source of truth; the
  # laptop's fuller ~/.setup/macos.sh is frozen reference for anything deeper.
  say "macOS defaults — curated UX"
  # General UI/UX + privacy
  defaults write com.apple.PowerChime ChimeOnAllHardware -bool false
  # Reduce Transparency = solid/filled menu bar (blends with sketchybar's black bar).
  # TCC-protected on Tahoe: `defaults write` is silently REFUSED, so verify and fall
  # back to a manual gate rather than pretend it applied.
  defaults write com.apple.universalaccess reduceTransparency -bool true 2>/dev/null
  if [ "$(defaults read com.apple.universalaccess reduceTransparency 2>/dev/null)" != "1" ]; then
    warn "Reduce Transparency: toggle ON manually → System Settings ▸ Accessibility ▸ Display (macOS blocks scripting this)"
  fi
  defaults write NSGlobalDomain AppleHighlightColor -string "1.000000 0.733333 0.721569"
  defaults write NSGlobalDomain NSTableViewDefaultSizeMode -int 2
  defaults write NSGlobalDomain AppleShowScrollBars -string "Always"
  defaults write NSGlobalDomain NSUseAnimatedFocusRing -bool false
  defaults write NSGlobalDomain NSWindowResizeTime -float 0.001
  defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
  defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true
  defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
  defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true
  defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false
  defaults write com.apple.print.PrintingPrefs "Quit When Finished" -bool true
  defaults write com.apple.LaunchServices LSQuarantine -bool false
  defaults write com.apple.systempreferences NSQuitAlwaysKeepsWindows -bool false
  defaults write com.apple.CrashReporter DialogType -string "none"
  defaults write com.apple.SoftwareUpdate ScheduleFrequency -int 1
  # Typing — substitutions off (annoying mid-code)
  defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
  defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
  defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
  defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
  defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
  # Snappy + WM-friendly (this is what makes sketchybar/yabai feel right)
  defaults write NSGlobalDomain NSAutomaticWindowAnimationsEnabled -bool false
  defaults write NSGlobalDomain NSToolbarTitleViewRolloverDelay -float 0
  defaults write NSGlobalDomain _HIHideMenuBar -bool true
  defaults write NSGlobalDomain AppleMenuBarVisibleInFullscreen -bool false
  defaults write NSGlobalDomain AppleMiniaturizeOnDoubleClick -bool false
  defaults write NSGlobalDomain AppleActionOnDoubleClick -string "None"
  defaults write NSGlobalDomain AppleSpacesSwitchOnActivate -bool true
  # Silence UI noise (visual indicators only): UI sound effects off, alert beep muted.
  # KEEP volume-change feedback — the level pop is wanted (don't set beep.feedback).
  # Startup chime handled via nvram. Notification sounds (email/app dings) are per-app
  # in System Settings ▸ Notifications — a manual gate, not a scriptable default.
  defaults write NSGlobalDomain com.apple.sound.uiaudio.enabled -bool false
  defaults write NSGlobalDomain com.apple.sound.beep.volume -float 0
  ok "general · typing · snappy UI · menu-bar autohide · silent UI"
  # Keyboard — fast repeat (vim), full keyboard access, traditional scroll
  defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
  defaults write NSGlobalDomain KeyRepeat -int 0
  defaults write NSGlobalDomain InitialKeyRepeat -int 15
  defaults write NSGlobalDomain AppleKeyboardUIMode -int 3
  defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false
  # Trackpad — tap to click
  defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
  defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
  defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
  ok "keyboard · trackpad"
  # Screenshots + lock security + font smoothing
  defaults write com.apple.screensaver askForPassword -int 1
  defaults write com.apple.screensaver askForPasswordDelay -int 0
  defaults write com.apple.screencapture type -string "png"
  defaults write com.apple.screencapture disable-shadow -bool true
  defaults write NSGlobalDomain AppleFontSmoothing -int 2
  # Finder
  defaults write com.apple.finder CreateDesktop -bool false
  defaults write com.apple.finder QuitMenuItem -bool true
  defaults write com.apple.finder DisableAllAnimations -bool true
  defaults write com.apple.finder AppleShowAllFiles -bool true
  defaults write NSGlobalDomain AppleShowAllExtensions -bool true
  defaults write com.apple.finder ShowStatusBar -bool true
  defaults write com.apple.finder ShowPathbar -bool true
  defaults write com.apple.finder _FXShowPosixPathInTitle -bool true
  defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"
  defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false
  defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"
  defaults write com.apple.finder _FXSortFoldersFirst -bool true
  defaults write com.apple.finder WarnOnEmptyTrash -bool false
  defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
  defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true
  chflags nohidden "$HOME/Library" 2>/dev/null || true
  ok "finder"
  # iCloud Drive reach — ~/icloud symlink so `cd icloud` / `z icloud` work (logical
  # path contains "icloud" → zoxide indexes it; raw CloudDocs path never matches).
  [ -L "$HOME/icloud" ] || ln -s "$HOME/Library/Mobile Documents/com~apple~CloudDocs" "$HOME/icloud"
  command -v zoxide >/dev/null && zoxide add "$HOME/icloud" 2>/dev/null
  ok "icloud reach (~/icloud)"
  # Dock — small, autohide, no clutter, WM-friendly
  defaults write com.apple.dock tilesize -int 36
  defaults write com.apple.dock magnification -bool true
  defaults write com.apple.dock largesize -int 60
  defaults write com.apple.dock mineffect -string "scale"
  defaults write com.apple.dock minimize-to-application -bool true
  defaults write com.apple.dock show-recents -bool false
  defaults write com.apple.dock mru-spaces -bool false
  defaults write com.apple.dock expose-group-apps -bool false
  defaults write com.apple.dock show-process-indicators -bool true
  defaults write com.apple.dock showhidden -bool true
  defaults write com.apple.dock no-bouncing -bool true
  defaults write com.apple.dock launchanim -bool false
  defaults write com.apple.dock expose-animation-duration -float 0.1
  defaults write com.apple.dock autohide-delay -float 0
  defaults write com.apple.dock autohide -bool true
  defaults write com.apple.dock persistent-apps -array
  defaults write com.apple.dock recent-apps -array
  defaults write com.apple.dock wvous-tr-corner -int 2   # top-right → Mission Control
  defaults write com.apple.dock wvous-tr-modifier -int 0
  defaults write com.apple.dock wvous-br-corner -int 5   # bottom-right → screen saver
  defaults write com.apple.dock wvous-br-modifier -int 0
  ok "dock + hot corners"
  # Stage Manager off, clean desktop (yabai-friendly)
  defaults write com.apple.WindowManager GloballyEnabled -bool false
  defaults write com.apple.WindowManager HideDesktop -bool true
  defaults write com.apple.WindowManager StandardHideDesktopIcons -bool true
  defaults write com.apple.WindowManager AutoHide -bool true
  defaults write com.apple.WindowManager EnableTiledWindowMargins -bool false
  defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -bool false
  ok "stage manager off · clean desktop"
  killall Dock Finder SystemUIServer 2>/dev/null || true
  ok "applied (Dock/Finder restarted; menu-bar autohide may need a re-login to fully take)"
}

phase_gate() {
  # macOS won't let a script grant TCC, approve a system extension, install a
  # config profile, or hide notification previews — and it can't reliably verify
  # them either (reading TCC.db needs Full Disk Access, itself a gate). So this
  # opens the panes + tells you exactly what to do; an LLM driving setup relays each.
  say "GATE — grant/approve these in System Settings (a script genuinely cannot)"
  warn "Accessibility:       add yabai, skhd, sketchybar, Karabiner-Elements"
  warn "Input Monitoring:    add skhd, Karabiner-Elements (karabiner_grabber)"
  warn "System extensions:   approve Karabiner, Mullvad, AdGuard when prompted"
  warn "Reduce Transparency: Accessibility ▸ Display — ON (solid/filled menu bar; TCC-blocks scripting)"
  warn "vProfile:            install ~/.ai/vProfile.mobileconfig (notification sound OFF, visual only)"
  warn "Show previews:       Notifications ▸ Show previews → Never (hide content; not profile-able on macOS)"
  warn "Wallpaper:           set Aerial \"Shuffle Earth\" manually"
  open 'x-apple.systempreferences:com.apple.settings.PrivacySecurity?Privacy_Accessibility' 2>/dev/null
  open 'x-apple.systempreferences:com.apple.settings.PrivacySecurity?Privacy_ListenEvent' 2>/dev/null
  [ -f "$HOME/.ai/vProfile.mobileconfig" ] && open "$HOME/.ai/vProfile.mobileconfig" 2>/dev/null
  open 'x-apple.systempreferences:com.apple.preferences.configurationprofiles' 2>/dev/null
  open 'x-apple.systempreferences:com.apple.Notifications-Settings.extension' 2>/dev/null
  warn "after granting: yabai --restart-service && skhd --restart-service"
}

phase_doctor() {
  # Self-contained "did my setup work" check. No external deps.
  say "doctor — did setup work?"
  brew bundle check --file=<(_brewfile) >/dev/null 2>&1 && ok "all packages installed" || warn "packages incomplete — run 'setup packages'"
  local p
  for p in yabai skhd sketchybar; do pgrep -x "$p" >/dev/null && ok "$p running" || warn "$p not running (grant Accessibility, then 'setup services')"; done
  if ls "$HOME/Library/Fonts/"SFMono*Nerd*Font* >/dev/null 2>&1; then ok "SFMono Nerd Font installed"; else warn "SFMono Nerd Font missing — run 'setup fonts'"; fi
  local t miss=0
  for t in tmux nvim git gh mise uv node rg fzf jq; do command -v "$t" >/dev/null 2>&1 || { warn "missing: $t"; miss=1; }; done
  [ "$miss" = 0 ] && ok "core CLI tools present"
  # mise-managed runtimes materialized? (the gap that broke python3 + p10k)
  command -v mise >/dev/null 2>&1 && { mise ls 2>/dev/null | grep -qi missing && warn "mise tools missing — run 'mise install'" || ok "mise tools present (python · node · cmake)"; }
  # docker is on-demand via colima (not autostarted) — note, don't fail
  command -v colima >/dev/null 2>&1 && { colima status >/dev/null 2>&1 && ok "colima running (docker ready)" || ok "docker idle — run 'colima start' when needed (on-demand by design)"; }
}

usage() {
  cat <<'EOF'

setup — bring this Mac to fleet parity (self-contained).   ~/.ai/setup [phase]

  (none)     run all: packages → fonts → services → macos → gate → doctor
  packages   brew bundle (inline list, tap-trust, one sudo, Xcode 2nd pass)
  fonts      install vendored SFMono Nerd Font → ~/Library/Fonts
  services   yabai/skhd/sketchybar/menuanywhere + tmux plugins
  xcode      headless Xcode via xcodes (Apple ID from 1Password) — one 2FA code
  macos      apply curated macOS defaults (sudo-free)
  gate       open the manual TCC panes + checklist
  doctor     verify the machine (self-contained)
  help       this

Package list + macOS defaults are INLINE here (the source of truth).
~/.setup/ is frozen reference. See ~/.ai/README.md.
EOF
}

# ── dispatch ──────────────────────────────────────────────────────────────────
case "${1:-all}" in
  all)            phase_packages; phase_fonts; phase_services; phase_macos; phase_gate; phase_doctor ;;
  packages)       phase_packages ;;
  fonts)          phase_fonts ;;
  services)       phase_services ;;
  xcode)          phase_xcode ;;
  macos)          phase_macos ;;
  gate)           phase_gate ;;
  doctor|check)   phase_doctor ;;
  help|-h|--help) usage ;;
  *)              warn "unknown phase: $1"; usage; exit 1 ;;
esac
