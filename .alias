# ┌────────────────────────────────── ~/.alias ─ Command shortcuts ────────────┐
#  Vivek Menon <mail@vvkmnn.xyz>
# └────────────────────────────────────────────────────────────────────────────┘
#  Purpose: Short aliases for common commands
#  Contains: Claude/AI, dotfiles, git, modern CLI (bat, fd, rg)
#  Convention: Single letter = frequent, comma prefix = config edit

# ┌───────────────────────────────────────────────────────────────── guard ────┐
  [ -n "$__ALIAS_SOURCED" ] && return
  __ALIAS_SOURCED=1
  [ -n "$AI_SANDBOX_ONLY" ] && return
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────── claude ────┐
  # continue session (moved to ~/.functions)
  # alias c='claude --continue'
  # new session (moved to ~/.functions)
  # alias cl='claude'
  # add directory
  alias ,c.='claude --add-dir .'
  # edit config
  alias ,c='v ~/.claude/CLAUDE.md'
  # resume
  alias ,clr='claude --resume'
  # verbose
  alias ,clv='claude --verbose --continue'
  # usage
  alias ,cu='ccusage blocks --live'
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────────── dotfiles ───┐
  # git wrapper
  alias dotfiles="/usr/bin/git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME"
  alias d='dotfiles'
  # lazygit — unused (not installed); re-enable if you reinstall lazygit
  # alias dg='lazygit --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'
  # status
  alias ds='dotfiles status --untracked-files=no'
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── editor ──┐
  # neovim
  alias v='nvim'
  alias v!='nvim --noplugin --clean'
  alias vl='nvim -c "normal '\''0"'
  # vim
  alias ov='vim'
  alias ov!="vim -u NONE -N"
  # pipe
  alias -g V='| nvim -c "setlocal buftype=nofile bufhidden=wipe" -c "nnoremap <buffer> q :q!<CR>" -'
  # cleanup
  alias vclear='rm -rf ~/.local/share/nvim/ ~/.local/state/nvim/ ~/.cache/nvim/'
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────────── git ───┐
  alias g='git'
  alias gs='git status'
  # danger
  alias ,git-undo='git clean -fd && git reset --hard'
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────────────── tools ──┐
  # bat — use `bat` directly for highlighting; cat stays REAL cat
  #   (removed cat=bat + cath aliases 2026-07-07: bat broke `cat -v` and pipes)
  # fd
  alias find='fd'
  alias fdfind='fd'
  # fzf — f() is now a function in ~/.functions that searches
  # names (fd), contents (rg), Spotlight (mdfind) and cd's into the result
  # alias f='fzf'
  # eza
  alias e='eza --group-directories-first --icons=auto'
  alias ll='eza -lah --group-directories-first --icons=auto'
  # yazi
  alias yy='yazi'
  # lazygit — unused (not installed); re-enable if you reinstall lazygit
  # alias lg='lazygit'
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── config ──┐
  # shell
  alias ,a='v ~/.alias'
  alias ,l='v ~/.logo'
  alias ,s='v ~/.shell'
  # apps
  alias ,g='v ~/.config/ghostty/config'
  alias ,sb='v ~/.config/sketchybar/sketchybarrc'
  alias ,sk='v ~/.skhdrc'
  alias ,t='v ~/.config/tmux/tmux.conf'
  alias ,w='v ~/.config/wezterm/wezterm.lua'
  alias ,y='v ~/.yabairc'
  # neovim
  alias ,nv='v ~/.config/nvim/lua/'
  alias ,vc='v ~/.config/nvim/lua/plugins/custom.lua'
  alias ,vd='v ~/.config/nvim/lua/plugins/disable.lua'
  alias ,vk='v ~/.config/nvim/lua/config/keymaps.lua'
  alias ,vm='v ~/.config/nvim/lua/plugins/modify.lua'
  alias ,vo='v ~/.config/nvim/lua/config/options.lua'
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────────── nav ───┐
  alias ,f='cd **'
  alias ,r='rg'
  alias ,x='exit'
  alias ,z='zed -n'
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── system ──┐
  alias l='source ~/.logo'
  alias ptop='sudo powermetrics --show-process-energy'
  alias rr='sudo reboot'
  alias today=$(date '+%F_%H:%M:%S')
  alias zz='exec zsh -l'
  alias ,clear='clear'
  alias ,u=update_all
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────────── terminal ───┐
  # wezterm (using ghostty now)
  # alias wz='wezterm'
  # alias wz!='wezterm start -- bash --norc'
  # alias wz!!='wezterm -n start -- bash --norc'
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────────── platform ───┐
  case "$(uname -s)" in
  Darwin)
      # ─────────────────────────────────────────────────────────────── brew ──
      alias cask='brew cask'
      alias hbash='/opt/homebrew/bin/bash'

      # ──────────────────────────────────────────────────────────────── gcc ──
      alias gcc="gcc-12"
      alias g++="g++-12"

      # ────────────────────────────────────────────────────────────── emacs ──
      # alias e='emacsclient --c'

      # ─────────────────────────────────────────────────────────────── cloud ──
      # alias v~='cd ~'
      # alias v~~='cd ~/Library/Mobile\ Documents/com~apple~CloudDocs/Documents'

      # ───────────────────────────────────────────────────────────── python ──
      # alias py3=python3
      # alias pi3=pip3

      # ───────────────────────────────────────────────────────────── window ──
      alias wms='yabai --start-service && skhd --start-service'
      alias wmx='yabai --stop-service && skhd --stop-service'
      alias wmr='yabai --restart-service && skhd --restart-service && brew services restart sketchybar'
      # alias brs='brew services restart skhd'                                  # use wmr
      # alias bry='brew services restart yabai'                                 # use wmr
      # alias ,ys='yabai --restart-service && skhd --restart-service'           # use wmr
      # alias ,ystart='yabai --start-service'                                   # use wms
      # alias ,ystop='yabai --stop-service'                                     # use wmx
      # alias _game="brew services stop yabai && brew services stop skhd"       # use wmx
      # alias _normal="brew services start yabai && brew services start skhd"   # use wms
      ;;
  Linux)
      # alias e='export DISPLAY=:0.0; export LIBGL_ALWAYS_INDIRECT=1; setxkbmap -layout us; setsid emacs'
      alias open='nautilus .'
      ;;
  CYGWIN* | MINGW32* | MSYS* | MINGW*) ;;
  esac
# └────────────────────────────────────────────────────────────────────────────┘

