# NOTE Changed this
# Custom prefix.
#  typeset -g POWERLEVEL9K_DIR_PREFIX=' ॐ  '

# Import
source ~/.functions

# Dotfiles
alias dotfiles="/usr/bin/git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME"
alias d="dotfiles"
alias ds="dotfiles status --untracked-files=no"
# alias dg='nvim -c ":lua OpenDotfilesInNeogit()"'
alias dg='lazygit --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'

# Quickedit
alias ,f='cd **'
alias ,r='rg'
alias ,x='exit'
alias ,z='zed -n'
alias ,nv='nv ~/.config/nvim/lua/'
alias ,vc='nv ~/.config/nvim'
alias ,vk='nv ~/.config/nvim/lua/config/keymaps.lua'
alias ,vc='nv ~/.config/nvim/lua/plugins/custom.lua'
alias ,vm='nv ~/.config/nvim/lua/plugins/modify.lua'
alias ,vd='nv ~/.config/nvim/lua/plugins/disable.lua'
alias ,vo='nv ~/.config/nvim/lua/config/options.lua'
alias ,s='nv ~/.shell'
alias ,a='nv ~/.alias'
alias ,t='nv ~/.config/tmux/tmux.conf'
alias ,w='nv ~/.config/wezterm/wezterm.lua'
alias ,g='nv ~/.config/ghostty/config'
alias ,y='nv ~/.yabairc'
alias ,sk='nv ~/.skhdrc'
# alias ,c='nv' /Users/v/Library/Application\ Support/Claude/claude_desktop_config.json'
alias ,c='nv ~/.claude/CLAUDE.md'
alias ,sb='nv ~/.config/sketchybar/sketchybarrc'
# alias ,h='history | nnv'im -'
alias ,ys='yabai --restart-sernvice && skhd --restart-service'
alias ,l='nv ~/.logo'
alias ,c='code $HOME/Library/Application\ Support/Code/User/settings.json'

# Vscode
# vanilla mode
# alias v=code
alias ,vc='code --new-window --user-data-dir "$(mktemp -d)" --extensions-dir "$(mktemp -d)"
'

# google
# GCP Account Switching - Multiple Google Cloud Configurations
alias ,gcp-casper='gcloud config configurations activate casper-account'
alias ,gcp-personal='gcloud config configurations activate personal-account'
# alias gcp-list='gcloud config configurations list'        # Shows all GCP configurations and which is active
# alias gcp-current='gcloud config get-value account && gcloud config get-value project'  # Shows current account and project

# claude
# alias claude="~/.claude/local/claude"

## cursor
# c = cursor --no-plugins
# c = cursor --no-plugins
alias ,mcp-chrome-debug=debugger_chrome
# alias ,cursor-browser-mcp-server='npx @agentdeskai/browser-tools-server@1.2.0'
alias ,mcp-browser-server='npx @agentdeskai/browser-tools-server@1.2.0'

## git
alias gs='git status'
alias ,git-undo='git clean -fd && git reset --hard'

# update
alias ,u=update_all

# Claude
alias ,ai='claude --model sonnet --print'
alias ,c='claude'
alias ,c.='claude --add-dir .'
alias ,cl='claude --continue'
alias ,clv='claude --verbose --continue'
alias ,clr='claude --resume'
alias ,cu='ccusage blocks --live'
alias ,clear='clear && clear && clear'

# alias cl='claude --verbose --model sonnet --continue'
# alias cln='claude --verbose --model sonnet'
# alias ai=c

# pokemon
# https://github.com/zachMahan64/pokemon-tbje/
# java -jar target/pokemon_tbje-1.0.jar
alias pkm="cd /Users/v/Documents/dev/pokemon-tbje/ && java -jar target/pokemon_tbje-1.0.jar"

## cursor vclear

# util
alias ptop='sudo powermetrics --show-process-energy'

# alias dg='lazygit --use-config-file "$HOME/Library/Application Support/lazygit/config.yml" --work-tree ~ --git-dir=$HOME/.dotfiles/'
# alias dg='lazygit --use-config-file "$HOME/.config/yadm/lazygit.yml,$HOME/Library/Application Support/lazygit/config.yml" --work-tree ~ --git-dir=$HOME/.dotfiles/'
# alias yl='lazygit --use-config-file "$HOME/.config/yadm/lazygit.yml,$HOME/Library/Application Support/lazygit/config.yml" --work-tree ~ --git-dir=$HOME/.dotfiles/'
# alias da="dotfiles add"
# alias dc="dotfiles commit -m"
# alias dpo="dotfiles push origin"

## Machine
# debian
# alias u="sudo apt update && sudo apt upgrade && sudo apt autoremove"
# alias v="/mnt/c/Users/v"
# macOS
alias rr='sudo reboot'

## Zsh
alias zz='exec zsh -l'

## cursor
# alias c='cursor'
# alias c!='cursor --disable-extensions' # TODO fix

## Fzf
alias f='fzf'

## Logo
alias l='source ~/.logo'

## Vim & neoVim

# alias v='vim'                # Vim
# alias v='nvim'
# alias v='nvim'
alias vl='--listen /tmp/nvim' # (neo)Vim - listening to a tmp socket for Claude
alias v='nvim'                # Original nvim
# alias vn='nvim --listen /tmp/nvim' # (neo)Vim listening on local socket - REPLACED by v() function
alias v!='nvim --noplugin --clean' # (neo)Vim clean (no plugins)
alias ov='vim'                     # Vim

alias vl='nvim -c "normal '\''0"' # Open last edited file
alias -g V='| nvim -c "setlocal buftype=nofile bufhidden=wipe" -c "nnoremap <buffer> q :q!<CR>" -'
alias vclear='rm -rf ~/.local/share/nvim/ && rm -rf ~/.local/state/nvim/ && rm -rf ~/.cache/nvim/'

# alias v!='nvim -u NONE'    # Vanilla Vim
alias ov!="vim -u NONE -N" # Pure Vim
# alias nv!='nvim -u NORC'                # Vanilla (neo)Vim

## wezterm
alias wz='wezterm'
alias wz!='wezterm start -- bash --norc'
alias wz!!='wezterm -n start -- bash --norc'

## Time
alias today=$(date '+%F_%H:%M:%S')

## Git
alias g='git'
# alias lg='lazygit'

case "$(uname -s)" in

## macOS
Darwin)

	# Bash
	alias hbash='/opt/homebrew/bin/bash'

	# Brew
	alias cask='brew cask' # Shorthand

	# Neovim
	# alias v?='vim -d'
	# alias nvim='nvim' # NeoVim

	# iCloud
	# NOTE Skip Local with iCloud > iCloud Drive > Desktop & Documents
	alias v~='cd ~'
	alias v~~='cd ~/Library/Mobile\ Documents/com~apple~CloudDocs/Documents'

	# Yabai
	alias bry='brew services restart yabai'
	alias ,ystop='yabai --stop-service'
	alias ,ystart='yabai --start-service'

	# Skhd
	alias brs='brew services restart skhd'

	## Emacs
	alias e='emacsclient --c' #Emacs

	# Game
	alias _game="brew services stop yabai && brew services stop skhd"
	alias _normal="brew services start yabai && brew services start skhd"

	# REPLs
	# alias snek='python3'
	# alias python='/usr/bin/python3'

	# GCC
	alias gcc="gcc-12"
	alias g++="g++-12"

	# Python 3
	alias py3=python3
	alias pi3=pip3

	;;

# Debian
Linux)

	# Nautilus
	alias open='nautilus .'

	# Python 3
	# alias python='/usr/bin/python3'
	# alias pip='/usr/bin/pip3'

	## Emacs
	alias e='
        export DISPLAY=:0.0
        export LIBGL_ALWAYS_INDIRECT=1
        setxkbmap -layout us
        setsid emacs
        '

	;;

CYGWIN* | MINGW32* | MSYS* | MINGW*) ;;

esac
