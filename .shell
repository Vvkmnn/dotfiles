# ┌────────────────────────────────── ~/.shell ─ Shell configuration ──────────┐
#  Vivek Menon <mail@vvkmnn.xyz>
# └────────────────────────────────────────────────────────────────────────────┘
#  Purpose: Zsh/Bash specific settings, plugins, keybindings
#  Contains: Zsh (zcomet, powerlevel10k, vi mode), Bash (prompt, history)
#  Archive: Old plugin managers (zinit, antigen, zplug) at bottom

# ┌───────────────────────────────────────────────────────────────── guard ────┐
  [ -n "$__SHELL_SOURCED" ] && return
  __SHELL_SOURCED=1
  [ -n "$AI_SANDBOX_ONLY" ] && return
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────────── bash ──┐
  if [ -n "$BASH_VERSION" ]; then
      # ─────────────────────────────────────────────────────────────── options ──
      set bell-style visible
      export COLUMNS=200
      shopt -s checkwinsize

      # ────────────────────────────────────────────────────────────── prompt ──
      om="ॐ"
      PS1="' \$(printf '%*s\r%s ' \$((\$(tput cols) - 35)) \"\
\$(date '+%-j/365 %-g/61 %a %d-%m-%y %T')\" \"\$om\")"
# └────────────────────────────────────────────────────────────────────────────┘

# ┌───────────────────────────────────────────────────────────────────── zsh ──┐
  elif [ -n "$ZSH_VERSION" ]; then
      # ──────────────────────────────────────────────────────────────── tmux ──
      # MUST be set before plugin loads AND before instant prompt
      # AUTOSTART: run tmux automatically when shell starts (if not already in tmux)
      ZSH_TMUX_AUTOSTART=true
      # AUTOCONNECT: true=attach to existing session, false=always create new session
      ZSH_TMUX_AUTOCONNECT=false
      # AUTOQUIT: true=close terminal when tmux exits/detaches, false=return to shell
      ZSH_TMUX_AUTOQUIT=true
      # DETACHED: true=adds -d flag (kicks other clients out), false=allow multiple clients
      ZSH_TMUX_DETACHED=false

      # ──────────────────────────────────────────────────────────── history ──
      HISTSIZE=50000
      SAVEHIST=50000
      HISTFILE=~/.zsh_history
      setopt EXTENDED_HISTORY          # record timestamp + duration (: ts:elapsed;cmd)
      setopt INC_APPEND_HISTORY_TIME   # write after cmd finishes (accurate duration)
      setopt HIST_IGNORE_ALL_DUPS      # remove older duplicate when new added
      setopt HIST_IGNORE_SPACE         # space-prefixed commands not recorded
      setopt HIST_REDUCE_BLANKS        # strip superfluous whitespace
      setopt HIST_VERIFY               # show expansion before executing (!! etc)
      setopt HIST_EXPIRE_DUPS_FIRST    # expire duplicates first when trimming
      setopt HIST_FIND_NO_DUPS         # skip duplicates during search
      setopt HIST_SAVE_NO_DUPS         # don't write duplicates to file

      # ────────────────────────────────────────────────────────────── zcomet ──
      if [[ ! -f ${ZDOTDIR:-${HOME}}/.zcomet/bin/zcomet.zsh ]]; then
          command git clone https://github.com/agkozak/zcomet.git ${ZDOTDIR:-${HOME}}/.zcomet/bin
      fi
      source ${ZDOTDIR:-${HOME}}/.zcomet/bin/zcomet.zsh

      # tmux plugin (must load before instant prompt - produces console output)
      zcomet load ohmyzsh plugins/tmux

      # ───────────────────────────────────────────────────────────────── fnm ──
      # deferred LTS notification (output before instant prompt = no warnings)
      [[ -f "$HOME/.cache/fnm-lts-notify" ]] && { cat "$HOME/.cache/fnm-lts-notify"; rm -f "$HOME/.cache/fnm-lts-notify"; }

      # ────────────────────────────────────────────────────────────── instant ──
      if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
          source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
      fi

      # ─────────────────────────────────────────────────────────────── theme ──
      zcomet load romkatv/powerlevel10k

      # ─────────────────────────────────────────────────────────────── plugin ──
      # directory jumping
      zcomet load agkozak/zsh-z
      # fuzzy finder with completion and key bindings (before vi-mode so widgets exist)
      zcomet load junegunn/fzf shell completion.zsh key-bindings.zsh
      # ──────────────────────────────────────────────────────── vi-mode hooks ──
      # zsh-vi-mode wipes all keybindings on init; restore them here
      function zvm_after_init() {
        # Ctrl+R: fzf fuzzy history search
        bindkey '^R' fzf-history-widget
        # Up/Down: prefix-based history search (type prefix, arrow filters)
        bindkey '^[[A' history-beginning-search-backward
        bindkey '^[OA' history-beginning-search-backward
        bindkey '^[[B' history-beginning-search-forward
        bindkey '^[OB' history-beginning-search-forward
      }
      function zvm_after_lazy_keybindings() {
        # Normal mode: k/j for prefix-based history navigation
        bindkey -M vicmd 'k' history-beginning-search-backward
        bindkey -M vicmd 'j' history-beginning-search-forward
      }
      # vi mode
      zcomet load jeffreytse/zsh-vi-mode
      # auto-switch python virtualenv
      zcomet load MichaelAquilina/zsh-autoswitch-virtualenv
      # git aliases
      zcomet load ohmyzsh plugins/gitfast
      # tmux integration (moved before instant prompt)
      # zcomet load ohmyzsh plugins/tmux
      # open git repos in browser
      zcomet load paulirish/git-open
      # auto source .env files
      zcomet load Tarrasch/zsh-autoenv
      # autosuggestions (load before syntax highlighting)
      zcomet load zsh-users/zsh-autosuggestions
      # completions
      zcomet load zsh-users/zsh-completions
      # syntax highlighting (load last)
      zcomet load zsh-users/zsh-syntax-highlighting
      # window titles
      zcomet snippet https://github.com/jreese/zsh-titles/blob/master/titles.plugin.zsh

      # ──────────────────────────────────────────────────────────────── lazy ──
      # lazy-load plugins for faster startup
      zcomet trigger zhooks agkozak/zhooks
      zcomet trigger zsh-prompt-benchmark romkatv/zsh-prompt-benchmark
      zcomet trigger --no-submodules archive unarchive lsarchive sorin-ionescu/prezto modules/archive

      # ────────────────────────────────────────────────────────────── compinit ──
      zcomet compinit
      (( ${+commands[fzf]} )) || ~[fzf]/install --bin

      # ──────────────────────────────────────────────────────────────── p10k ──
      # vi mode keybindings
      bindkey -v
      # load p10k config
      [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

      # ────────────────────────────────────────────────────────────── python ──
      export AUTOSWITCH_DEFAULT_PYTHON="/opt/homebrew/bin/python3"

      # ─────────────────────────────────────────────────────────────── ngrok ──
      command -v ngrok &>/dev/null && eval "$(ngrok completion)"

      # ──────────────────────────────────────────────────────────────── rust ──
      [ -d "$HOME/.cargo" ] && . "$HOME/.cargo/env"

      # ──────────────────────────────────────────────────────────────── node ──
      # NOTE: fnm manages Node via .node-version/.nvmrc, but brew shellenv
      # (below) prepends /opt/homebrew/bin to PATH, shadowing fnm's node
      # if Homebrew has node installed. Run `brew unlink node` to fix -
      # keeps node for brew deps (gemini-cli, ccusage-monitor) but lets
      # fnm's LTS win. Re-run after `brew upgrade` reinstalls node.
      if command -v fnm &>/dev/null; then
        eval "$(fnm env --use-on-cd --shell zsh)"
        # LTS check - only in Oct-Nov (release window), once per year
        local _fc="$HOME/.cache/fnm-lts-check" _m=$(date +%m) _y=$(date +%Y)
        [[ ($_m == 10 || $_m == 11) && "$(<"$_fc" 2>/dev/null)" != "$_y" ]] && (_fnm_lts_check &)
      fi

      # ──────────────────────────────────────────────────────────── platform ──
      case "$(uname -s)" in
      Darwin)
          # GPG: ensure GUI + VS Code shells can reach the agent and tty
          export GPG_TTY=$(tty)
          export SSH_AUTH_SOCK="$HOME/.gnupg/S.gpg-agent.ssh"
          # Homebrew
          eval "$(/opt/homebrew/bin/brew shellenv)"
          ;;
      Linux)
          # install lazygit if not present
          if ! command -v lazygit &>/dev/null; then
              LAZYGIT_VERSION=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
              curl -Lo lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz"
              tar xf lazygit.tar.gz lazygit
              [ -w /usr/local/bin ] && install lazygit /usr/local/bin || sudo install lazygit /usr/local/bin
              rm lazygit.tar.gz lazygit
          fi
          ;;
      esac
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────────── fish ──┐
  elif [ -n "$FISH_VERSION" ]; then
      echo "TODO fish"
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────────────── other ──┐
  else
      echo "TODO .shell"
  fi
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────── archive ───┐
  # Historical code preserved for reference. All replaced by zcomet (2024-06).
  # Full removed code saved in ~/.shell.bak if restoration needed.

  # ═══════════════════════════════════════════════════════════════════ summary
  # Removed 343 lines of old plugin manager configurations
  # - antigen/antidote setup (~120 lines)
  # - zinit configuration (~100 lines)
  # - zplug configuration (~40 lines)
  # - zim framework setup
  # - duplicate conda blocks
  # - UNREACHABLE bash elif (114 lines of dead code, lines 603-714)
  # - duplicate instant prompt blocks
  # - duplicate platform sections
  # - various TODOs and debugging comments

  # ═══════════════════════════════════════════════════════════════════ configs

  # scroll region (disabled - caused issues in tmux)
  # trap 'tput csr 1 $((LINES-3))' WINCH ; kill -s WINCH $$

  # nvim background server (disabled 2026-01-20 - caused job warnings on exit)
  # [[ ! -S /tmp/nvim ]] && nvim --listen /tmp/nvim --headless &>/dev/null &

  # custom p10k om prompt (saved for future reference)
  # typeset -g POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(
  #   ...
  #   om                        # custom prompt
  # )
