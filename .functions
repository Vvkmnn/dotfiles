# ┌──────────────────────────────── Time Machine ─────────────────────────────┐
#  APFS snapshots for pre-install safety. Recovery: hold power > TM restore
  quicksave() {
    local dim='\033[2m' r='\033[0m'
    case "${1:---save}" in
      -l|--list)
        echo -e "$(get_colored_face) ─── local snapshots ───"
        local snaps
        snaps=$(tmutil listlocalsnapshots / 2>/dev/null | grep -v "^Snapshots")
        [[ -z "$snaps" ]] && echo "  │ none" || echo "$snaps" | sed 's/^/  │ /'
        ;;
      -d|--delete)
        echo -e "$(get_colored_face) ─── deleting all local snapshots ───"
        tmutil listlocalsnapshots / 2>/dev/null \
          | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}' \
          | while IFS= read -r d; do
              echo "  │ $d"
              sudo tmutil deletelocalsnapshots "$d"
            done
        echo -e "  └─ ${dim}$(df -h /System/Volumes/Data | awk 'NR==2{print $3" / "$2" ("$5" full)"}')${r}"
        ;;
      -h|--help)
        echo "quicksave          create APFS snapshot (use before risky installs)"
        echo "quicksave -l       list local snapshots"
        echo "quicksave -d       delete all local snapshots (reclaim space)"
        echo "quicksave -h       this help"
        ;;
      *)
        echo -e "$(get_colored_face) ─── creating snapshot ───"
        sudo tmutil snapshot
        echo -e "  └─ ${dim}restore: Recovery Mode (hold power) > Restore from Time Machine${r}"
        ;;
    esac
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────── lf ── file manager with cd-on-quit ─────────────┐
  # lf: Go TUI file manager with vim keys. Using lf over yazi because
  # yazi has DCS escape probe issues with Ghostty+tmux.
  lfcd() {
    local tmp="$(mktemp -t "lfcd.XXXXXX")"
    lf -last-dir-path="$tmp" "$@"
    if [ -f "$tmp" ]; then
      local dir="$(cat "$tmp")"
      [ -d "$dir" ] && [ "$dir" != "$PWD" ] && builtin cd -- "$dir"
    fi
    rm -f -- "$tmp"
  }
  alias lf='lfcd'
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────── f ── find anything, cd into it ─────────────────────┐
  # No args: plain fzf (current dir). With args: searches names (fd),
  # contents (rg), Spotlight (mdfind) across ~, with file preview.
  f() {
    local query="$1" result
    # Colors inherited from FZF_DEFAULT_OPTS (Kanagawa Wave via ~/.theme/zsh/fzf.sh)
    local fzf_opts=(
      --ansi
      --layout reverse
      --highlight-line
      --border-label '  Find '
      --border-label-pos 3
      --header '  enter: cd into folder'
      --header-border bottom
      --prompt '  '
      --pointer '▶'
      --info inline-right
      --preview-window 'right:55%:wrap'
      --preview-border rounded
      --preview '
        item={}
        if [[ -d "$item" ]]; then
          eza -la --color=always --icons=auto --group-directories-first "$item" 2>/dev/null | head -40
        elif [[ -f "$item" ]]; then
          bat --color=always --style=numbers,header --line-range=:80 "$item" 2>/dev/null || head -80 "$item"
        fi
      '
    )
    if [[ -z "$query" ]]; then
      result=$(fzf "${fzf_opts[@]}") || return
    else
      # 1. mdfind (Spotlight, instant, already indexed — best for broad search)
      # 2. fd (name/path matches in project dirs, respects .gitignore)
      # awk dedupes while preserving order
      result=$(
        {
          mdfind "kMDItemFSName == '*${query}*'" 2>/dev/null
          fd -H --max-depth 5 "$query" ~/Dev ~/Projects ~/Scratch ~/Documents 2>/dev/null
        } | awk '!seen[$0]++' | fzf "${fzf_opts[@]}" --query="$query" --select-1 --exit-0
      ) || return
    fi
    if [[ -d "$result" ]]; then
      builtin cd -- "$result"
    else
      builtin cd -- "$(dirname "$result")"
    fi
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────── hex ── Preview hex color swatches ──────────┐
  hex() {
    for c in "$@"; do
      c="${c#\#}"
      printf '\e[48;2;%d;%d;%dm  #%s  \e[0m\n' "0x${c:0:2}" "0x${c:2:2}" "0x${c:4:2}" "$c"
    done
  }
# └────────────────────────────────────────────────────────────────────────────┘
