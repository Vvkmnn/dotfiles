#!/usr/bin/env bash
# Vivek Menon - vvkmnn.xyz

# ┌─────────────────────────────── ~/.functions ─ Shell functions ─────────────┐
#  Vivek Menon <mail@vvkmnn.xyz>
# └────────────────────────────────────────────────────────────────────────────┘
#  Purpose: Complex operations that need logic/loops
#  Contains: get_colored_face(), _fnm_lts_check(), _claude_config_backup(), c(), cl(), cc(), update_all(), coffee(), pokemonif_patch()
#  Archive: Disabled functions preserved at bottom

# ┌───────────────────────────────────────────────────────────────── guard ────┐
  [ -n "$__FUNCTIONS_SOURCED" ] && return
  __FUNCTIONS_SOURCED=1
  [ -n "$AI_SANDBOX_ONLY" ] && return
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── helper ──┐
  # random colored face for status output
  get_colored_face() {
    local faces=('[¬_¬]' '[^_^]' '[-_-]' '[o_o]' '[>_<]' '[T_T]' '[u_u]' '[n_n]' '[x_x]' '[~_~]' '[$_$]' '[+_+]' '[v_v]')
    local idx=$(( (RANDOM % ${#faces[@]}) + 1 ))  # zsh arrays are 1-indexed
    local face="${faces[$idx]}"
    local colors=(31 32 33 34 35 36 91 92 93 94 95 96)
    local color=${colors[$((RANDOM % ${#colors[@]} + 1))]}
    echo -e "\033[${color}m${face}\033[0m"
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────────── fnm ────┐
  # weekly background LTS check - writes notification for NEXT shell startup
  _fnm_lts_check() {
    echo "$(date +%Y)" > "$HOME/.cache/fnm-lts-check"  # mark checked this year
    local current=$(fnm current 2>/dev/null)
    local latest=$(fnm list-remote --lts 2>/dev/null | tail -1 | awk '{print $1}')
    [[ -n "$latest" && "$current" != "$latest" ]] && \
      echo -e "$(get_colored_face) [fnm] LTS $latest available → fnm install --lts" \
        > "$HOME/.cache/fnm-lts-notify"
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌───────────────────────────────────────────────────────────── claude-backup ──┐
  # weekly config backup - called silently from c/cl/cc
  _claude_config_backup() {
    local dir marker
    dir="$HOME/.claude/backups"
    marker="$dir/.last-backup"
    [[ -f "$marker" ]] && (( ($(date +%s) - $(<"$marker")) < 604800 )) && return
    mkdir -p "$dir"
    cp "$HOME/.claude/.claude.json" "$dir/.claude.json.$(date +%Y%m%d)"
    date +%s > "$marker"
    ls -t "$dir"/.claude.json.* 2>/dev/null | tail -n +4 | xargs rm -f
  } 2>/dev/null
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────────────── claude ──┐
  # crab status message: crab eyes, action, color
  __claude_msg() {
    local r='\033[0m'
    local color="$3"
    local action="${2%...}"
    echo -e "${color}(\/) ($1) (\/)${r} ${action}${color}...${r}"
  }

  # smart continue - fallback to new only if no session
  c() {
    (_claude_config_backup &)
    local gold='\033[38;5;214m'
    local terra='\033[38;5;173m'
    __claude_msg '-,,-' 'continuing...' "$gold"
    claude --continue "$@" || {
      __claude_msg '°,,°' 'creating...' "$terra"
      claude "$@"
    }
  }

  # always new session
  cl() {
    (_claude_config_backup &)
    local terra='\033[38;5;173m'
    __claude_msg '°,,°' 'creating...' "$terra"
    claude "$@"
  }

  # force continue (no fallback)
  cc() {
    (_claude_config_backup &)
    local gold='\033[38;5;214m'
    __claude_msg '-,,-' 'continuing...' "$gold"
    claude --continue "$@"
  }
# └─────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── update ──┐
  # update all: mas, brew, apt, fnm, uv, rustup, nvim
  update_all() {
    local log="/tmp/update_all.log"
    local start_time=$SECONDS warnings=0 errors=0
    local dim='\033[2m' bold='\033[1m' r='\033[0m'

    # section helper: face, title, revert_hint, command...
    __section() {
      local title="$1" revert="$2" warn="$3"; shift 3
      local sec_start=$SECONDS
      echo -e "\n$(get_colored_face) ${bold}$(date +%s)${r} ─── ${title} ───"
      if "$@" 2>&1 | sed 's/^/  │ /'; then
        local elapsed=$(( SECONDS - sec_start ))
        if [[ "$warn" == "warn" ]]; then
          echo -e "  └─ ${dim}⚠ done in ${elapsed}s (revert: ${revert})${r}"
          (( warnings++ ))
        else
          echo -e "  └─ ${dim}✓ done in ${elapsed}s (revert: ${revert})${r}"
        fi
      else
        local elapsed=$(( SECONDS - sec_start ))
        echo -e "  └─ ${dim}✗ failed in ${elapsed}s (revert: ${revert})${r}"
        (( errors++ ))
      fi
    }

    # header with randomly colored cat
    local colors=(31 32 33 34 35 36 91 92 93 94 95 96)
    local cat_color=${colors[$((RANDOM % ${#colors[@]} + 1))]}
    echo -e "╭──────────────────────────────────────────────────────────────────────────────╮"
    echo -e "│  \033[${cat_color}mᓚᘏᗢ${r}  update_all started at $(date '+%Y-%m-%d %H:%M:%S')                            │"
    echo -e "│       Log: ${log} (pipe to claude if issues)                   │"
    echo -e "╰──────────────────────────────────────────────────────────────────────────────╯"

    # Linux: prompt for sudo early
    if [[ -f /etc/debian_version ]]; then
      read -r -p "This will use sudo. Continue? [Y/n] " answer
      [[ ! "${answer:-Y}" =~ ^[Yy] ]] && echo "Aborted." && return 1
      sudo -v
    fi

    # macOS
    if [[ "$OSTYPE" == darwin* ]]; then
      __section "Mac App Store" "mas install <app-id>" "" mas upgrade
      __section "Homebrew" "brew install <pkg>@<version>" "" brew update
      __section "Homebrew packages" "brew pin <pkg>" "" brew upgrade
      __section "Homebrew casks" "brew install --cask <pkg>" "" brew upgrade --cask --greedy
      __section "Homebrew cleanup" "n/a" "" brew cleanup
    fi

    # Linux
    if [[ -f /etc/debian_version ]]; then
      __section "APT update" "n/a" "" sudo apt update
      __section "APT upgrade" "sudo apt install <pkg>=<version>" "" sudo apt upgrade -y
      __section "APT autoremove" "sudo apt install <pkg>" "" sudo apt autoremove -y
    fi

    # Cross-platform tools
    __section "fnm (Node LTS)" "fnm use <old-version>" "" fnm install --lts
    __section "uv (Python)" "uv self update --version <old>" "" uv self update
    __section "rustup (Rust)" "rustup default <old-version>" "warn" rustup update
    __section "Neovim plugins" "cd ~/.local/share/nvim/lazy/<plugin> && git checkout" "" \
      nvim --headless "+Lazy! sync" +qa

    # footer
    local total=$(( SECONDS - start_time ))
    local summary="${warnings} warning(s), ${errors} error(s)"
    echo -e "\n╭──────────────────────────────────────────────────────────────────────────────╮"
    echo -e "│  ✓ update_all completed in ${total}s (${summary})                      │"
    echo -e "│  Issues? Run: cat ${log} | claude \"analyze errors\"                 │"
    echo -e "╰──────────────────────────────────────────────────────────────────────────────╯"

    # macOS notification
    [[ "$OSTYPE" == darwin* ]] && osascript -e "display notification \"${summary}\" with title \"update_all ✓\" sound name \"Glass\"" &>/dev/null

  } 2>&1 | tee /tmp/update_all.log
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── coffee ──┐
  # prevent sleep with lid closed (Ctrl+C to restore)
  coffee() {
    [[ "$OSTYPE" != darwin* ]] && echo "macOS only" && return 1
    echo -e "$(get_colored_face) Disabling lid sleep..."
    sudo pmset -a disablesleep 1
    echo -e "$(get_colored_face) Lid sleep disabled. Ctrl+C to restore."
    trap '_coffee_restore' INT
    cat
  }
  _coffee_restore() {
    echo ""
    echo -e "$(get_colored_face) Restoring lid sleep..."
    sudo pmset -a disablesleep 0
    echo -e "$(get_colored_face) Sleep restored."
    trap - INT
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── yabai ───┐
  # toggle yabai on/off
  ,,y() {
    if pgrep -x yabai >/dev/null; then
      echo -e "$(get_colored_face) Stopping yabai..."
      yabai --stop-service
    else
      echo -e "$(get_colored_face) Starting yabai..."
      yabai --start-service
    fi
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────── games ────┐
  # patch pokemon infinite fusion: enable debug mode (F9) without Magic Boots
  # re-run after every update since INSTALL_OR_UPDATE.bat does git reset --hard
  pokemonif_patch() {
    local script="/Users/v/Documents/games/InfiniteFusion/Data/Scripts/001_Settings.rb"
    if [[ ! -f "$script" ]]; then
      echo "Not found: $script" && return 1
    fi
    if head -1 "$script" | grep -q '^\$DEBUG = true'; then
      echo -e "$(get_colored_face) Debug mode already patched"
      return 0
    fi
    sed -i '' '1i\
$DEBUG = true  # enable debug mode (F9) without Magic Boots
' "$script"
    echo -e "$(get_colored_face) Debug mode patched → F9 works without Magic Boots"
  }
# └────────────────────────────────────────────────────────────────────────────┘

