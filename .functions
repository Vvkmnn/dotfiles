#!/usr/bin/env bash
# Vivek Menon - vvkmnn.xyz

# ┌─────────────────────────────── ~/.functions ─ Shell functions ─────────────┐
#  Vivek Menon <mail@vvkmnn.xyz>
# └────────────────────────────────────────────────────────────────────────────┘
#  Purpose: Complex operations that need logic/loops
#  Contains: get_colored_face(), _recover_cwd(), _fnm_lts_check(), _claude_config_backup(), c(), cl(), cc(), ct(), clh(), update_all(), coffee(), pif(), quicksave()
#  Archive: Disabled functions preserved at bottom

# ┌───────────────────────────────────────────────────────────────── guard ────┐
  [ -n "$__FUNCTIONS_SOURCED" ] && return
  __FUNCTIONS_SOURCED=1
  [ -n "$AI_SANDBOX_ONLY" ] && return
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── helper ──┐
  # random colored face for status output
  get_colored_face() {
    local faces=('[¬_¬]' '[^_^]' '[-_-]' '[o_o]' '[>_<]' '[T_T]' '[u_u]' '[n_n]' '[x_x]' '[~_~]' '[$_$]' '[+_+]' '[v_v]')
    local idx=$(( (RANDOM % ${#faces[@]}) + 1 ))  # zsh arrays are 1-indexed
    local face="${faces[$idx]}"
    local colors=(31 32 33 34 35 36 91 92 93 94 95 96)
    local color=${colors[$((RANDOM % ${#colors[@]} + 1))]}
    echo -e "\033[${color}m${face}\033[0m"
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────── cwd recovery ──┐
  # recover stale CWD after volume unmount/remount (e.g., SSD disconnect)
  # remembers original path so it can auto-return when volume comes back
  _recover_cwd() {
    if [[ -n "$_cwd_lost" ]] && [[ -d "$_cwd_lost" ]]; then
      builtin cd -q "$_cwd_lost" && unset _cwd_lost && return
    fi
    if ! [[ -d . ]]; then
      _cwd_lost="$PWD"
      builtin cd -q "$PWD" 2>/dev/null || builtin cd -q ~
    fi
  }
  [[ -n "$ZSH_VERSION" ]] && precmd_functions+=(_recover_cwd)
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────── leaked mouse ──┐
  # tmux copy-on-highlight silently no-ops when a TUI (Claude Code, nvim, fzf…)
  # exits without resetting mouse reporting: mouse_any_flag stays 1 on a bare
  # shell, so tmux forwards the drag to the app instead of entering copy-mode
  # and copy-selection never fires. Clear the mouse-tracking DECRST modes at
  # every prompt (1004 focus-events left alone — tmux relies on it) so a leaked
  # TUI can never persist past the command that spawned it. Check: a `zsh` pane
  # with `tmux display -p '#{mouse_any_flag}'` == 1 is stuck.
  # /dev/tty, not stdout: the first precmd runs inside p10k's instant-prompt fd1/2
  # capture, and any bytes there trip its "console output during init" warning.
  _reset_mouse() { printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1015l' > /dev/tty }
  [[ -n "$ZSH_VERSION" ]] && precmd_functions+=(_reset_mouse)
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────────── fnm ────┐
  # weekly background LTS check - writes notification for NEXT shell startup
  _fnm_lts_check() {
    echo "$(date +%Y)" > "$HOME/.cache/fnm-lts-check"  # mark checked this year
    local current=$(fnm current 2>/dev/null)
    local latest=$(fnm list-remote --lts 2>/dev/null | tail -1 | awk '{print $1}')
    [[ -n "$latest" && "$current" != "$latest" ]] && \
      echo -e "$(get_colored_face) [fnm] LTS $latest available → fnm install --lts" \
        > "$HOME/.cache/fnm-lts-notify"
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌───────────────────────────────────────────────────────────── claude-backup ──┐
  # weekly config backup - called silently from c/cl/cc
  _claude_config_backup() {
    local dir marker
    dir="$HOME/.claude/backups"
    marker="$dir/.last-backup"
    [[ -f "$marker" ]] && (( ($(date +%s) - $(<"$marker")) < 604800 )) && return
    mkdir -p "$dir"
    cp "$HOME/.claude/.claude.json" "$dir/.claude.json.$(date +%Y%m%d)"
    date +%s > "$marker"
    ls -t "$dir"/.claude.json.* 2>/dev/null | tail -n +4 | xargs rm -f
  } 2>/dev/null
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────────────── claude ──┐
  # crab status message: crab eyes, action, color
  __claude_msg() {
    local r='\033[0m'
    local color="$3"
    local action="${2%...}"
    echo -e "${color}(\/) ($1) (\/)${r} ${action}${color}...${r}"
  }

  # true if cwd has at least one Claude session jsonl
  # (~/.claude/projects/<encoded-cwd>/*.jsonl, where / and . both encode to -)
  __claude_has_session() {
    local enc="${PWD//\//-}"
    enc="${enc//./-}"
    local dir="$HOME/.claude/projects/$enc"
    # (N) = nullglob qualifier: empty array if no matches or dir missing.
    # Avoids `compgen` (a bash builtin absent in zsh unless bashcompinit is loaded).
    local sessions=("$dir"/*.jsonl(N))
    (( ${#sessions} ))
  }

  # internal wrapper: runs claude with idle detection + restart-on-idle loop
  # __claude_run MODE [ARGS...]  where MODE = continue | new | force
  __claude_run() {
    # Suppress [N] PID and [N]+ Done messages from background checker
    setopt LOCAL_OPTIONS NO_MONITOR NO_NOTIFY 2>/dev/null
    local mode="$1"; shift
    local gold='\033[38;5;214m' terra='\033[38;5;173m'
    local dim='\033[38;5;240m' r='\033[0m'

    # Capture tmux context once (pane doesn't change across restarts)
    local tmux_session="" tmux_window=""
    if [[ -n "$TMUX" ]]; then
      tmux_session=$(/opt/homebrew/bin/tmux display-message -p '#{session_name}' 2>/dev/null)
      tmux_window=$(/opt/homebrew/bin/tmux display-message -p '#{window_index}' 2>/dev/null)
    fi
    local checker="$HOME/.config/tmux/claude-idle-checker.sh"
    local _rapid=0   # consecutive sub-2s exits → crash-loop guard

    while true; do
      case "$mode" in
        continue) __claude_msg '-,,-' 'continuing...' "$gold" ;;
        new)      __claude_msg '°,,°' 'creating...' "$terra" ;;
        force)    __claude_msg '-,,-' 'continuing...' "$gold" ;;
      esac

      # Start idle checker in background (finds Claude via pgrep -P $$)
      local _checker_pid=""
      if [[ -x "$checker" ]]; then
        "$checker" $$ "$tmux_session" "$tmux_window" "$PWD" "${CLAUDE_IDLE_THRESHOLD:-1800}" &
        _checker_pid=$!
      fi

      # Run Claude in foreground (TUI requires it). Capture exit for ALL modes so
      # new/force get the same resume prompt as continue — previously only `continue`
      # captured $?, so cl/cc silently fell through to the shell on any crash.
      local _claude_exit=0 _start=$SECONDS
      case "$mode" in
        continue)
          claude --continue "$@"
          _claude_exit=$?
          ;;
        new)
          claude "$@"
          _claude_exit=$?
          ;;
        force)
          claude --continue "$@"
          _claude_exit=$?
          ;;
      esac

      # Clean up checker
      local _checker_exit=0
      if [[ -n "$_checker_pid" ]]; then
        kill "$_checker_pid" 2>/dev/null
        wait "$_checker_pid" 2>/dev/null
        _checker_exit=$?
      fi

      # Non-zero exit → offer resume. This block is the crab fix. Three guards, in order:
      #   1. [[ -t 0 && -t 1 ]] — only prompt when interactive; piped/non-tty → bail, never loop.
      #   2. crash-loop floor — if claude keeps dying in <2s, drop to shell after 3 tries so an
      #      unattended crash can't spin.
      #   3. drain queued input, then read the keypress from /dev/tty (NOT inherited stdin).
      #      The runaway spam was `read -r` consuming buffered terminal keystrokes one-per-loop;
      #      draining first + reading the real tty makes it block on an actual human keypress.
      if (( _claude_exit != 0 )); then
        [[ -t 0 && -t 1 ]] || break
        if (( SECONDS - _start < 2 )); then
          if (( ++_rapid >= 3 )); then
            echo -e "\n${dim}(\/) (x_x) (\/)${r} claude keeps exiting immediately ${dim}— dropping to shell${r}"
            break
          fi
        else
          _rapid=0
        fi
        echo -e "\n${dim}(\/) (~_~) (\/)${r} session ended ${dim}— press Enter to resume, Ctrl+C for shell${r}"
        local _drain=0
        while (( _drain++ < 4096 )) && read -t 0 -k 1 -u 0 2>/dev/null; do :; done
        read -r _ </dev/tty || break
        continue
      fi

      # Normal exit (0) → return to shell
      break
    done
  }

  # smart continue - fallback to new only if no session
  c() {
    (_claude_config_backup &)
    if __claude_has_session; then
      __claude_run continue "$@"
    else
      __claude_run new "$@"
    fi
  }

  # always new session
  cl() {
    (_claude_config_backup &)
    __claude_run new "$@"
  }

  # force continue (no fallback)
  cc() {
    (_claude_config_backup &)
    __claude_run force "$@"
  }

  # agent teams - always new session (teams can't resume/continue)
  ct() {
    (_claude_config_backup &)
    local peach='\033[38;5;209m'
    __claude_msg '^,,^' 'assembling...' "$peach"
    CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 claude "$@"
  }

  # fzf session history picker — search, preview, resume/jump
  clh() {
    local amber='\033[38;5;208m'
    __claude_msg 'o,,o' 'searching...' "$amber"
    ~/.config/fzf/clh.sh "$@"
  }
# └─────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────────── fleet ──┐
  # Reach any fleet Mac by its real device name (resolved via Tailscale MagicDNS,
  # so it works on the LAN or any network). Two v-verbs + two extras; no host map —
  # the name is passed straight to mosh/ssh/open, MagicDNS resolves it.
  #
  #   vssh vminim4        v[jump]: mosh into the mini's tmux in a fresh Ghostty window (terminal)
  #   vwatch                v[wake]: keep THIS machine awake so its agents run while you travel
  #   vremote vminim4        screen-share the mini (first-party Screen Sharing, full GUI)
  # Two ways in: vssh = terminal · vremote = screen.

  # ── transport rationale: why MOSH, not ssh or et (decided — don't re-litigate) ───────────────
  #  Three ways to hold a remote shell; they are NOT interchangeable:
  #
  #    ssh  — TCP, ephemeral. A dropped link sends SIGHUP → the remote shell AND its children
  #           (nvim, claude, builds) DIE. Right for scripts / git / `ssh -L` tunnels / one-shot
  #           commands; wrong for a live session meant to survive a flaky link. ssh is still the
  #           BOOTSTRAP under mosh (`mosh --ssh=…`) and how the 1Password key reaches a remote.
  #    mosh — UDP, roaming. Survives IP changes (wifi↔cellular), sleep, and travel; the remote
  #           mosh-server keeps your tmux alive and mosh silently resumes on wake. On a drop it
  #           shows a dimmed "Last contact: N s ago" overlay — the ONE built-in visual cue that
  #           you're disconnected. Predictive local echo hides lag. THIS IS THE DEFAULT.
  #    et   — TCP byte-stream (Eternal Terminal). Reconnects too, but SILENTLY: on a drop the
  #           screen just freezes with no indication (can't tell frozen from slow). Its one real
  #           edge over mosh is native client scrollback — which tmux gives us anyway, so it buys
  #           nothing here. Evaluated and dropped: silent-freeze is worse UX for us, and it costs
  #           an etserver:2022 daemon + a fussier 1Password-agent handshake. Not used.
  #
  #  Disconnect freeze is FUNDAMENTAL to both mosh and et: both are raw-mode state-sync clients
  #  with no local scrollback during a drop — the scrollback buffer lives in the remote tmux, on
  #  the far side of the dead link, so nothing repaints until the link is back. Content is safe
  #  on the remote and returns intact on reconnect; you just can't scroll while frozen. A live
  #  disconnect indicator can only live OUTSIDE the terminal (a local menu-bar cue) — mosh's
  #  overlay is the closest built-in, which is why mosh wins until such a widget exists.
  #
  #  tmux: not launched by us. The remote login shell autostarts a FRESH session itself
  #  (ZSH_TMUX_AUTOSTART=true, AUTOCONNECT=false, AUTOQUIT=true in ~/.shell), so `vj` passes NO
  #  command — avoiding a "tmux new-session" echo into the interactive shell. The remote `tmux`
  #  is an oh-my-zsh alias (_zsh_tmux_plugin_run), so `exec tmux` / `et -c 'tmux …'` misfire.
  #
  #  Auth: the 1Password SSH agent (SSH_AUTH_SOCK, set in ~/.minimal/.zshenv) gives Touch-ID and
  #  no password — but ONLY while the 1Password DESKTOP APP is running (menu-bar on). If it's
  #  quit, the socket file lingers, the agent is dead, and every ssh/mosh falls back to a
  #  password. See the SSH_AUTH_SOCK gotcha in ~/.minimal.
  # ─────────────────────────────────────────────────────────────────────────────────────────────

  # _fleet_host <name> — resolve to a reachable form: prefer the bare name (Tailscale
  # MagicDNS, works on any network), fall back to <name>.local (Bonjour, LAN). Lets you
  # type `j vminim4` and have it work on the LAN today and over Tailscale later — no suffix.
  # _fleet_host → _fleet_map/_fleet_reach in ~/.fleet. deprecated, parked below.
  # _fleet_host() {
    # local h="$1"
    # case "$h" in mini|m4) h=vminim4;; air|m3) h=vbookairm3;; neo|a18) h=vbookneoa18;; esac  # friendly → true hostname
    # if ping -c1 -t1 "$h" >/dev/null 2>&1; then print -- "$h"; return 0
    # elif ping -c1 -t1 "$h.local" >/dev/null 2>&1; then print -- "$h.local"; return 0
    # else print -- "$h"; return 1; fi   # unreachable: still print the name, signal via exit code
  # }

  # vssh <host> — v[jump]: open a FRESH Ghostty window that's a DIRECT client to THAT machine's
  # tmux server, over mosh (auto-reconnects across sleep / wifi↔cellular / travel). No local
  # tmux wraps it (`open -e` skips the autostart) → C-a / C-hjkl / prefix / finder all drive the
  # remote, navigate all its windows+panes like you're sitting there. mosh (not ssh): tmux persists
  # server-side and mosh silently resumes the link, so closing the lid mid-session just picks back
  # up. `env -u TMUX` strips leaked tmux vars (no nesting). PRE-FLIGHT reachability runs in THIS
  # shell BEFORE opening a window, so an asleep/offline machine never spawns a dead hanging window.
  # Each vssh = a FRESH, auto-numbered session on the target (`tmux new-session` → 0,1,2… like
  # opening a new local tmux window), independent, never mirroring a previous one. mosh's ssh gets
  # ConnectTimeout so it fails fast; if the link drops mid-session, mosh resumes THAT window on wake.
  # vssh → vj  (now in ~/.fleet). deprecated 2026-07-13, parked below.
  # vssh() {
    # local name="${1:?usage: vssh <host>   (e.g. vssh vminim4 | vssh vbookneoa18)}"
    # local G=$'\e[38;5;114m' Y=$'\e[38;5;179m' D=$'\e[2m' R=$'\e[0m'
    # printf "  ${D}reaching %s…${R}" "$name"
    # local host
    # if host=$(_fleet_host "$name"); then
      # printf "\r  ${G}●${R} %s ${D}up — connecting${R}              \n" "$name"
    # else
      # printf "\r  ${Y}○${R} %s ${D}offline — asleep or off (run \`vwatch\` on it, or wake it)${R}\n" "$name"
      # return 1
    # fi
    # open -na /Applications/Ghostty.app --args -e /bin/zsh -c \
      # "env -u TMUX -u TMUX_PANE mosh --ssh='ssh -o ConnectTimeout=4' --family=inet ${(q)host} -- tmux new-session"
  # }

  # ┌──────────────────────────────────────────────────────── fleet (vj·vr·vw) ──┐
  #  Shared helpers for the 3 fleet verbs. `_fleet_map` is pure (no I/O) so the
  #  spinner stays smooth; the spinner + Kanagawa palette are common so vj/vr/vw
  #  all look and feel identical.

  # _fleet_map <name> — chip/friendly alias → true hostname (map only, no ping).
  _fleet_map() {
    case "${1:l}" in
      mini|m4)  print -r -- vminim4 ;;
      air|m3)   print -r -- vbookairm3 ;;
      neo|a18)  print -r -- vbookneoa18 ;;
      *)        print -r -- "$1" ;;   # already a hostname / unknown — pass through
    esac
  }

  # _fleet_chip <hostname> — human chip label for the reveal ("Apple M4").
  _fleet_chip() {
    case "${1:l}" in
      *m4)  print -r -- "Apple M4" ;;
      *m3)  print -r -- "Apple M3" ;;
      *a18) print -r -- "Apple A18" ;;
      *)    print -r -- "" ;;
    esac
  }

  # _fleet_spin <pid> <label> — braille throbber over a background probe; spins ONLY while the
  # probe is actually running (zero added latency — a direct `tailscale ping` returns in ~5ms and
  # this just exits), so it never delays the real path. The guaranteed eye-candy is the post-open
  # settle in `vj` (decoupled: window opens first, animation is a pure nice-to-have after).
  _fleet_spin() {
    local f=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) i=0
    local aqua=$'\e[38;2;122;168;159m' dim=$'\e[38;2;114;116;124m' R=$'\e[0m'
    tput civis 2>/dev/null
    while kill -0 "$1" 2>/dev/null; do
      printf "\r  ${aqua}%s${R}  ${dim}%s${R}" "${f[i++%10+1]}" "$2"; sleep 0.06
    done
    tput cnorm 2>/dev/null; printf "\r\e[K"
  }

  # _fleet_poll — one concurrent sweep of the WHOLE fleet, feeding both vj's picker and vw's tree.
  # Emits a flat, |-delimited record stream that both consumers parse:
  #   HOST|<friendly>|<hostname>                              one per machine, in display order
  #   PWR|<ac|batt>|<pct>|<cool|hot>|<load>                  vitals (pct=? on a desktop, no battery)
  #   WIN|<session:index>|<name>|<cmd>|<agent_status>        one per tmux window
  #   ASLEEP                                                  replaces PWR/WIN when a peer times out
  # This box is probed locally; peers over ssh with a short ConnectTimeout that IS the reachability
  # test (one round-trip, no separate ping). Peers run concurrently → a temp dir, read back in order,
  # dir wiped on any exit. The probe is pure reads (pmset/sysctl/tmux) so it's cheap to repeat in the
  # vw refresh loop. Agent windows are classified downstream by name/cmd (@agent_status is optional).
  _fleet_poll() {
    local -a order=(mini air neo)
    local -A host=( mini vminim4 air vbookairm3 neo vbookneoa18 )
    local self=${${HOST%%.*}:l}
    # ONE probe string, run by whichever shell finally evaluates it (local sh, or the peer's shell
    # over ssh). Single-quoted so nothing expands here; the inner $(...) reach the far side intact.
    local probe='
      batt=$(pmset -g batt 2>/dev/null)
      pct=$(printf "%s" "$batt" | grep -oE "[0-9]+%" | head -1 | tr -d "%")
      ac=batt; printf "%s" "$batt" | grep -q "AC Power" && ac=ac
      lim=$(pmset -g therm 2>/dev/null | grep -oE "CPU_Speed_Limit *= *[0-9]+" | grep -oE "[0-9]+$")
      therm=cool; [ -n "$lim" ] && [ "$lim" != 100 ] && therm=hot
      set -- $(sysctl -n vm.loadavg 2>/dev/null | tr -d "{}"); load=$1
      printf "PWR|%s|%s|%s|%s\n" "$ac" "${pct:-?}" "$therm" "${load:-?}"
      tmux list-windows -a -F "WIN|#{session_name}:#{window_index}|#{window_name}|#{pane_current_command}|#{@agent_status}" 2>/dev/null
    '
    local dir; dir=$(mktemp -d) || return 1
    {
      local f
      for f in $order; do
        if [[ ${host[$f]:l} == $self ]]; then
          ( sh -c "$probe" >"$dir/$f" 2>/dev/null ) &
        else
          ( ssh -o ConnectTimeout=3 -o BatchMode=yes "${host[$f]}" "$probe" >"$dir/$f" 2>/dev/null ) &
        fi
      done
      wait
      for f in $order; do
        print -r -- "HOST|$f|${host[$f]}"
        if [[ -s "$dir/$f" ]]; then cat -- "$dir/$f"; else print -r -- "ASLEEP"; fi
      done
    } always { rm -rf -- "$dir" }
  }
  # └────────────────────────────────────────────────────────────────────────────┘

  # vj <host> — v[jump]: one smart, beautiful jump. A braille throbber spins while
  # Tailscale races the paths (`tailscale ping`; plain `ping` when off-tailnet), then it
  # settles into a face · host · chip · transport · quality. Transport is MOSH (∿, UDP) — the
  # sole transport by choice: it roams across wifi↔cellular / sleep / IP changes and shows a
  # dimmed "Last contact" overlay on a drop, the ONE built-in disconnect cue. et was evaluated
  # and dropped (reconnects silently → no cue; its only edge, native scrollback, is nullified
  # by tmux; see the "transport rationale" block at the top of this fleet section for the full
  # ssh/mosh/et reasoning).
  # Fresh session each jump via the remote's own tmux autostart. 1Password SSH agent
  # (SSH_AUTH_SOCK from .zshenv) → Touch ID, no password, when the 1Password desktop app runs.
  vj() {
    local name="${1:?usage: vj <host>   (e.g. vj m4 | vj mini)}"
    local host; host=$(_fleet_map "$name")
    local blu=$'\e[38;2;126;156;216m'
    local dim=$'\e[38;2;114;116;124m' bold=$'\e[1m' R=$'\e[0m'

    # ── probe path quality under the spinner (Tailscale first, LAN fallback) ──
    # no_monitor/no_notify: silence the interactive `[2] 12345` / `[2] + done` job-control
    # chatter from the backgrounded probe so it never corrupts the spinner line.
    setopt local_options no_monitor no_notify
    local tmp; tmp=$(mktemp)
    ( tailscale ping -c 3 "$host" >"$tmp" 2>/dev/null ) &
    local pid=$!
    trap 'kill $pid 2>/dev/null; tput cnorm 2>/dev/null; rm -f "$tmp"' INT TERM
    _fleet_spin "$pid" "reaching ${name}…"
    wait $pid 2>/dev/null; trap - INT TERM
    local out; out=$(<"$tmp"); rm -f "$tmp"

    local last rtt reach=0 direct=0
    last=$(print -r -- "$out" | grep -iE 'pong|via' | tail -1)
    if [[ -n "$last" ]]; then
      reach=1
      rtt=$(print -r -- "$last" | grep -oE '[0-9]+ms' | head -1 | grep -oE '[0-9]+')
      [[ "$last" == *"via "* && "$last" != *DERP* && "$last" != *relay* ]] && direct=1
    else
      # off-tailnet / LAN: plain ping (bare then .local); a live LAN counts as a clean pipe
      local rt
      if rt=$(ping -c1 -t1 "$host" 2>/dev/null | grep -oE 'time=[0-9.]+' | head -1); then
        reach=1; direct=1; rtt=${${rt#time=}%%.*}
      elif rt=$(ping -c1 -t1 "$host.local" 2>/dev/null | grep -oE 'time=[0-9.]+' | head -1); then
        reach=1; direct=1; rtt=${${rt#time=}%%.*}; host="$host.local"
      fi
    fi

    local chip; chip=$(_fleet_chip "$host")

    if (( ! reach )); then
      printf "  %s  ${bold}%s${R} ${dim}· asleep or off — \`vw %s\` to wake${R}\n" \
        "$(get_colored_face)" "$host" "$name"
      return 1
    fi

    local pathw
    (( direct )) && pathw=direct || pathw=relay
    local badge="${blu}∿ mosh${R}"

    # ── REAL WORK: open the mosh window NOW, before any animation (decoupled → 0 cost to the jump). ──
    # mosh (UDP) is the sole transport: it roams across wifi↔cellular / sleep / IP changes, and a drop
    # shows a dimmed "Last contact" overlay — the ONE built-in disconnect cue. et was dropped because it
    # reconnects SILENTLY (no cue → you can't tell you're frozen) and its only real edge, native
    # scrollback, is nullified by tmux. NO command passed — the remote login shell autostarts a FRESH
    # tmux itself (ZSH_TMUX_AUTOSTART in .shell), landing exactly as if sitting at the machine.
    # SSH_AUTH_SOCK → 1Password (from .zshenv/.minimal, sourced by this `zsh -c`) → Touch ID, no password.
    open -na /Applications/Ghostty.app --args -e /bin/zsh -c \
      "env -u TMUX -u TMUX_PANE mosh --ssh='ssh -o ConnectTimeout=4' --family=inet ${(q)host}"

    # ── COSMETIC settle: a brief braille flourish → the reveal. Pure nice-to-have — the window is
    #    already opening, so this only delays the origin prompt's return, never the real jump. ──
    local aqua=$'\e[38;2;122;168;159m' fr=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
    tput civis 2>/dev/null
    for i in {1..12}; do
      printf "\r  ${aqua}%s${R}  ${dim}reaching %s…${R}" "${fr[i%10+1]}" "$name"; sleep 0.04
    done
    tput cnorm 2>/dev/null
    printf "\r\e[K  %s  ${bold}%s${R} ${dim}%s${R}   %s   ${dim}%s %sms${R}\n" \
      "$(get_colored_face)" "$host" "$chip" "$badge" "$pathw" "${rtt:-?}"
  }

  # _vwatch_bar <pct> — 10-cell ASCII charge bar, e.g. [#######---].
  _vwatch_bar() {
    local p=${1:-0} n i out=""
    (( n = p / 10 )); (( n > 10 )) && n=10
    for (( i = 0; i < 10; i++ )); do (( i < n )) && out+="#" || out+="-"; done
    print -r -- "$out"
  }

  # _vwatch_render <caffeinate-pid> — one ASCII frame of the vwatch dashboard (no sudo; pmset/tmux only).
  _vwatch_render() {
    local caff=$1 host=${HOST%%.*} batt=$(pmset -g batt)
    local pct=$(print -r -- "$batt" | grep -oE '[0-9]+%' | head -1 | tr -d '%')
    local ac=0; print -r -- "$batt" | grep -q 'AC Power' && ac=1
    local lim=$(pmset -g therm 2>/dev/null | grep -oE 'CPU_Speed_Limit *= *[0-9]+' | grep -oE '[0-9]+$')
    local hot=0; [[ -n "$lim" && "$lim" != 100 ]] && hot=1
    local load=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')
    local up=$(uptime | sed -E 's/.*up +//; s/, *[0-9]+ users?.*//')
    local ns=$(tmux list-sessions 2>/dev/null | grep -c .) nw=$(tmux list-windows -a 2>/dev/null | grep -c .)
    local rule="  $(printf -- '-%.0s' {1..54})"
    local pstate; (( ac )) && pstate="AC     " || pstate="battery"
    local temp; (( hot )) && temp="%F{red}THROTTLING ${lim}%%%f" || temp="%F{green}ok%f"
    print -n $'\e[H\e[2J'
    print -P "  %B${host}%b · up ${up} · $(date +%H:%M)"
    print -P "$rule"
    print -P "  power   ${pstate} ${pct:-?}%% [$(_vwatch_bar ${pct:-0})]   temp ${temp}   load ${load:-?}"
    if (( hot )); then
      print -P "  wake    %F{red}HOT%f — throttling; open the lid or cut load (still holding awake)"
    elif (( ac )); then
      print -P "  wake    %F{green}AVAILABLE%f — held awake on AC (no battery cost)"
    else
      print -P "  wake    %F{yellow}AVAILABLE%f — held awake on battery (${pct:-?}%%, draining) — plug in to spare it"
    fi
    print -P "$rule"
    print -P "  agents"
    local agents=$(tmux list-windows -a -F '#{session_name}:#{window_index}|#{window_name}|#{pane_current_command}|#{@agent_status}' 2>/dev/null | grep -iE '\|[^|]*(claude|codex)')
    if [[ -n "$agents" ]]; then
      print -r -- "$agents" | while IFS='|' read -r loc name cmd st; do
        local g
        case "$st" in
          busy)    g="%F{red}*%f";;
          waiting) g="%F{yellow}?%f";;
          done)    g="%F{green}=%f";;
          *)       g="%F{8}.%f"; st="idle";;
        esac
        print -P "    ${g} ${(r:11:)name}%F{8}${loc}%f ${st}"
      done
    else
      print -P "    %F{8}(no agents running)%f"
    fi
    print -P "$rule"
    print -P "  tmux    ${ns} sessions · ${nw} windows          %F{8}^C to release%f"
  }

  # vwatch — v[wake]: keep THIS machine available for agentic work by any means, wasting the least
  # energy possible. `caffeinate -im` holds the SYSTEM awake on AC *and* battery (lid open), but
  # lets the display sleep (no -d = no wasted backlight). On battery it stays up and shows the
  # drain honestly, so you decide when to plug in. Thermal-aware: warns if the fanless chassis
  # throttles. SINGLE-INSTANCE: if a vwatch already holds this machine awake, it reports WHERE and
  # exits — never competes. Live ASCII dashboard: power, thermal, agents, tmux. `disown`ed +
  # EXIT-trap cleanup: never a stray "running job"; ^C/close -> caffeinate dies, no disk artifact.
  # vwatch → vw  (now in ~/.fleet). deprecated 2026-07-13, parked below.
