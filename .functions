# ┌────────────────────────────────────────────────────────────────── update ──┐
  # update all: mas, brew, apt, fnm, uv, rustup, nvim
  update_all() {
    local log="/tmp/update_all.log"
    local start_time=$SECONDS warnings=0 errors=0
    local dim='\033[2m' bold='\033[1m' r='\033[0m'

    # section helper: face, title, revert_hint, command...
    __section() {
      local title="$1" revert="$2" warn="$3"; shift 3
      local sec_start=$SECONDS
      echo -e "\n$(get_colored_face) ${bold}$(date +%s)${r} ─── ${title} ───"
      if "$@" 2>&1 | sed 's/^/  │ /'; then
        local elapsed=$(( SECONDS - sec_start ))
        if [[ "$warn" == "warn" ]]; then
          echo -e "  └─ ${dim}⚠ done in ${elapsed}s (revert: ${revert})${r}"
          (( warnings++ ))
        else
          echo -e "  └─ ${dim}✓ done in ${elapsed}s (revert: ${revert})${r}"
        fi
      else
        local elapsed=$(( SECONDS - sec_start ))
        echo -e "  └─ ${dim}✗ failed in ${elapsed}s (revert: ${revert})${r}"
        (( errors++ ))
      fi
    }

    # header with randomly colored cat
    local colors=(31 32 33 34 35 36 91 92 93 94 95 96)
    local cat_color=${colors[$((RANDOM % ${#colors[@]} + 1))]}
    echo -e "╭──────────────────────────────────────────────────────────────────────────────╮"
    echo -e "│  \033[${cat_color}mᓚᘏᗢ${r}  update_all started at $(date '+%Y-%m-%d %H:%M:%S')                            │"
    echo -e "│       Log: ${log} (pipe to claude if issues)                   │"
    echo -e "╰──────────────────────────────────────────────────────────────────────────────╯"

    # Linux: prompt for sudo early
    if [[ -f /etc/debian_version ]]; then
      read -r -p "This will use sudo. Continue? [Y/n] " answer
      [[ ! "${answer:-Y}" =~ ^[Yy] ]] && echo "Aborted." && return 1
      sudo -v
    fi

    # macOS
    if [[ "$OSTYPE" == darwin* ]]; then
      __section "Mac App Store" "mas install <app-id>" "" mas upgrade
      __section "Homebrew" "brew install <pkg>@<version>" "" brew update
      __section "Homebrew packages" "brew pin <pkg>" "" brew upgrade
      __section "Homebrew casks" "brew install --cask <pkg>" "" brew upgrade --cask --greedy
      __section "Homebrew cleanup" "n/a" "" brew cleanup
    fi

    # Linux
    if [[ -f /etc/debian_version ]]; then
      __section "APT update" "n/a" "" sudo apt update
      __section "APT upgrade" "sudo apt install <pkg>=<version>" "" sudo apt upgrade -y
      __section "APT autoremove" "sudo apt install <pkg>" "" sudo apt autoremove -y
    fi

    # Cross-platform tools
    __section "mise (tool versions)" "mise use <tool>@<old-version>" "" mise upgrade
    __section "uv (Python)" "uv self update --version <old>" "" uv self update
    __section "rustup (Rust)" "rustup default <old-version>" "warn" rustup update
    __section "Neovim plugins" "cd ~/.local/share/nvim/lazy/<plugin> && git checkout" "" \
      nvim --headless "+Lazy! sync" +qa

    # footer
    local total=$(( SECONDS - start_time ))
    local summary="${warnings} warning(s), ${errors} error(s)"
    echo -e "\n╭──────────────────────────────────────────────────────────────────────────────╮"
    echo -e "│  ✓ update_all completed in ${total}s (${summary})                      │"
    echo -e "│  Issues? Run: cat ${log} | claude \"analyze errors\"                 │"
    echo -e "╰──────────────────────────────────────────────────────────────────────────────╯"

    # macOS notification
    [[ "$OSTYPE" == darwin* ]] && osascript -e "display notification \"${summary}\" with title \"update_all ✓\" sound name \"Glass\"" &>/dev/null

  } 2>&1 | tee /tmp/update_all.log
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── coffee ──┐
