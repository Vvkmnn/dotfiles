#!/usr/bin/env bash

#
#
# {{{

debugger_chrome() {
	# macOS
	open -n -a "Google Chrome" --args --remote-debugging-port=9222 --user-data-dir=/tmp/chrome-debug-profile

	# Windows
	# "C:\Program Files\Google\Chrome\Application\chrome.exe" --remote-debugging-port=9222 --user-data-dir=%TEMP%\chrome-debug-profile

	# Linux
	# google-chrome --remote-debugging-port=9222 --user-data-dir=/tmp/chrome-debug-profile
}

# VS Code launcher — minimal wrapper to include the project folder up front.
vc() {
	local code_bin
	code_bin=$(command -v code || command -v code-insiders)
	if [ -z "$code_bin" ]; then
		printf 'v: VS Code CLI (code) not found\n' >&2
		return 127
	fi

	if [ $# -eq 0 ]; then
		"$code_bin"
		return
	fi

	local -a args=("$@")
	local -a pass_args=()
	local target=""
	local awaiting=0
	local seen_double_dash=0
	local force_same=0

	for arg in "${args[@]}"; do
		if [ $awaiting -eq 1 ]; then
			pass_args+=("$arg")
			awaiting=0
			if [ -z "$target" ]; then
				target="$arg"
			fi
			continue
		fi
		if [ "$arg" = "--" ]; then
			seen_double_dash=1
			pass_args+=("$arg")
			continue
		fi
		if [ $seen_double_dash -eq 0 ]; then
			case "$arg" in
			-s | --same)
				force_same=1
				continue
				;;
			--*=*)
				pass_args+=("$arg")
				continue
				;;
			--user-data-dir | --extensions-dir | --locale | --profile | --log | --category | --command | \
				--file-write | --file-chmod | --folder-uri | --file-uri | --proxy-server | --proxy-bypass-list | \
				--install-extension | --uninstall-extension | --app-port | --enable-proposed-api | -g)
				pass_args+=("$arg")
				awaiting=1
				continue
				;;
			-*)
				pass_args+=("$arg")
				continue
				;;
			esac
		fi
		pass_args+=("$arg")
		if [ -z "$target" ]; then
			target="$arg"
		fi
	done

	if [ -z "$target" ]; then
		"$code_bin" "$@"
		return
	fi

	local path_hint="$target"
	if [ ! -e "$path_hint" ]; then
		local trimmed=${target%%:*}
		if [ -n "$trimmed" ] && [ -e "$trimmed" ]; then
			path_hint="$trimmed"
		fi
	fi

	local project_dir
	if [ -d "$path_hint" ]; then
		project_dir="$path_hint"
	else
		project_dir=$(dirname -- "$path_hint")
		[ -z "$project_dir" ] && project_dir="."
	fi
	[[ "$project_dir" == ~* ]] && project_dir="${project_dir/#\~/$HOME}"
	if ! project_dir=$(cd -- "$project_dir" 2>/dev/null && pwd -P); then
		"$code_bin" "$@"
		return
	fi

	local window_flag="--new-window"
	if [ $force_same -eq 1 ]; then
		window_flag="--reuse-window"
	else
		local status_lines=""
		local now
		now=$(date +%s)
		if [ -n "${__V_STATUS_CACHE_AT:-}" ] && [ -n "${__V_STATUS_CACHE:-}" ]; then
			if [ $((now - __V_STATUS_CACHE_AT)) -le 2 ]; then
				status_lines="$__V_STATUS_CACHE"
			fi
		fi
		if [ -z "$status_lines" ]; then
			status_lines=$("$code_bin" --status 2>/dev/null | sed -n -e 's/^[[:space:]]*Folder URI: //p' -e 's/^[[:space:]]*Workspace: //p') || status_lines=""
			__V_STATUS_CACHE="$status_lines"
			__V_STATUS_CACHE_AT=$now
		fi
		if [ -n "$status_lines" ]; then
			local line path
			while IFS= read -r line; do
				[ -z "$line" ] && continue
				path="$line"
				if [[ "$path" == file://* ]]; then
					path=${path#file://}
					if [[ "$path" == *%* ]]; then
						path=$(printf '%b' "${path//%/\\x}")
					fi
				fi
				[[ "$path" == ~* ]] && path="${path/#\~/$HOME}"
				if path=$(cd -- "$path" 2>/dev/null && pwd -P); then
					case "$project_dir" in
					"$path" | "$path"/*)
						window_flag="--reuse-window"
						break
						;;
					esac
				fi
			done <<<"$status_lines"
		fi
	fi

	local have_dir=0
	for arg in "${pass_args[@]}"; do
		[ "$arg" = "--" ] && break
		case "$arg" in
		-*)
			continue
			;;
		esac
		local candidate="$arg"
		[[ "$candidate" == ~* ]] && candidate="${candidate/#\~/$HOME}"
		if candidate=$(cd -- "$candidate" 2>/dev/null && pwd -P 2>/dev/null); then
			if [ "$candidate" = "$project_dir" ]; then
				have_dir=1
				break
			fi
		fi
	done

	local -a final_cmd=("$code_bin")
	final_cmd+=("$window_flag")
	if [ $have_dir -eq 0 ]; then
		final_cmd+=("$project_dir")
	fi
	final_cmd+=("${pass_args[@]}")

	"${final_cmd[@]}"
}

# Helper: Returns the fixed face [¬_¬] with a random ANSI color (red–cyan)
get_colored_face() {
	local face="[¬_¬]"
	local color=$(((RANDOM % 6) + 31))
	echo -e "\033[${color}m${face}\033[0m"
}

update_all() {
	local bold="\033[1m"
	local reset="\033[0m"

	# For Linux systems that use sudo (Debian-based), prompt early.
	if [[ "$(uname -s)" == "Linux" && -f /etc/debian_version ]]; then
		read -r -p "This update process will make system changes using sudo. Do you want to continue? [Y/n] " answer
		answer=${answer:-Y}
		if [[ ! "$answer" =~ ^[Yy] ]]; then
			echo "Aborting update."
			return 1
		fi
		# Prompt for sudo password now so it caches the credentials.
		sudo -v
	fi

	if [[ "$OSTYPE" == darwin* ]]; then
		# Mac App Store (MAS)

		# Check for outdated MAS apps
		local ts=$(date +%s)
		local colored_face
		colored_face=$(get_colored_face)
		local bold_ts="${bold}${ts}${reset}"
		echo -ne "${colored_face} ${bold_ts} Checking Mac App Store via \`mas outdated\` ... "
		local outdated_mas
		outdated_mas=$(mas outdated)
		if [ -z "$outdated_mas" ]; then
			echo "no updates found."
		else
			echo ""
			echo "$outdated_mas"
		fi

		# Upgrade MAS apps
		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Upgrading Mac App Store via \`mas upgrade\` ..."
		mas upgrade

		# Homebrew

		# Check for outdated Homebrew packages
		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -ne "${colored_face} ${bold_ts} Checking Homebrew via \`brew outdated\` ... "
		local outdated_brew
		outdated_brew=$(brew outdated)
		if [ -z "$outdated_brew" ]; then
			echo "no updates found."
		else
			echo ""
			echo "$outdated_brew"
		fi

		# Update Homebrew (verbose)
		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Updating Homebrew via \`brew update --verbose\` ..."
		brew update --verbose

		# Upgrade Homebrew packages (verbose)
		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Upgrading Homebrew via \`brew upgrade --verbose\` ..."
		brew upgrade --verbose

		# Upgrade Homebrew casks (greedy, verbose)
		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Upgrading Homebrew Casks via \`brew upgrade --cask --greedy --verbose\` ..."
		brew upgrade --cask --greedy --verbose

		# Cleanup Homebrew
		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Cleaning up Homebrew via \`brew cleanup\` ..."
		brew cleanup

		# Run Homebrew doctor
		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Running Homebrew doctor via \`brew doctor\` ..."
		brew doctor

	elif [[ "$(uname -s)" == "Linux" && -f /etc/debian_version ]]; then
		# APT (Debian-based)

		# Check for outdated APT packages
		local ts=$(date +%s)
		local colored_face
		colored_face=$(get_colored_face)
		local bold_ts="${bold}${ts}${reset}"
		echo -ne "${colored_face} ${bold_ts} Checking APT via \`apt list --upgradable\` ... "
		local outdated_apt
		outdated_apt=$(apt list --upgradable 2>/dev/null | tail -n +2)
		if [ -z "$outdated_apt" ]; then
			echo "no updates found."
		else
			echo ""
			echo "$outdated_apt"
		fi

		# Update APT (verbose, greedy)
		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Updating APT via \`sudo apt update -o Debug::Acquire::http=true\` ..."
		sudo apt update -o Debug::Acquire::http=true

		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Upgrading APT via \`sudo apt upgrade -y -V\` ..."
		sudo apt upgrade -y -V

		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Removing unused packages via \`sudo apt autoremove -y\` ..."
		sudo apt autoremove -y

		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Cleaning up via \`sudo apt autoclean\` ..."
		sudo apt autoclean
	fi

	# Claude Code Plugins
	ts=$(date +%s)
	colored_face=$(get_colored_face)
	bold_ts="${bold}${ts}${reset}"
	echo -e "${colored_face} ${bold_ts} Updating Claude Code plugins via \`claude-plugin-update\` ..."
	claude-plugin-update
}

# }}}

# Claude CLI {{{

# Claude CLI - bypass NVM lazy loading
# claude() {
#     ~/.claude/local/claude "$@"
# }

# Claude Update Plugins - updates all installed Claude Code plugins
claude-plugin-update() {
	local bold="\033[1m"
	local reset="\033[0m"
	local ts colored_face bold_ts

	# Update marketplace indexes first
	ts=$(date +%s)
	colored_face=$(get_colored_face)
	bold_ts="${bold}${ts}${reset}"
	echo -e "${colored_face} ${bold_ts} Updating Claude plugin marketplaces via \`claude plugin marketplace update\` ..."
	claude plugin marketplace update

	# Get list of installed plugins from settings.json
	ts=$(date +%s)
	colored_face=$(get_colored_face)
	bold_ts="${bold}${ts}${reset}"
	echo -ne "${colored_face} ${bold_ts} Checking installed plugins ... "

	local settings_file="$HOME/.claude/settings.json"
	if [ ! -f "$settings_file" ]; then
		echo "settings file not found."
		return 0
	fi

	local plugins
	plugins=$(jq -r '.enabledPlugins | keys[]' "$settings_file" 2>/dev/null)
	if [ -z "$plugins" ]; then
		echo "no plugins found."
		return 0
	fi
	local count
	count=$(echo "$plugins" | wc -l | tr -d ' ')
	echo "found ${count} plugins."

	# Update each plugin
	echo "$plugins" | while read -r plugin; do
		[ -z "$plugin" ] && continue
		ts=$(date +%s)
		colored_face=$(get_colored_face)
		bold_ts="${bold}${ts}${reset}"
		echo -e "${colored_face} ${bold_ts} Updating plugin via \`claude plugin update ${plugin}\` ..."
		claude plugin update "$plugin" 2>&1 || true
	done

	ts=$(date +%s)
	colored_face=$(get_colored_face)
	bold_ts="${bold}${ts}${reset}"
	echo -e "${colored_face} ${bold_ts} Done! Restart Claude Code to apply updates."
}

# }}}

# Vim {{{
# Vim Diff
vd() {
	vim -d -- "$1" "$2"
}

# }}}

# Neovim Client-Server {{{

# Connect to server or start new instance
# v() {
#     nvim --listen /tmp/nvim "$@"
# }
#
# Server management
vstatus() {
	[[ -S /tmp/nvim ]] && echo "Server running" || echo "No server"
}

vkill() {
	pkill -f "nvim.*--listen /tmp/nvim"
}

# }}}

# Hydra {{{

call_chatblade_ai() {
	local force_expensive=false
	local cb_args=()

	# Process wrapper flags:
	while [[ $# -gt 0 ]]; do
		case "$1" in
		-ex | --expensive)
			force_expensive=true
			;;
		-ch | --cheap)
			# ignore: default is cheap
			;;
		-t | --tokens)
			# ignore, token estimation always runs
			;;
		*)
			cb_args+=("$1")
			;;
		esac
		shift
	done

	# Set model: default to cheap mode (o1-mini), unless forced expensive.
	local model
	local model_label
	if $force_expensive; then
		model="o1"
		model_label="o1 (expensive)"
	else
		model="o1-mini"
		model_label="o1-mini (cheap)"
	fi

	# Append piped input (if any) to the query.
	if [ ! -t 0 ]; then
		local input
		input=$(cat)
		[ -n "$input" ] && cb_args+=("$input")
	fi

	# Ensure the "-e" flag (execution mode) is present.
	local has_e=false
	for arg in "${cb_args[@]}"; do
		if [ "$arg" = "-e" ]; then
			has_e=true
			break
		fi
	done
	if [ "$has_e" = "false" ]; then
		cb_args+=("-e")
	fi

	# Remove any user-provided temperature parameters.
	local filtered_args=()
	local i=0
	while [ $i -lt "${#cb_args[@]}" ]; do
		if [ "${cb_args[$i]}" = "--temperature" ]; then
			i=$((i + 2))
			continue
		else
			filtered_args+=("${cb_args[$i]}")
		fi
		i=$((i + 1))
	done

	# Build a query string for logging.
	local query
	query=$(printf "%s " "${filtered_args[@]}")

	# Read API key from file.
	local api_key
	api_key=$(cat ~/.openai)

	# Bold timestamp (e.g., **1740119698**)
	local timestamp
	timestamp=$(printf "\033[1m%s\033[0m" "$(date +%s)")

	# --- TOKEN ESTIMATION ---
	echo "$(get_colored_face) $timestamp Calling ${model_label} to estimate tokens using \`chatblade --openai-api-key <API_KEY> -c $model -s -i -t --temperature 1 -- ${filtered_args[@]}\`"
	chatblade --openai-api-key "$api_key" -c "$model" -s -i -t --temperature "1" -- "${filtered_args[@]}"
	local token_status=$?
	if [ $token_status -ne 0 ]; then
		timestamp=$(printf "\033[1m%s\033[0m" "$(date +%s)")
		echo "$(get_colored_face) $timestamp ERROR: Token estimation call failed with exit code $token_status."
		return $token_status
	fi

	# --- FINAL CALL ---
	timestamp=$(printf "\033[1m%s\033[0m" "$(date +%s)")
	echo "$(get_colored_face) $timestamp Calling ${model_label} to answer \`chatblade --openai-api-key <API_KEY> -c $model -s -i --temperature 1 -- ${filtered_args[@]}\`"
	chatblade --openai-api-key "$api_key" -c "$model" -s -i --temperature "1" -- "${filtered_args[@]}"
	local final_status=$?
	if [ $final_status -ne 0 ]; then
		timestamp=$(printf "\033[1m%s\033[0m" "$(date +%s)")
		echo "$(get_colored_face) $timestamp ERROR: Final Chatblade call failed with exit code $final_status."
		return $final_status
	fi
}
