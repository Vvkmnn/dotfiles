#!/usr/bin/env bash
# Vivek Menon - vvkmnn.xyz

# ┌─────────────────────────────── ~/.functions ─ Shell functions ─────────────┐
#  Vivek Menon <mail@vvkmnn.xyz>
# └────────────────────────────────────────────────────────────────────────────┘
#  Purpose: Complex operations that need logic/loops
#  Contains: get_colored_face(), _recover_cwd(), _fnm_lts_check(), _claude_config_backup(), c(), cl(), cc(), ct(), clh(), update_all(), coffee(), pif(), quicksave()
#  Archive: Disabled functions preserved at bottom

# ┌───────────────────────────────────────────────────────────────── guard ────┐
  [ -n "$__FUNCTIONS_SOURCED" ] && return
  __FUNCTIONS_SOURCED=1
  [ -n "$AI_SANDBOX_ONLY" ] && return
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── helper ──┐
  # random colored face for status output
  get_colored_face() {
    local faces=('[¬_¬]' '[^_^]' '[-_-]' '[o_o]' '[>_<]' '[T_T]' '[u_u]' '[n_n]' '[x_x]' '[~_~]' '[$_$]' '[+_+]' '[v_v]')
    local idx=$(( (RANDOM % ${#faces[@]}) + 1 ))  # zsh arrays are 1-indexed
    local face="${faces[$idx]}"
    local colors=(31 32 33 34 35 36 91 92 93 94 95 96)
    local color=${colors[$((RANDOM % ${#colors[@]} + 1))]}
    echo -e "\033[${color}m${face}\033[0m"
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────── cwd recovery ──┐
  # recover stale CWD after volume unmount/remount (e.g., SSD disconnect)
  # remembers original path so it can auto-return when volume comes back
  _recover_cwd() {
    if [[ -n "$_cwd_lost" ]] && [[ -d "$_cwd_lost" ]]; then
      builtin cd -q "$_cwd_lost" && unset _cwd_lost && return
    fi
    if ! [[ -d . ]]; then
      _cwd_lost="$PWD"
      builtin cd -q "$PWD" 2>/dev/null || builtin cd -q ~
    fi
  }
  [[ -n "$ZSH_VERSION" ]] && precmd_functions+=(_recover_cwd)
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────────── fnm ────┐
  # weekly background LTS check - writes notification for NEXT shell startup
  _fnm_lts_check() {
    echo "$(date +%Y)" > "$HOME/.cache/fnm-lts-check"  # mark checked this year
    local current=$(fnm current 2>/dev/null)
    local latest=$(fnm list-remote --lts 2>/dev/null | tail -1 | awk '{print $1}')
    [[ -n "$latest" && "$current" != "$latest" ]] && \
      echo -e "$(get_colored_face) [fnm] LTS $latest available → fnm install --lts" \
        > "$HOME/.cache/fnm-lts-notify"
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌───────────────────────────────────────────────────────────── claude-backup ──┐
  # weekly config backup - called silently from c/cl/cc
  _claude_config_backup() {
    local dir marker
    dir="$HOME/.claude/backups"
    marker="$dir/.last-backup"
    [[ -f "$marker" ]] && (( ($(date +%s) - $(<"$marker")) < 604800 )) && return
    mkdir -p "$dir"
    cp "$HOME/.claude/.claude.json" "$dir/.claude.json.$(date +%Y%m%d)"
    date +%s > "$marker"
    ls -t "$dir"/.claude.json.* 2>/dev/null | tail -n +4 | xargs rm -f
  } 2>/dev/null
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─────────────────────────────────────────────────────────────────── claude ──┐
  # crab status message: crab eyes, action, color
  __claude_msg() {
    local r='\033[0m'
    local color="$3"
    local action="${2%...}"
    echo -e "${color}(\/) ($1) (\/)${r} ${action}${color}...${r}"
  }

  # true if cwd has at least one Claude session jsonl
  # (~/.claude/projects/<encoded-cwd>/*.jsonl, where / and . both encode to -)
  __claude_has_session() {
    local enc="${PWD//\//-}"
    enc="${enc//./-}"
    local dir="$HOME/.claude/projects/$enc"
    # (N) = nullglob qualifier: empty array if no matches or dir missing.
    # Avoids `compgen` (a bash builtin absent in zsh unless bashcompinit is loaded).
    local sessions=("$dir"/*.jsonl(N))
    (( ${#sessions} ))
  }

  # internal wrapper: runs claude with idle detection + restart-on-idle loop
  # __claude_run MODE [ARGS...]  where MODE = continue | new | force
  __claude_run() {
    # Suppress [N] PID and [N]+ Done messages from background checker
    setopt LOCAL_OPTIONS NO_MONITOR NO_NOTIFY 2>/dev/null
    local mode="$1"; shift
    local gold='\033[38;5;214m' terra='\033[38;5;173m'
    local dim='\033[38;5;240m' r='\033[0m'

    # Capture tmux context once (pane doesn't change across restarts)
    local tmux_session="" tmux_window=""
    if [[ -n "$TMUX" ]]; then
      tmux_session=$(/opt/homebrew/bin/tmux display-message -p '#{session_name}' 2>/dev/null)
      tmux_window=$(/opt/homebrew/bin/tmux display-message -p '#{window_index}' 2>/dev/null)
    fi
    local checker="$HOME/.config/tmux/claude-idle-checker.sh"

    while true; do
      case "$mode" in
        continue) __claude_msg '-,,-' 'continuing...' "$gold" ;;
        new)      __claude_msg '°,,°' 'creating...' "$terra" ;;
        force)    __claude_msg '-,,-' 'continuing...' "$gold" ;;
      esac

      # Start idle checker in background (finds Claude via pgrep -P $$)
      local _checker_pid=""
      if [[ -x "$checker" ]]; then
        "$checker" $$ "$tmux_session" "$tmux_window" "$PWD" "${CLAUDE_IDLE_THRESHOLD:-1800}" &
        _checker_pid=$!
      fi

      # Run Claude in foreground (TUI requires it)
      local _claude_exit=0
      case "$mode" in
        continue)
          claude --continue "$@"
          _claude_exit=$?
          ;;
        new)      claude "$@" ;;
        force)    claude --continue "$@" ;;
      esac

      # Clean up checker
      local _checker_exit=0
      if [[ -n "$_checker_pid" ]]; then
        kill "$_checker_pid" 2>/dev/null
        wait "$_checker_pid" 2>/dev/null
        _checker_exit=$?
      fi

      # Any non-zero exit with existing sessions → show resume prompt, never auto-create
      if (( _claude_exit != 0 )); then
        echo -e "\n${dim}(\/) (~_~) (\/)${r} session ended ${dim}— press Enter to resume, Ctrl+C for shell${r}"
        read -r || break
        continue
      fi

      # Normal exit (0) → return to shell
      break
    done
  }

  # smart continue - fallback to new only if no session
  c() {
    (_claude_config_backup &)
    if __claude_has_session; then
      __claude_run continue "$@"
    else
      __claude_run new "$@"
    fi
  }

  # always new session
  cl() {
    (_claude_config_backup &)
    __claude_run new "$@"
  }

  # force continue (no fallback)
  cc() {
    (_claude_config_backup &)
    __claude_run force "$@"
  }

  # agent teams - always new session (teams can't resume/continue)
  ct() {
    (_claude_config_backup &)
    local peach='\033[38;5;209m'
    __claude_msg '^,,^' 'assembling...' "$peach"
    CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 claude "$@"
  }

  # fzf session history picker — search, preview, resume/jump
  clh() {
    local amber='\033[38;5;208m'
    __claude_msg 'o,,o' 'searching...' "$amber"
    ~/.config/fzf/clh.sh "$@"
  }
# └─────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────────── fleet ──┐
  # Reach any fleet Mac by its real device name (resolved via Tailscale MagicDNS,
  # so it works on the LAN or any network). Two v-verbs + two extras; no host map —
  # the name is passed straight to mosh/ssh/open, MagicDNS resolves it.
  #
  #   vssh vminim4        v[jump]: mosh into the mini's tmux in a fresh Ghostty window (terminal)
  #   vwatch                v[wake]: keep THIS machine awake so its agents run while you travel
  #   vremote vminim4        screen-share the mini (first-party Screen Sharing, full GUI)
  # Two ways in: vssh = terminal · vremote = screen.

  # _fleet_host <name> — resolve to a reachable form: prefer the bare name (Tailscale
  # MagicDNS, works on any network), fall back to <name>.local (Bonjour, LAN). Lets you
  # type `j vminim4` and have it work on the LAN today and over Tailscale later — no suffix.
  _fleet_host() {
    local h="$1"
    case "$h" in mini) h=vminim4;; air) h=vbookairm3;; neo) h=vbookneoa18;; esac  # friendly → true hostname
    if ping -c1 -t1 "$h" >/dev/null 2>&1; then print -- "$h"; return 0
    elif ping -c1 -t1 "$h.local" >/dev/null 2>&1; then print -- "$h.local"; return 0
    else print -- "$h"; return 1; fi   # unreachable: still print the name, signal via exit code
  }

  # vssh <host> — v[jump]: open a FRESH Ghostty window that's a DIRECT client to THAT machine's
  # tmux server, over mosh (auto-reconnects across sleep / wifi↔cellular / travel). No local
  # tmux wraps it (`open -e` skips the autostart) → C-a / C-hjkl / prefix / finder all drive the
  # remote, navigate all its windows+panes like you're sitting there. mosh (not ssh): tmux persists
  # server-side and mosh silently resumes the link, so closing the lid mid-session just picks back
  # up. `env -u TMUX` strips leaked tmux vars (no nesting). PRE-FLIGHT reachability runs in THIS
  # shell BEFORE opening a window, so an asleep/offline machine never spawns a dead hanging window.
  # Each vssh = a FRESH, auto-numbered session on the target (`tmux new-session` → 0,1,2… like
  # opening a new local tmux window), independent, never mirroring a previous one. mosh's ssh gets
  # ConnectTimeout so it fails fast; if the link drops mid-session, mosh resumes THAT window on wake.
  vssh() {
    local name="${1:?usage: vssh <host>   (e.g. vssh vminim4 | vssh vbookneo)}"
    local G=$'\e[38;5;114m' Y=$'\e[38;5;179m' D=$'\e[2m' R=$'\e[0m'
    printf "  ${D}reaching %s…${R}" "$name"
    local host
    if host=$(_fleet_host "$name"); then
      printf "\r  ${G}●${R} %s ${D}up — connecting${R}              \n" "$name"
    else
      printf "\r  ${Y}○${R} %s ${D}offline — asleep or off (run \`vwatch\` on it, or wake it)${R}\n" "$name"
      return 1
    fi
    open -na /Applications/Ghostty.app --args -e /bin/zsh -c \
      "env -u TMUX -u TMUX_PANE mosh --ssh='ssh -o ConnectTimeout=4' --family=inet ${(q)host} -- tmux new-session"
  }

  # _vwatch_bar <pct> — 10-cell ASCII charge bar, e.g. [#######---].
  _vwatch_bar() {
    local p=${1:-0} n i out=""
    (( n = p / 10 )); (( n > 10 )) && n=10
    for (( i = 0; i < 10; i++ )); do (( i < n )) && out+="#" || out+="-"; done
    print -r -- "$out"
  }

  # _vwatch_render <caffeinate-pid> — one ASCII frame of the vwatch dashboard (no sudo; pmset/tmux only).
  _vwatch_render() {
    local caff=$1 host=${HOST%%.*} batt=$(pmset -g batt)
    local pct=$(print -r -- "$batt" | grep -oE '[0-9]+%' | head -1 | tr -d '%')
    local ac=0; print -r -- "$batt" | grep -q 'AC Power' && ac=1
    local lim=$(pmset -g therm 2>/dev/null | grep -oE 'CPU_Speed_Limit *= *[0-9]+' | grep -oE '[0-9]+$')
    local hot=0; [[ -n "$lim" && "$lim" != 100 ]] && hot=1
    local load=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')
    local up=$(uptime | sed -E 's/.*up +//; s/, *[0-9]+ users?.*//')
    local ns=$(tmux list-sessions 2>/dev/null | grep -c .) nw=$(tmux list-windows -a 2>/dev/null | grep -c .)
    local rule="  $(printf -- '-%.0s' {1..54})"
    local pstate; (( ac )) && pstate="AC     " || pstate="battery"
    local temp; (( hot )) && temp="%F{red}THROTTLING ${lim}%%%f" || temp="%F{green}ok%f"
    print -n $'\e[H\e[2J'
    print -P "  %B${host}%b · up ${up} · $(date +%H:%M)"
    print -P "$rule"
    print -P "  power   ${pstate} ${pct:-?}%% [$(_vwatch_bar ${pct:-0})]   temp ${temp}   load ${load:-?}"
    if (( hot )); then
      print -P "  wake    %F{red}HOT%f — throttling; open the lid or cut load (still holding awake)"
    elif (( ac )); then
      print -P "  wake    %F{green}AVAILABLE%f — held awake on AC (no battery cost)"
    else
      print -P "  wake    %F{yellow}AVAILABLE%f — held awake on battery (${pct:-?}%%, draining) — plug in to spare it"
    fi
    print -P "$rule"
    print -P "  agents"
    local agents=$(tmux list-windows -a -F '#{session_name}:#{window_index}|#{window_name}|#{pane_current_command}|#{@agent_status}' 2>/dev/null | grep -iE '\|[^|]*(claude|codex)')
    if [[ -n "$agents" ]]; then
      print -r -- "$agents" | while IFS='|' read -r loc name cmd st; do
        local g
        case "$st" in
          busy)    g="%F{red}*%f";;
          waiting) g="%F{yellow}?%f";;
          done)    g="%F{green}=%f";;
          *)       g="%F{8}.%f"; st="idle";;
        esac
        print -P "    ${g} ${(r:11:)name}%F{8}${loc}%f ${st}"
      done
    else
      print -P "    %F{8}(no agents running)%f"
    fi
    print -P "$rule"
    print -P "  tmux    ${ns} sessions · ${nw} windows          %F{8}^C to release%f"
  }

  # vwatch — v[wake]: keep THIS machine available for agentic work by any means, wasting the least
  # energy possible. `caffeinate -im` holds the SYSTEM awake on AC *and* battery (lid open), but
  # lets the display sleep (no -d = no wasted backlight). On battery it stays up and shows the
  # drain honestly, so you decide when to plug in. Thermal-aware: warns if the fanless chassis
  # throttles. SINGLE-INSTANCE: if a vwatch already holds this machine awake, it reports WHERE and
  # exits — never competes. Live ASCII dashboard: power, thermal, agents, tmux. `disown`ed +
  # EXIT-trap cleanup: never a stray "running job"; ^C/close -> caffeinate dies, no disk artifact.
  vwatch() {
    local existing=$(pgrep -f 'caffeinate -im' 2>/dev/null | head -1)
    if [[ -n "$existing" ]]; then
      local owner=$(ps -o ppid= -p "$existing" 2>/dev/null | tr -d ' ')
      local loc=$(tmux list-panes -a -F '#{pane_pid} #{session_name}:#{window_index}.#{pane_index}' 2>/dev/null | awk -v p="$owner" '$1==p{print $2}')
      print -P "  %F{yellow}${HOST%%.*} is already awake%f — vwatch is running in %F{cyan}${loc:-pid $owner}%f (caffeinate ${existing})."
      print -P "  Go there, or ^C it to release. Exiting."
      return 0
    fi
    # caffeinate -im: keep the SYSTEM awake for work on AC *and* battery (unlike -s = AC-only),
    # but NOT -d — let the display sleep so we waste the least energy. `disown` so it's never a
    # tracked shell job (no "you have running jobs" on exit).
    caffeinate -im & local caff=$!; disown
    # cleanup on ANY exit (Ctrl-C, error, normal) so caffeinate never leaks — even a render error
    # that aborts the function fires this EXIT trap, killing it + restoring the cursor.
    trap 'kill $caff 2>/dev/null; tput cnorm 2>/dev/null; print -P "\n  %F{cyan}${HOST%%.*} released%f"' EXIT
    tput civis 2>/dev/null
    while :; do _vwatch_render "$caff"; sleep 3; done
  }

  # vremote <host> — jump visually: open first-party Screen Sharing to a machine.
  vremote() {
    local name="${1:?usage: vremote <host>   (e.g. vremote mini | vremote neo)}"
    local G=$'\e[38;5;114m' Y=$'\e[38;5;179m' D=$'\e[2m' R=$'\e[0m'
    printf "  ${D}reaching %s…${R}" "$name"
    local host
    if host=$(_fleet_host "$name"); then
      printf "\r  ${G}●${R} %s ${D}up — opening screen${R}              \n" "$name"
    else
      printf "\r  ${Y}○${R} %s ${D}offline — asleep or off (run \`vwatch\` on it, or wake it)${R}\n" "$name"
      return 1
    fi
    open "vnc://${host}"
  }

  # tab-completion for vssh/vremote — friendly aliases (mini/air/neo) AND true hostnames (live
  # from Tailscale, else the known set), so you never memorize. Guarded: no-op if compinit isn't up.
  _vfleet_hosts() {
    local -a aliases=('mini:vminim4' 'air:vbookairm3' 'neo:vbookneoa18')
    local -a hosts
    local ts=${commands[tailscale]:-/Applications/Tailscale.app/Contents/MacOS/Tailscale}
    [[ -x "$ts" ]] && hosts=(${(f)"$("$ts" status 2>/dev/null | awk '$1 ~ /^100\./{print $2}')"})
    (( ${#hosts} )) || hosts=(vminim4 vbookairm3 vbookneo)
    _describe 'alias' aliases
    _describe 'hostname' hosts
  }
  (( $+functions[compdef] )) && compdef _vfleet_hosts vssh vremote 2>/dev/null

# └─────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── update ──┐
  # update all: mas, brew, apt, fnm, uv, rustup, nvim
  update_all() {
    local log="/tmp/update_all.log"
    local start_time=$SECONDS warnings=0 errors=0
    local dim='\033[2m' bold='\033[1m' r='\033[0m'

    # section helper: face, title, revert_hint, command...
    __section() {
      local title="$1" revert="$2" warn="$3"; shift 3
      local sec_start=$SECONDS
      echo -e "\n$(get_colored_face) ${bold}$(date +%s)${r} ─── ${title} ───"
      if "$@" 2>&1 | sed 's/^/  │ /'; then
        local elapsed=$(( SECONDS - sec_start ))
        if [[ "$warn" == "warn" ]]; then
          echo -e "  └─ ${dim}⚠ done in ${elapsed}s (revert: ${revert})${r}"
          (( warnings++ ))
        else
          echo -e "  └─ ${dim}✓ done in ${elapsed}s (revert: ${revert})${r}"
        fi
      else
        local elapsed=$(( SECONDS - sec_start ))
        echo -e "  └─ ${dim}✗ failed in ${elapsed}s (revert: ${revert})${r}"
        (( errors++ ))
      fi
    }

    # header with randomly colored cat
    local colors=(31 32 33 34 35 36 91 92 93 94 95 96)
    local cat_color=${colors[$((RANDOM % ${#colors[@]} + 1))]}
    echo -e "╭──────────────────────────────────────────────────────────────────────────────╮"
    echo -e "│  \033[${cat_color}mᓚᘏᗢ${r}  update_all started at $(date '+%Y-%m-%d %H:%M:%S')                            │"
    echo -e "│       Log: ${log} (pipe to claude if issues)                   │"
    echo -e "╰──────────────────────────────────────────────────────────────────────────────╯"

    # Linux: prompt for sudo early
    if [[ -f /etc/debian_version ]]; then
      read -r -p "This will use sudo. Continue? [Y/n] " answer
      [[ ! "${answer:-Y}" =~ ^[Yy] ]] && echo "Aborted." && return 1
      sudo -v
    fi

    # macOS
    if [[ "$OSTYPE" == darwin* ]]; then
      __section "Mac App Store" "mas install <app-id>" "" mas upgrade
      __section "Homebrew" "brew install <pkg>@<version>" "" brew update
      __section "Homebrew packages" "brew pin <pkg>" "" brew upgrade
      __section "Homebrew casks" "brew install --cask <pkg>" "" brew upgrade --cask --greedy
      __section "Homebrew cleanup" "n/a" "" brew cleanup
    fi

    # Linux
    if [[ -f /etc/debian_version ]]; then
      __section "APT update" "n/a" "" sudo apt update
      __section "APT upgrade" "sudo apt install <pkg>=<version>" "" sudo apt upgrade -y
      __section "APT autoremove" "sudo apt install <pkg>" "" sudo apt autoremove -y
    fi

    # Cross-platform tools
    __section "mise (tool versions)" "mise use <tool>@<old-version>" "" mise upgrade
    __section "uv (Python)" "uv self update --version <old>" "" uv self update
    __section "rustup (Rust)" "rustup default <old-version>" "warn" rustup update
    __section "Neovim plugins" "cd ~/.local/share/nvim/lazy/<plugin> && git checkout" "" \
      nvim --headless "+Lazy! sync" +qa

    # footer
    local total=$(( SECONDS - start_time ))
    local summary="${warnings} warning(s), ${errors} error(s)"
    echo -e "\n╭──────────────────────────────────────────────────────────────────────────────╮"
    echo -e "│  ✓ update_all completed in ${total}s (${summary})                      │"
    echo -e "│  Issues? Run: cat ${log} | claude \"analyze errors\"                 │"
    echo -e "╰──────────────────────────────────────────────────────────────────────────────╯"

    # macOS notification
    [[ "$OSTYPE" == darwin* ]] && osascript -e "display notification \"${summary}\" with title \"update_all ✓\" sound name \"Glass\"" &>/dev/null

  } 2>&1 | tee /tmp/update_all.log
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── coffee ──┐
  # Stay awake with the lid closed (headless), reachable over Tailscale + mosh,
  # with a live dashboard so you SEE the cost to the machine while it runs
  # (drain rate, ETA to battery floor, wear, who's connected). Ctrl+C restores.
  #
  # Does NOT touch yabai/sketchybar or any of your services — only flips the one
  # sleep setting the original `coffee` flipped. Telemetry is 100% sudo-free
  # (pmset + one ioreg dump + loadavg), so the dashboard works fine over mosh.
  #   COFFEE_FLOOR=NN  battery %% at which it auto-restores on battery (default 20)
  #   COFFEE_BLANK=1   blank the internal panel now (sudo-free); else just close
  #                    the lid to turn it off
  #   NO_COLOR         monochrome
  #   sudo footprint = identical to the original: one `pmset -a disablesleep 1/0`.
  #   Run inside tmux for walk-away use so it survives a dropped mosh link.
  coffee() {
    [[ "$OSTYPE" != darwin* ]] && echo "macOS only" && return 1
    local floor=${COFFEE_FLOOR:-20} start=$SECONDS start_pct=""
    _COFFEE_OFF=0    # reset idempotent-restore guard (process-local, no disk state)
    local B=$'\e[1m' D=$'\e[2m' R=$'\e[0m'
    local G=$'\e[38;5;114m' Y=$'\e[38;5;179m' RD=$'\e[38;5;174m' CO=$'\e[38;5;173m' HR=$'\e[38;5;238m'
    [[ -n "$NO_COLOR" ]] && { B= D= R= G= Y= RD= CO= HR=; }

    # safety pre-flight: don't go headless already-doomed on battery
    local pf_pct pf_ac
    pf_pct=$(pmset -g batt | grep -Eo '[0-9]+%' | head -1 | tr -d '%')
    pmset -g batt | grep -qi 'AC Power' && pf_ac=1 || pf_ac=0
    if (( ! pf_ac )) && (( pf_pct <= floor )); then
      echo -e "$(get_colored_face) Battery ${pf_pct}% ≤ floor ${floor}% on battery — plug in first."
      return 1
    fi

    echo -e "$(get_colored_face) Disabling lid sleep..."

    # stay awake — the SAME single sudo command the original `coffee` used, so any
    # existing passwordless sudoers rule still matches. Only this needs root.
    sudo pmset -a disablesleep 1 || return 1

    # remote surface (verify, don't install)
    local user tsip; user=$(whoami)
    tsip=$(command -v tailscale >/dev/null && tailscale ip -4 2>/dev/null | head -1)
    [[ -z "$tsip" ]] && tsip="<run: tailscale up>"
    [[ -n "$COFFEE_BLANK" ]] && pmset displaysleepnow   # sudo-free immediate panel-off (opt-in)
    echo -e "$(get_colored_face) Lid can close now. Reconnect: ${B}mosh ${user}@${tsip}${R}"
    echo    "$(get_colored_face) Floor ${floor}% · close lid to blank panel · Ctrl+C to stop"

    # live dashboard = the hold loop + battery-floor watchdog (11-line panel)
    local stop=0 first=1 i=0 H=11
    local steam=('˚ ' ' ˳' '° ' ' ‧')
    local tsstate="up"; [[ "$tsip" == \<* ]] && tsstate="down"
    # INT = Ctrl+C; HUP/TERM = mosh/ssh dropped WITHOUT tmux — restore while sudo
    # creds are still cached (~5min) so the machine doesn't stay stuck awake.
    trap 'stop=1' INT HUP TERM
    tput civis 2>/dev/null

    while (( ! stop )); do
      local pct dir cyc health watts ncc volt load
      pct=$(pmset -g batt | grep -Eo '[0-9]+%' | head -1 | tr -d '%')
      [[ -z "$start_pct" ]] && start_pct=$pct
      read cyc health watts dir ncc volt <<<"$(ioreg -rn AppleSmartBattery | awk -F'= ' '
        /"CycleCount"/{c=$2} /"InstantAmperage"/{a=$2} /"Voltage"/{v=$2}
        /"NominalChargeCapacity"/{n=$2} /"DesignCapacity"/{d=$2}
        END{ if(a>2^63)a-=2^64;
             printf "%d %.0f %.2f %s %d %d\n", c,(d?n/d*100:0),(a<0?-a:a)*v/1e6,(a<0?"dis":"chg"),n,v }')"
      load=$(sysctl -n vm.loadavg | awk -v n=$(sysctl -n hw.ncpu) '{gsub(/[{}]/,"");printf "%.0f",$1/n*100}')

      # who's attached right now (sudo-free): mosh procs, established ssh:22 / vnc:5900
      # NB: macOS pgrep has no -c flag — count with wc -l.
      local mosh ssh vnc
      mosh=$(pgrep -f mosh-server 2>/dev/null | wc -l | tr -d ' ')
      read ssh vnc <<<"$(netstat -an -p tcp 2>/dev/null | awk '$NF=="ESTABLISHED"{
        n=split($4,a,".");p=a[n]; if(p==22)s++; else if(p==5900)v++} END{print s+0, v+0}')"

      # thermal throttle alarm (fanless Air, lid-closed): CPU_Speed_Limit appears only
      # when the SoC is throttling. <100 = being held back by heat. Sudo-free.
      local therm=100
      therm=$(pmset -g therm 2>/dev/null | awk -F'= ' '/CPU_Speed_Limit/{print $2+0; exit}'); : ${therm:=100}

      local eta arrow bc
      if [[ "$dir" == dis ]] && (( pct > floor )); then
        eta=$(awk -v w=$watts -v ncc=$ncc -v v=$volt -v p=$pct -v fl=$floor 'BEGIN{
          wh=ncc/1000*v/1000; if(w<=0||wh<=0){print "discharging";exit}
          pph=w/wh*100; h=(p-fl)/pph;
          printf "~%dh%02dm to %d%% floor", int(h), int((h-int(h))*60), fl }')
        arrow="↓"; bc=$G; (( pct<=50 )) && bc=$Y; (( pct<=floor+5 )) && bc=$RD
      else
        eta="on AC — banking charge"; arrow="↑"; bc=$G
      fi
      local delta=$(( start_pct - pct )) dsign="−"
      (( delta < 0 )) && { dsign="+"; delta=$(( -delta )); }
      local el; el=$(printf '%02d:%02d:%02d' $(((SECONDS-start)/3600)) $(((SECONDS-start)%3600/60)) $(((SECONDS-start)%60)))

      (( first )) || { tput cuu $H 2>/dev/null; tput ed 2>/dev/null; }
      print -r -- ""
      print -r -- "   ☕${steam[i%4+1]}  ${B}coffee${R}                         awake  ${el}"
      print -r -- ""
      print -r -- "   battery  ${bc}${B}${pct}%${R} ${arrow}  ${watts}W        ${D}${dsign}${delta}% since brewing${R}"
      print -r -- "   ${bc}$(_coffee_bar $pct 22)${R}  ${D}${eta}${R}"
      print -r -- ""
      print -r -- "   wear     ${B}${health}%${R} health ${D}·${R} ${cyc} cycles"
      local thermtag=""; (( therm < 100 )) && thermtag="   ${RD}${B}⚠ thermal ${therm}%${R}"
      print -r -- "   load     ${B}${load}%${R} cpu${thermtag}"
      print -r -- "   $(_coffee_bar $load 22)"
      print -r -- ""
      local lm=$D lv=$D; (( mosh>0 )) && lm=$G; (( vnc>0 )) && lv=$G
      print -r -- "   link     ${lm}mosh×${mosh}${R} ${D}ssh×${ssh}${R} ${lv}vnc×${vnc}${R}   ${D}· tailscale ${tsstate}${R}"
      first=0

      (( pct <= floor )) && [[ "$dir" == dis ]] && stop=1
      (( stop )) && break
      (( i++ )); sleep 2
    done

    _coffee_restore
  }

  # filled/empty progress bar: $1=percent $2=width
  _coffee_bar() {
    local p=$1 w=$2 f e i out=""
    (( f = p*w/100 )); (( f>w )) && f=$w; (( f<0 )) && f=0; (( e = w-f ))
    for ((i=0;i<f;i++)) out+="█"; for ((i=0;i<e;i++)) out+="░"
    print -rn -- "▕${out}▏"
  }

  # restore: the ONLY sudo is the exact original-coffee `disablesleep 0`.
  # Touches nothing else.
  _coffee_restore() {
    tput cnorm 2>/dev/null; trap - INT
    echo ""
    echo -e "$(get_colored_face) Restoring lid sleep..."
    sudo pmset -a disablesleep 0
    echo -e "$(get_colored_face) Sleep restored."
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────── yabai ───┐
  # toggle yabai on/off
  ,,y() {
    if pgrep -x yabai >/dev/null; then
      echo -e "$(get_colored_face) Stopping yabai..."
      yabai --stop-service
    else
      echo -e "$(get_colored_face) Starting yabai..."
      yabai --start-service
    fi
  }
# └────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────── games ────┐
  # Pokemon Infinite Fusion — Wine Crossover (Gcenx fork) on macOS ARM64
  #
  # Game folder:  ~/Library/Mobile Documents/.../Games/PokemonInfiniteFusion/ (iCloud)
  # Engine:       Wine Crossover 23.7.1 via Rosetta 2 (native mkxp-z had broken fonts)
  # Wine config:  FontSmoothing=0, ForceOpenGLBackingStore=y (set in Wine registry)
  # Saves:        game folder Saves/ (Wine accesses directly via working directory)
  # Debug:        $DEBUG = true prepended to 001_Settings.rb (enables F9 menu)
  #               Wiped on every update (git reset --hard), auto-reapplied here
  # Updates:      git fetch --depth=1 origin releases && git reset --hard origin/releases
  #               Never touch main branch (dev, 1197+ unstable commits)
  pif() {
    local dir="/Users/v/Library/Mobile Documents/com~apple~CloudDocs/Games/PokemonInfiniteFusion"
    local wine="/opt/homebrew/bin/wine"
    if [[ ! -d "$dir" ]]; then
      echo "Not found: $dir" && return 1
    fi
    if [[ ! -x "$wine" ]]; then
      echo "Wine not found: $wine (brew install --cask gcenx/wine/wine-crossover)" && return 1
    fi
    # Re-apply debug patch if missing (git reset --hard wipes it on updates)
    if ! head -1 "$dir/Data/Scripts/001_Settings.rb" | grep -q 'DEBUG'; then
      sed -i '' '1i\
$DEBUG = true  # enable debug mode (F9) without Magic Boots
' "$dir/Data/Scripts/001_Settings.rb"
      echo "Debug patch re-applied."
    fi
    echo -e "$(get_colored_face) Launching Pokemon Infinite Fusion (Wine)..."
    cd "$dir" && "$wine" InfiniteFusion.exe 2>&1
  }
# └────────────────────────────────────────────────────────────────────────────┘

