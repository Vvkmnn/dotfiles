  "model": "fable",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:$HOME/.local/share/mise/shims:$PATH\" node ~/.claude/hooks/user-prompt-submit.js"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:$HOME/.local/share/mise/shims:$PATH\" node ~/.claude/hooks/subagent-telemetry.js"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:$HOME/.local/share/mise/shims:$PATH\" node ~/.claude/hooks/subagent-telemetry.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:$HOME/.local/share/mise/shims:$PATH\" node ~/.claude/hooks/session-start.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:$HOME/.local/share/mise/shims:$PATH\" node ~/.claude/hooks/pre-tool-use.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:$HOME/.local/share/mise/shims:$PATH\" node ~/.claude/hooks/post-tool-use.js"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:$HOME/.local/share/mise/shims:$PATH\" node ~/.claude/hooks/notification.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:$HOME/.local/share/mise/shims:$PATH\" node ~/.claude/hooks/notification.js"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:$HOME/.local/share/mise/shims:$PATH\" node ~/.claude/hooks/pre-compact.js"
          }
        ]
      }
    ]
