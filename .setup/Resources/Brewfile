# Brewfile — workstation profile (one curated list = what we actually use)
#
# POLICY: nothing is ever deleted. Items we don't use are COMMENTED OUT below
# (in the "DISABLED" section) with the reason, so you can remember why and
# re-enable in one edit. `brew bundle` ignores commented lines.
#   - to enable a disabled item: uncomment its line, run `brew bundle`
#   - to disable an active item: comment its line (keep the reason note)
#
# Curated 2026-06-25 from the laptop's ~140-item set. Active = what's used on
# this 8GB machine; Disabled = unused/redundant/heavy, kept for reference.

###############################################################################
# ACTIVE — taps (only those backing an active formula)                        #
###############################################################################
tap "koekeishiya/formulae"            # yabai + skhd (tiling WM + hotkey daemon)
tap "felixkratz/formulae"             # sketchybar + borders (status bar + window borders)
tap "crissnb/dynamicisland"           # dynamic-island-style sketchybar plugin
tap "acsandmann/tap"                  # menuanywhere (menu-bar helper)
tap "epk/epk"                         # SF Mono Nerd Font (your active terminal font)
tap "oven-sh/bun"                     # bun JS runtime (dev)
tap "supabase/tap"                    # supabase CLI (dev backend)
tap "getsentry/xcodebuildmcp"         # xcodebuildmcp (Claude MCP server)
tap "joachimbrindeau/ccusage-monitor" # ccusage-monitor (Claude usage/cost monitor)

###############################################################################
# ACTIVE — system / shell dependencies                                        #
###############################################################################
brew "coreutils"   # GNU core utilities (gls/gdate etc; many scripts assume them)
brew "openssl@3"   # TLS library — dependency of git, python, many tools
brew "xz"          # compression lib — common build dependency
brew "zlib"        # compression lib — common build dependency
brew "bash"        # modern bash 5 for scripts (you use zsh interactively)

###############################################################################
# ACTIVE — terminal tools (wired in .alias / .shell / .functions)             #
###############################################################################
brew "bat"         # `cat` replacement w/ syntax highlight — alias cat='bat'
brew "fd"          # fast `find` replacement — alias find='fd', used in f()
brew "fzf"         # fuzzy finder — Ctrl-R history + f() search (.shell)
brew "ripgrep"     # fast grep (rg) — used in search functions
brew "eza"         # `ls` replacement — alias e=/ll= (.alias)
brew "zoxide"      # smarter `cd` — eval zoxide init (.shell)
brew "atuin"       # shell history sync across machines — Ctrl-R (.shell)
brew "yazi"        # terminal file manager — alias yy (.alias)
brew "lf"          # lightweight terminal file manager — lfcd() (.functions)
brew "jless"       # interactive JSON viewer

###############################################################################
# ACTIVE — editor (Neovim ecosystem; .config/nvim is the v.nvim submodule)    #
###############################################################################
brew "neovim"      # primary editor — alias v (.alias)
brew "lua"         # Neovim config language / plugin runtime
brew "luarocks"    # Lua package manager (some nvim plugins need it)
brew "tree-sitter" # syntax parsing used by Neovim highlighting

###############################################################################
# ACTIVE — git + auth/secrets                                                 #
###############################################################################
brew "git"             # version control
brew "gh"              # GitHub CLI — HTTPS auth (token in macOS Keychain)
brew "git-delta"       # git diff pager — configured in .gitconfig
brew "git-crypt"       # decrypts repo secrets (.claude.json etc) — AI.md P7
brew "git-lfs"         # large-file storage — [filter "lfs"] in .gitconfig
brew "gnupg"           # GPG — commit signing + gpg-agent SSH (.shell)

###############################################################################
# ACTIVE — runtimes / build (mise manages node+python; uv for Python pkgs)    #
###############################################################################
brew "mise"        # runtime version manager — replaces nvm/fnm/pyenv (.shell)
brew "uv"          # fast Python pkg/venv manager — used in .functions update (ADDED: was missing)
brew "go"          # Go toolchain — needed by go-grip (markdown preview skill)
brew "cmake"       # build system — managed/used via mise

###############################################################################
# ACTIVE — monitoring / misc CLI                                              #
###############################################################################
brew "btop"               # system monitor (primary; replaces bottom/macmon/mactop)
brew "mas"                # Mac App Store CLI — installs the `mas` entries below
brew "terminal-notifier"  # send macOS notifications from scripts/Claude

###############################################################################
# ACTIVE — containers (on-demand only; nothing auto-starts on login)          #
###############################################################################
brew "docker"          # docker CLI (talks to colima; or remote context in Phase 2)
brew "docker-buildx"   # docker buildx plugin
