# ┌───────────────────────────────── ~/.minimal ─ Minimal shell config ────────┐
#  Vivek Menon <mail@vvkmnn.xyz>
# └────────────────────────────────────────────────────────────────────────────┘
#  Purpose: Bare essentials for restricted/sandbox environments
#           Used when AI_SANDBOX_ONLY=1 or minimal shell needed
#  Also:    This file IS ~/.zshenv (symlinked) — the ONE startup file zsh sources on EVERY
#           invocation, including a non-login `zsh -c "…"`. That's the key case: `vj`/`vssh` open
#           the remote window as `ghostty -e /bin/zsh -c "…mosh/et…"`, which sources ONLY this
#           file — never .zprofile (login) / .zshrc (interactive → where .profile/.shell/.functions
#           load). So any env a REMOTE JUMP needs (SSH_AUTH_SOCK, MOSH_PREDICTION_OVERWRITE, TERM)
#           must live HERE, not in .shell/.zshrc.
#             man zshall › STARTUP FILES:  .zshenv=always · .zprofile/.zlogin=login · .zshrc=interactive
#  Contains: Basic PATH, EDITOR, TERM  +  MOSH_PREDICTION_OVERWRITE, SSH_AUTH_SOCK(→1Password), GPG_TTY

# GUARD Prevent double-sourcing (shell-local, fresh per new shell)
#       No AI_SANDBOX_ONLY check - this file SETS that flag
[ -n "$__MINIMAL_SOURCED" ] && return
__MINIMAL_SOURCED=1

export LANG=${LANG:-en_US.UTF-8}
export LC_ALL=${LC_ALL:-en_US.UTF-8}
export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:$HOME/.local/bin:$PATH"

# bash's analogue to how zsh always sources .zshenv: bash sources $BASH_ENV for NON-interactive
# shells (`bash -c "…"`). Point it at ~/.bashenv (a symlink to THIS file), so a bash jump gets the
# same PATH/SSH_AUTH_SOCK/TERM as zsh — one env file, both shells. Interactive bash already reaches
# this via .bashrc→.rc→.minimal; this covers the non-interactive case that had no shared env.
export BASH_ENV="$HOME/.bashenv"

# Essentials for AI tools
export EDITOR=${EDITOR:-nvim}
export VISUAL=${VISUAL:-$EDITOR}
export TERM=${TERM:-xterm-256color}
# A jump (vssh/mosh from Ghostty) forwards TERM=xterm-ghostty. If THIS machine lacks that terminfo
# entry, zsh's line editor errors ("can't find terminal definition"). Fall back so it never does —
# tmux sets its own TERM inside a session, so this only touches the pre-tmux outer shell. Gated to
# ghostty TERMs (the only forwarded value that bites), so it costs one infocmp on jumps, nothing else.
case "$TERM" in ghostty|xterm-ghostty|*-ghostty)
  command infocmp "$TERM" >/dev/null 2>&1 || export TERM=xterm-256color ;;
esac

# ── remote-launch env: why it lives HERE (.zshenv) ──────────────────────────────
#  A non-login, non-interactive `zsh -c "…"` sources ONLY .zshenv — which is exactly how
#  `vj`/`vssh` open the remote window (`ghostty -e zsh -c "…mosh/et…"`). `.zprofile` (login-
#  only) and `.zshrc` (interactive-only → where .profile/.shell/.functions get sourced) never
#  run there. So any env a remote jump needs must live in this file, not .shell/.zshrc.
#    man zshall › STARTUP FILES:  .zshenv=always · .zprofile/.zlogin=login · .zshrc=interactive
# ────────────────────────────────────────────────────────────────────────────────

# mosh client rendering: overwrite speculative local echo instead of inserting it BEFORE
# zsh-autosuggestions (active) — stops the ghost suggestion being shoved right as you type
# over `vssh`/mosh. Lives here (not .zprofile) because vssh's `zsh -c` is non-login and only
# sources .zshenv → .minimal. Client-side only; harmless off-mosh.
export MOSH_PREDICTION_OVERWRITE=${MOSH_PREDICTION_OVERWRITE:-yes}

# SSH agent → 1Password (your real key store). The old gpg-agent SSH socket (formerly exported
# in .profile/.shell/.zprofile) was DEAD — a socket that doesn't exist + no enable-ssh-support —
# which is why et/git fell back to a password. Set 1P here in .zshenv so EVERY shell reaches it,
# including vj's non-login `zsh -c` et window (only .zshenv is sourced there). Path = 1Password's
# universal id (no secret). Single source of truth: the .profile/.shell/.zprofile copies were removed.
#
# GUARD `-n $SSH_CONNECTION`, NOT `-S $SSH_AUTH_SOCK`: macOS pre-sets SSH_AUTH_SOCK to its own
# launchd agent — a socket that is VALID (`-S` true) but EMPTY (`ssh-add -l` = no identities). So an
# `-S` guard ALWAYS passed, the 1P export never ran, and github SSH signed against the empty agent →
# every push failed. Gate on the SESSION instead: a LOCAL shell has no $SSH_CONNECTION → force the 1P
# socket; an INBOUND `ssh -A` session has it SET → keep the forwarded agent, so a headless box signs
# with YOUR laptop's 1P and Touch-ID pops where you are. ($SSH_CONNECTION beats $SSH_TTY — it's set
# even for a non-interactive `ssh -A host 'git push'`, which has no pty.)
#
# GOTCHA: the 1P socket is served by the 1Password DESKTOP APP. If the app isn't running the socket
# FILE lingers but nothing answers → ssh/git fall back to a PASSWORD with no Touch-ID. Keep the app
# alive: 1Password ▸ Settings ▸ General ▸ "Keep 1Password in the menu bar" + "Start at login" ON.
# Diagnose: `SSH_AUTH_SOCK=<1p sock> ssh-add -l` → key list = agent alive; "refused" = app not running.
[[ -n "$SSH_CONNECTION" ]] || export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# GPG for git commits in AI tools. Guard on a real terminal: a non-interactive shell (`bash -c`,
# now that it sources this via BASH_ENV) has no tty, and a bare `$(tty)` would set the literal
# string "not a tty". gpg only needs GPG_TTY when it can actually prompt — i.e. when there's a tty.
tty -s && export GPG_TTY=$(tty)

# Signal to other files that we're in sandbox mode
[ -n "$CODEX_SANDBOX" ] && export AI_SANDBOX_ONLY=1

# scale: per-machine truth (NODE heap etc.) — reaches agents/sandbox via this file
[ -f "$HOME/.ai/scale" ] && . "$HOME/.ai/scale"
