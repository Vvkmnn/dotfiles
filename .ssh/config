
# github: prefer the FORWARDED agent when one is present (SSH_AUTH_SOCK), so a
# headless machine reached via `ssh -A` signs with the operator's 1Password —
# approval happens on the machine you're physically at. Specific host beats Host *.
Host github.com
  IdentityAgent SSH_AUTH_SOCK

# 1Password SSH agent — the only key store; no private keys on disk or in this repo.
# Enable once per machine: 1Password → Settings → Developer → "Use the SSH agent".
Host *
  IdentityAgent ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
