
# Phase 0 (vMiniM4 headless): github signs via the FORWARDED agent when reached over
# `ssh -A` from a GUI Mac (Air) — honors SSH_AUTH_SOCK so the mini borrows that machine's
# unlocked 1Password + Touch-ID. The mini has no Touch-ID so its own 1Password can't sign
# headless; forwarding keeps you in the loop. Specific host wins over `Host *` below.
Host github.com
  IdentityAgent SSH_AUTH_SOCK

# 1Password SSH agent — serves the GitHub key (1password_25519) + inter-Mac keys.
# Enable once per machine: 1Password → Settings → Developer → "Use the SSH agent". (AI.md P15)
Host *
  IdentityAgent ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
