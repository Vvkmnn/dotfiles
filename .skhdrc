## Window Manager 
# toggle window zoom
# ctrl + cmd - d : yabai -m window --toggle zoom-parent
# ctrl + cmd - f : yabai -m window --toggle zoom-fullscreen

# ctrl + shift - d : yabai -m window --toggle zoom-parent
# ctrl + shift - f : yabai -m window --toggle zoom-fullscreen

cmd + ctrl - f: yabai -m window --toggle zoom-fullscreen
# fn - f : yabai -m window --toggle zoom-fullscreen

# alt + ctrl - return : yabai -m window --toggle zoom-parent
# alt - return : yabai -m window --toggle zoom-fullscreen

# space - f : yabai -m window --toggle zoom-fullscreen
#d asd d dd d dddddasdddddddijadofihasdoifhasdio df
# cmd + space - f : yabai -m window --toggle zoom-fullscreen       d

# move window to display and follow focus 
fn - j : yabai -m window --display west; yabai -m display --focus west
fn - k : yabai -m window --display east; yabai -m display --focus east

# alt + ctrl - j : yabai -m window --display west; yabai -m display --focus west
# alt + ctrl - k : yabai -m window --display east; yabai -m display --focus east

