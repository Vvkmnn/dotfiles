      {
        // Remove stray italics from keywords and type tokens.
        "scope": [
          "keyword",
          "storage",
          "variable.language",
          "variable.parameter",
          "entity.name.type",
          "support.type"
        ],
        "settings": {
          "fontStyle": ""
        }
      }
    ]
  },


  // === Editor: Layout & Behavior ===
  // Prefer spaces by default like Windsurf.
  "editor.insertSpaces": true,
