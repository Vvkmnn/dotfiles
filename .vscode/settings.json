  // === Editor: IntelliSense & Input ===
  // Adopt Windsurf’s suggestion model of accepting with Enter.
  "editor.acceptSuggestionOnEnter": "on",
  // Keep the first IntelliSense entry selected by default.
  "editor.suggestSelection": "first",
