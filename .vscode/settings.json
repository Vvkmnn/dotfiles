  // Collapse the horizontal scrollbar to a single pixel track.
  "editor.scrollbar.horizontalScrollbarSize": 1,
  // Collapse the vertical scrollbar to a single pixel track.
  "editor.scrollbar.verticalScrollbarSize": 1,
  // Allow PageUp/PageDown to move by full pages like Windsurf.
  "editor.scrollbar.scrollByPage": true,
