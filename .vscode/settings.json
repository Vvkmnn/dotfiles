// vCode
// Visual Studio Code settings as of 20/11/25
// Backup in ~/.vscode/settings.bak
{


  // === Workbench and Appearance ===
  // Match Windsurf’s Kanagawa flavour while retaining your product icons.
  "workbench.colorTheme": "Kanagawa Wave",
  // Swap to Material Icons to mirror the Aura reference while keeping Kanagawa colours.
  // "workbench.iconTheme": "material-icon-theme",
  // Prior Chalice icon set left in place for quick rollback.
  "workbench.iconTheme": "chalice-icon-theme",
  // Collapse the Material icon chevrons for cleaner trees.
  // "material-icon-theme.hidesExplorerArrows": true,
  // Earlier Chalice-specific arrow toggle now redundant.
  "chaliceIcons.showArrows": false,
  // Flatten transitions on macOS Tahoe to keep the UI snappy.
  "workbench.reduceMotion": "on",
  // Disable every VS Code telemetry surface for a quiet editor.
  "telemetry.telemetryLevel": "off",
  "telemetry.enableTelemetry": false,
  "telemetry.enableCrashReporter": false,
  // block extension telemetry pipelines as well.
  "github.copilot.telemetry.enable": false,
  "gitlens.telemetry.enabled": false,
  "redhat.telemetry.enabled": false,
  // Keep the playful product icons you already favour.
  // "workbench.productIconTheme": "bongocat",
  // Reproduce Windsurf’s custom colour accents across the workbench.
  "workbench.colorCustomizations": {
    // Highlight the current line with Kanagawa’s warm cursor orange.
    "editor.lineHighlightBackground": "#FFA0661A",
    // Prior Windsurf shading used a neutral slate.
    // "editor.lineHighlightBackground": "#282834",
    // Hide terminal borders for a cleaner shell panel.
    "terminal.border": "#00000000",
    // Hide panel borders to keep panes flush.
    "panel.border": "#00000000",
    // Remove the sidebar border for Windsurf’s seamless layout.
    "sideBar.border": "#00000000",
    // Drop editor group dividers for continuous panes.
    "editorGroup.border": "#00000000",
    // Use Kanagawa blue to mark the active tab.
    "tab.activeBorderTop": "#7E9CD8",
    // Active tab background sourced from Windsurf palette.
    "tab.activeBackground": "#1F1F28",
    // Dim inactive tabs to the Windsurf tone.
    "tab.inactiveBackground": "#16161D",
    // Primary editor background lifted directly from Windsurf.
    "editor.background": "#1F1F28",
    // Sidebar/panel: restored opaque fill; leave activity bar transparent.
    "sideBar.background": "#16161D",
    // Glass sidebar option (transparent) for future use.
    // "sideBar.background": "#00000000",
    // Transparent activity bar (icons only feel).
    "activityBar.background": "#00000000",
    // Ensure activity bar icons stay visible.
    "activityBar.foreground": "#DCD7BA",
    "activityBar.inactiveForeground": "#DCD7BA",
    // Previous solid activity bar background for quick rollback.
    // "activityBar.background": "#16161D",
    // Carry over the Windsurf status bar shade.
    "statusBar.background": "#16161D",
    // Panel fill restored.
    "panel.background": "#16161D",
    // Glass panel option (transparent) for future use.
    // "panel.background": "#00000000",
    // Keep the block cursor legible against Kanagawa’s dark base.
    "editorCursor.background": "#000000",
    // Match the cursor outline/fill to the active line number orange globally.
    "editorCursor.foreground": "#FFA066",
    // Suppress overview ruler noise to match the Aura reference calmness.
    "editorOverviewRuler.wordHighlightStrongForeground": "#00000000",
    "editorOverviewRuler.selectionHighlightForeground": "#00000000",
    "editorOverviewRuler.rangeHighlightForeground": "#00000000",
    "editorOverviewRuler.wordHighlightForeground": "#00000000",
    "editorOverviewRuler.bracketMatchForeground": "#00000000",
    "editorOverviewRuler.findMatchForeground": "#00000000",
    "editorOverviewRuler.modifiedForeground": "#00000000",
    "editorOverviewRuler.deletedForeground": "#00000000",
    "editorOverviewRuler.warningForeground": "#00000000",
    "editorOverviewRuler.addedForeground": "#00000000",
    "editorOverviewRuler.errorForeground": "#00000000",
    "editorOverviewRuler.infoForeground": "#00000000",
    "editorOverviewRuler.border": "#00000000",
    // Theme-specific tweaks mapped onto the Kanagawa palette.
    "[Kanagawa Wave]": {
      // Keep the suggest widget on-brand with Kanagawa’s deep background.
      "editorSuggestWidget.background": "#1F1F28",
      // Outline suggestions with the familiar accent blue.
      "editorSuggestWidget.border": "#7E9CD8",
      // Highlight the active suggestion using the mid-tone panel shade.
      "editorSuggestWidget.selectedBackground": "#2A2A37",
      // Use the same muted hover fill across lists.
      "list.hoverBackground": "#2A2A37",
      "list.activeSelectionBackground": "#2A2A37",
      "list.inactiveSelectionBackground": "#2A2A37",
      // Keep text legible with Kanagawa’s warm foreground.
      "list.hoverForeground": "#DCD7BA",
      "list.activeSelectionForeground": "#DCD7BA",
      "list.inactiveSelectionForeground": "#DCD7BA",
      // Stick with Kanagawa’s sidebar tone.
      "sideBar.background": "#16161D",
      // Boost selection contrast with the navy accent.
      "editor.selectionBackground": "#2D4F6780",
      // Recolour indent guides using Kanagawa blues.
      "editorIndentGuide.activeBackground1": "#7E9CD866",
      "editorIndentGuide.background1": "#45475A66",
      // Match the cursor colour to the active line number orange.
      "editorCursor.foreground": "#FFA066",
      // Earlier accent kept the cursor in Kanagawa blue.
      // "editorCursor.foreground": "#7E9CD8",
      // Keep sidebar border deep, but let the activity bar visually merge into the background.
      "sideBar.border": "#16161D",
      "activityBar.background": "#00000000",
      "activityBar.border": "#00000000",
      // Previous Kanagawa activity bar colours for quick rollback.
      // "activityBar.background": "#16161D",
      // "activityBar.border": "#16161D"
    },
    // React Theme fallback palette lifted from your reference snippet.
    "[React Theme]": {
      "editorSuggestWidget.background": "#282C34",
      "editorSuggestWidget.border": "#68f5ff",
      "editorSuggestWidget.selectedBackground": "#282C34",
      "list.hoverBackground": "#282C34",
      "list.hoverForeground": "#119dcc",
      "list.activeSelectionBackground": "#282C34",
      "list.activeSelectionForeground": "#119dcc",
      "list.inactiveSelectionBackground": "#282C34",
      "list.inactiveSelectionForeground": "#119dcc",
      "sideBar.background": "#282C34",
      "editor.selectionBackground": "#0c59607f",
      "editorIndentGuide.activeBackground1": "#00c3ff",
      "editorIndentGuide.background1": "#0968858b",
      "editorCursor.foreground": "#00c3ff"
    }
  },




  // === Window and Frame ===
  // "window.customTitleBarVisibility": "auto",
  "window.titleBarStyle": "native",


  // === Custom CSS ===

  // Keep the frameless window layout while hiding the macOS traffic lights.
  "custom-ui-style.electron": {
    // Preserve the hidden inset frame so VS Code keeps the Aura profile.
    "titleBarStyle": "hiddenInset",
    "frame": false,

    // Enable window transparency so the activity bar hole can show wallpaper; other parts stay opaque via CSS.
    "transparent": true,
    // Transparent window background; opacity is controlled below (everything but the activity bar remains filled).
    "backgroundColor": "#00000000"
    // Original traffic light offset retained for reference.
    // "trafficLightPosition": {
    //   "x": 20,
    //   "y": 16
    // }
  },


  // === Custom UI stylesheet (toggle on by uncommenting the block below) ===
  "custom-ui-style.stylesheet": {
    // Remove title container and traffic lights for open/close.
    ".container > .title": {
      "display": "none !important;"
    },
    // --- Workbench chrome ---
    // Base shell transparent so wallpaper can show wherever parts don't paint.
    ".monaco-workbench": "background-color: transparent !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important",
    // Default solid fill for all parts; activity bar overrides below to stay transparent.
    ".monaco-workbench .part": "background-color: #1F1F28 !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important",
    // Editor surface and margins.
    ".monaco-workbench .part.editor, .monaco-workbench .part.editor > .content, .monaco-workbench .part.editor .editor-group-container, .monaco-editor, .monaco-editor-background, .monaco-editor .margin": "background-color: #1F1F28 !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important",
    // Panels, terminals, and tab headers.
    ".monaco-workbench .part.panel, .monaco-workbench .part.panel .pane-body, .integrated-terminal, .integrated-terminal .xterm, .monaco-workbench .part.editor .title, .monaco-workbench .part.editor .title .tabs-container": "background-color: #1F1F28 !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important",
    // Sidebar and auxiliary bar.
    ".monaco-workbench .part.sidebar, .monaco-workbench .part.auxiliarybar": "background-color: #1F1F28 !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important",

    // --- Glass alternatives (commented) ---
    // ".monaco-workbench": "background-color: rgba(22, 22, 29, 0.12) !important; backdrop-filter: blur(20px) saturate(135%) !important; -webkit-backdrop-filter: blur(20px) saturate(135%) !important",
    // ".monaco-workbench .part": "background-color: rgba(22, 22, 29, 0.12) !important; backdrop-filter: blur(20px) saturate(135%) !important; -webkit-backdrop-filter: blur(20px) saturate(135%) !important",
    // ".monaco-workbench .part.editor, .monaco-workbench .part.editor > .content, .monaco-workbench .part.editor .editor-group-container, .monaco-editor, .monaco-editor-background, .monaco-editor .margin": "background-color: rgba(26, 26, 34, 0.12) !important; backdrop-filter: blur(18px) saturate(130%) !important; -webkit-backdrop-filter: blur(18px) saturate(130%) !important",
    // ".monaco-workbench .part.panel, .monaco-workbench .part.panel .pane-body, .integrated-terminal, .integrated-terminal .xterm, .monaco-workbench .part.editor .title, .monaco-workbench .part.editor .title .tabs-container": "background-color: rgba(22, 22, 29, 0.12) !important; backdrop-filter: blur(18px) saturate(130%) !important; -webkit-backdrop-filter: blur(18px) saturate(130%) !important",
    // ".monaco-workbench .part.sidebar, .monaco-workbench .part.auxiliarybar": "background-color: rgba(18, 18, 24, 0.12) !important; backdrop-filter: blur(18px) saturate(130%) !important; -webkit-backdrop-filter: blur(18px) saturate(130%) !important",
    // Remove drop shadows from notifications.
    ".notification-toast": "box-shadow: none !important",
    // Clean up the quick input shadow.
    ".quick-input-widget.show-file-icons": "box-shadow: none !important",
    // Lift the quick input nearer to mid-screen.
    ".quick-input-widget": "top: 25vh !important",
    // Hide quick input scrollbars.
    ".quick-input-list .scrollbar": "display: none",
    // Hide inline quick input action buttons.
    ".monaco-action-bar.quick-input-inline-action-bar": "display: none",
    // Round and flatten the find widget.
    ".editor-widget.find-widget": "box-shadow: none; border-radius: 4px",
    // Match the Aura title bar accent.
    ".quick-input-titlebar": "background: #100B15 !important",
    // Remove the editor group bottom divider.
    ".monaco-workbench .part.editor > .content .editor-group-container > .title.title-border-bottom:after": "display: none",
    // Hide scroll shadows for flatter panels.
    ".monaco-scrollable-element > .shadow.top": "display: none",
    // Flatten the terminal decoration column while keeping the glyphs available.
    ".integrated-terminal .xterm-decoration-container": "width: 16px !important; min-width: 16px !important; background: transparent !important; border-left: none !important; box-shadow: none !important",
    // Remove any overflow padding so the column hugs the gutter.
    ".integrated-terminal .terminal-overflow-guard": "padding-right: 0 !important",
    // Pull the xterm surface flush with the terminal edge.
    ".integrated-terminal .xterm": "padding-right: 0 !important",
    // Let the command status icons float without button chrome.
    ".integrated-terminal .xterm-decoration-container .xterm-decoration": "background: transparent !important; box-shadow: none !important; border: none !important",
    // Collapse the terminal scrollbar to a one pixel track.
    ".integrated-terminal .xterm-viewport::-webkit-scrollbar": "width: 1px !important",
    // Keep the one pixel thumb visible enough to grab.
    ".integrated-terminal .xterm-viewport::-webkit-scrollbar-thumb": "background-color: #7E9CD8 !important; border-radius: 0 !important",
    // Remove residual styling from the scrollbar track.
    ".integrated-terminal .xterm-viewport::-webkit-scrollbar-track": "background: transparent !important",
    // Tighten sidebar titles.
    ".sidebar .title-label": "padding: 1 !important",
    // Remove focus outlines in lists unless focused.
    ".monaco-workbench .monaco-list:not(.element-focused):focus:before": "outline: none !important",
    // Trim focus outlines on rows.
    ".monaco-list-row.focused": "outline: none !important",
    // Hide editor scroll decorations.
    ".monaco-editor .scroll-decoration": "display: none",
    // Center file names in the tab title area.
    // ".title .monaco-icon-label.file-icon": "margin: 0 60px",
    // Reduce label padding to pull titles inward.
    ".title.show-file-icons .label-container .monaco-icon-label.file-icon": "justify-content: center; padding: 0 !important",
    // Reset the trailing icon margin.
    ".title .monaco-icon-label:after": "margin-right: 0",
    // Offset the editor title to clear the hidden traffic lights.
    ".monaco-workbench .part.editor > .content .editor-group-container > .title > .label-container > .title-label": "padding-left: 60px",
    // Hide the inline title action buttons.
    ".title-actions": "display: none !important",
    // Hide the macOS traffic light buttons and their container with a single rule.
    ".monaco-workbench.mac .window-appicon, .monaco-workbench.mac .titlebar .window-controls-container": "display: none !important",
    // Center titlebar?
    ".monaco-workbench.mac .titlebar .titlebar-left": "padding-left: 0 !important",
    // Center extension detail headers.
    ".monaco-workbench .extension-editor .header .title": "width: 100% !important; justify-content: center !important",
    ".monaco-workbench .extension-editor .header .name": "display: block !important; text-align: center !important",
    ".monaco-workbench .extension-editor .header .subtitle": "display: block !important; text-align: center !important",
    // Nudge the editor surface downward slightly so it clears the traffic-light area.
    ".monaco-workbench .part.editor > .content": "padding-top: 8px !important; box-sizing: border-box !important",
    // Remove the blurred quick-input scrim entirely.
    ".monaco-workbench .quick-input-widget:before": "display: none !important",
    // Recolour the caret to match Kanagawa’s line-number orange exactly.
    ".monaco-editor .cursors-layer .cursor": "background: #FFA066 !important; border-color: #FFA066 !important; background-image: none !important",
    // Keep the block cursor solid orange as well.
    ".monaco-editor .cursors-layer .cursor.block": "background: #FFA066 !important; border-color: #FFA066 !important; background-image: none !important",
    // Apply JetBrainsMono across the main workbench chrome (font-size override kept below for reference only).
    // ".monaco-workbench": "font-family: 'JetBrainsMono Nerd Font', monospace !important; font-size: 12px !important",
    // TODO: Test if these work, recent additions
    // ".monaco-workbench": "font-family: 'SFMono Nerd Font', monospace !important; --codex-zoom: 0.92",
    // ".monaco-workbench": "font-family: 'SF Pro' !important; --codex-zoom: 0.92",
    // Use zoom to shrink activity bar icons; keep the bar tight and let the wallpaper show through.
    // Activity bar: transparent + zoomed/narrow (only element intended to be see-through).
    ".monaco-workbench .part.activitybar": "zoom: 70% !important; width: 35px !important; background-color: transparent !important; box-shadow: none !important; border: none !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important",
    ".monaco-workbench .part.activitybar::before": "background-color: transparent !important; box-shadow: none !important; border: none !important",
    // Opaque activity bar rollback.
    // ".monaco-workbench .part.activitybar": "zoom: 70% !important; width: 24px !important; background-color: rgba(18, 18, 24, 0.12) !important; backdrop-filter: blur(28px) saturate(140%) !important; -webkit-backdrop-filter: blur(28px) saturate(140%) !important",
    // (Optional) nested background reset was here; left commented to avoid hiding extension icons.
    // ".monaco-workbench .part.activitybar *": "background-color: transparent !important; border: none !important; box-shadow: none !important",
    // Strip any residual background on the inner activity bar containers.
    ".monaco-workbench .activitybar": "background-color: transparent !important; box-shadow: none !important",
    ".monaco-workbench .activitybar > .content": "background-color: transparent !important; box-shadow: none !important",
    // Force activity bar icons always visible (full opacity); add subtle stroke/glow for contrast on bright wallpapers.
    ".monaco-workbench .activitybar .action-item": "opacity: 1 !important; filter: none !important; visibility: visible !important",
    ".monaco-workbench .activitybar .action-item:not(.checked)": "opacity: 1 !important; filter: none !important; visibility: visible !important",
    ".monaco-workbench .activitybar .action-item .action-label": "opacity: 1 !important; filter: none !important; color: #DCD7BA !important; visibility: visible !important",
    ".monaco-workbench .activitybar .action-item:not(.checked) .action-label": "opacity: 1 !important; filter: none !important; color: #DCD7BA !important; visibility: visible !important",
    ".monaco-workbench .activitybar .action-item .codicon": "color: #DCD7BA !important; opacity: 1 !important; filter: drop-shadow(0 0 2px rgba(0,0,0,0.35)) !important; text-shadow: 0 0 2px rgba(0,0,0,0.35) !important; visibility: visible !important; mix-blend-mode: normal !important",
    ".monaco-workbench .activitybar .action-item .codicon::before": "color: #DCD7BA !important; opacity: 1 !important; filter: drop-shadow(0 0 2px rgba(0,0,0,0.35)) !important; text-shadow: 0 0 2px rgba(0,0,0,0.35) !important; visibility: visible !important; mix-blend-mode: normal !important",
    ".monaco-workbench .activitybar .action-item img, .monaco-workbench .activitybar .action-item svg, .monaco-workbench .activitybar .action-item svg *": "opacity: 1 !important; filter: drop-shadow(0 0 2px rgba(0,0,0,0.35)) !important; color: #DCD7BA !important; fill: #DCD7BA !important; stroke: #DCD7BA !important; visibility: visible !important; mix-blend-mode: normal !important; background-color: transparent !important",
    // Prevent sidebar gutter from painting behind the transparent activity bar.
    ".monaco-workbench .activitybar + .content .sidebar": "background-color: #1F1F28 !important",
    // Activity bar actions: push icons to the outer edge.
    ".monaco-workbench .activitybar .monaco-action-bar": "width: 100% !important; justify-content: flex-end !important; margin-right: -2px !important",

    // Dedicated Codex section so the panel can be tuned without touching global editor settings.
    ".monaco-workbench .part.auxiliarybar": "min-width: 30vw !important; flex: 0 0 30vw !important",
    ".monaco-workbench .part.auxiliarybar .split-view-view": "min-width: 30vw !important",
    // ".monaco-workbench .part.auxiliarybar webview": "transform-origin: top left !important; transform: scale(var(--codex-zoom, 0.92)) !important; width: calc(100% / var(--codex-zoom, 0.92)) !important; height: calc(100% / var(--codex-zoom, 0.92)) !important",
