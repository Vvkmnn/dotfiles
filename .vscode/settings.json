    "comments": false,
    // Silence string suggestions for cleaner editing.
    "strings": false
  },
  // Enable inline completions so Codex behaves like Windsurf.
  "editor.inlineSuggest.enabled": true,
  // Always show the inline suggestion toolbar, mirroring Windsurf.
  "editor.inlineSuggest.showToolbar": "always",
  // Preview suggestion text inline so completions feel identical.
  "editor.suggest.preview": true,
  // Share suggestion picks between windows for consistency.
  "editor.suggest.shareSuggestSelections": true,
