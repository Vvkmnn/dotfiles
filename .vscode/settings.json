    // ".monaco-workbench .part.auxiliarybar, .monaco-workbench .part.auxiliarybar webview": "font-family: 'SF Pro Text', 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important",
    // Provide a positioning context so the account/settings buttons can be anchored independently.
