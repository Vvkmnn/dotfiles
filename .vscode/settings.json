    "**/node_modules/*/**": true,
    // Ignore Mercurial storage.
    "**/.hg/store/**": true,
    // Skip temp directories.
    "**/tmp/**": true,
    // Ignore build outputs.
    "**/build/**": true,
    // Ignore dist outputs.
    "**/dist/**": true,
    // Skip Yarn global cache.
    "**/.yarn/cache/**": true,
    // Skip webpack intermediates.
    "**/.webpack/**": true,
    // Ignore Next.js builds.
    "**/.next/**": true,
    // Ignore coverage folders.
    "**/coverage/**": true,
    // Ignore Turborepo cache.
