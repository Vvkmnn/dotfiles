  // Make inline AI suggestions audible for screen readers like Windsurf.
  "editor.screenReaderAnnounceInlineSuggestion": true,
  // Respect system accessibility settings automatically.
  "editor.accessibilitySupport": "auto",
  // Preserve Windsurf’s search exclusions to tighten quick searches.
  "search.exclude": {
    // Skip node_modules just like Windsurf.
    "**/node_modules": true,
    // Skip Bower components.
    "**/bower_components": true,
    // Omit dist output.
    "**/dist": true,
    // Omit build artefacts.
    "**/build": true,
    // Hide git directories.
    "**/.git": true,
    // Skip Mercurial stores.
    "**/.hg": true,
    // Skip Subversion metadata.
    "**/.svn": true,
    // Ignore CVS directories.
    "**/CVS": true,
    // Drop Finder cruft.
    "**/.DS_Store": true,
    // Ignore tmp folders.
    "**/tmp": true,
    // Skip coverage outputs.
    "**/coverage": true,
    // Keep transient build caches out of quick open.
    "**/.svelte-kit": true,
    "**/.nuxt": true,
    "**/.parcel-cache": true,
    "**/.expo": true,
    "**/.pnpm-store": true,
    "**/.gradle": true,
    "**/.idea": true,
    "**/.pytest_cache": true,
    "**/.venv": true
