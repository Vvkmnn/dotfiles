if [ -n "$CODEX_SANDBOX" ]; then
	[ -r "$HOME/.ai" ] && . "$HOME/.ai"
else
	# Path
	[ -f "$HOME/.profile" ] && . "$HOME/.profile"

	# Functions
	[ -f "$HOME/.functions" ] && . "$HOME/.functions"

	# Aliases
	[ -f "$HOME/.alias" ] && . "$HOME/.alias"

	# Shell
	[ -f "$HOME/.shell" ] && . "$HOME/.shell"

