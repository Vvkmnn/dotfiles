#!/bin/bash
# Modern minimal sketchybar configuration - Optimized for MacBook Air 2024 (M3)

# Clean up old cache and averaging files on startup
rm -f /tmp/sketchybar* /tmp/macmon* 2>/dev/null

# Clean up stale state files older than 1 hour periodically
find /tmp -name "sketchybar*" -mmin +60 -delete 2>/dev/null &

# --- Environment Variables --- #
export PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# --- Modern Color Palette --- #
export WHITE=0xffFFFFFF
export LIGHT_GRAY=0xffE0E0E0
export SILVER=0xffB0B7C0 # Silver accent
export MID_GRAY=0xffA0A0A0
export DIM_GRAY=0xff606060
export ORANGE=0xffFFA500 # Orange for warnings
export BLACK=0xff000000
export TRANSPARENT=0x00000000
export MISTY_BLUE=0xffB0B7C0 # Misty Blue accent

# --- Bar Configuration --- #
sketchybar --bar height=32 \
	color=$BLACK \
	padding_left=8 \
	padding_right=20 \
	y_offset=0 \
	font_smoothing=on \
	blur_radius=0 \
	position=top \
	sticky=on \
	margin=0 \
	topmost=off \
	notch_width=200 \
	display=main

# --- Defaults --- #
sketchybar --default icon.font="SF Pro:Medium:13.0" \
	icon.color=$MID_GRAY \
	icon.padding_left=2 \
	icon.padding_right=2 \
	icon.y_offset=0 \
	label.font="SF Pro:Regular:13.0" \
	label.color=$MID_GRAY \
	label.padding_left=2 \
	label.padding_right=2 \
	label.y_offset=0 \
	background.drawing=off \
	padding_left=2 \
	padding_right=2 \
	y_offset=0

# --- LEFT SIDE ITEMS --- #

# Logo
sketchybar --add item logo left \
	--set logo background.image="/Users/v/Documents/logo/vLogoWhite_inverted.jpg" \
	background.image.scale=0.048 \
	background.color=$TRANSPARENT \
	background.height=22 \
	background.drawing=on \
	label.drawing=off \
	icon.drawing=off \
	padding_left=8 \
	padding_right=10 \
	y_offset=0

# Front App
sketchybar --add item front_app left \
	--set front_app script="$PLUGIN_DIR/front_app.sh" \
	icon.drawing=off \
	label.font="SF Pro:Medium:13.0" \
	label.color=$WHITE \
	label.max_chars=25 \
	padding_right=10 \
	--subscribe front_app front_app_switched

# Spaces
SPACE_ICONS=("1" "2" "3" "4" "5" "6" "7")
for i in "${!SPACE_ICONS[@]}"; do
	sid=$(($i + 1))
	sketchybar --add space space.$sid left \
		--set space.$sid space=$sid \
		icon=${SPACE_ICONS[i]} \
		icon.font="SF Pro:Medium:13.0" \
		width=28 \
		padding_left=0 \
		padding_right=0 \
		script="$PLUGIN_DIR/space.sh" \
		click_script="/opt/homebrew/bin/yabai -m space --focus $sid" \
		--subscribe space.$sid space_change windows_on_spaces
done

# IP Address
sketchybar --add item ip left \
	--set ip script="$PLUGIN_DIR/ip.sh" \
	update_freq=1 \
	icon="􀤆" \
	icon.font="SF Symbols:Regular:13.0" \
	icon.color=$SILVER \
	label.font="SF Pro:Regular:13.0" \
	padding_right=6 \
	--subscribe ip wifi_change

# Network Stats - text with sparkline graphs
sketchybar --add item network_down left \
	--set network_down update_freq=3 \
	icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label.color=$SILVER \
	padding_left=3 \
	padding_right=4 \
	script="$PLUGIN_DIR/network_stats.sh down"

sketchybar --add item network_up left \
	--set network_up update_freq=3 \
	icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label.color=$SILVER \
	padding_left=0 \
	padding_right=2 \
	script="$PLUGIN_DIR/network_stats.sh up"

