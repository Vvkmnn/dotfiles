#!/bin/bash
# Modern minimal sketchybar configuration - Optimized

# --- Environment Variables --- #
export PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# --- Modern Color Palette --- #
export WHITE=0xffFFFFFF
export LIGHT_GRAY=0xffE0E0E0
export MID_GRAY=0xffA0A0A0
export DIM_GRAY=0xff606060
export BLACK=0xff000000
export TRANSPARENT=0x00000000
export YELLOW=0xffDDB670 # Kanagawa yellow

# --- Bar Configuration --- #
sketchybar --bar height=32 \
	color=$BLACK \
	padding_left=8 \
	padding_right=8 \
	y_offset=0 \
	font_smoothing=on \
	blur_radius=0 \
	position=top \
	sticky=on \
	margin=0 \
	topmost=off \
	notch_width=200 \
	display=main

# --- Defaults --- #
sketchybar --default icon.font="SF Pro:Medium:13.0" \
	icon.color=$MID_GRAY \
	icon.padding_left=2 \
	icon.padding_right=2 \
	icon.y_offset=0 \
	label.font="SF Pro:Regular:13.0" \
	label.color=$MID_GRAY \
	label.padding_left=2 \
	label.padding_right=2 \
	label.y_offset=0 \
	background.drawing=off \
	padding_left=2 \
	padding_right=2 \
	y_offset=0

# --- LEFT SIDE ITEMS --- #

# Logo
sketchybar --add item logo left \
	--set logo background.image="/Users/v/Documents/logo/vLogoWhite_inverted.jpg" \
	background.image.scale=0.048 \
	background.color=$TRANSPARENT \
	background.height=22 \
	background.drawing=on \
	label.drawing=off \
	icon.drawing=off \
	padding_left=8 \
	padding_right=10 \
	y_offset=0

# Front App
sketchybar --add item front_app left \
	--set front_app script="$PLUGIN_DIR/front_app.sh" \
	icon.drawing=off \
	label.font="SF Pro:Medium:13.0" \
	label.color=$WHITE \
	label.max_chars=25 \
	padding_right=10 \
	--subscribe front_app front_app_switched

# Spaces
SPACE_ICONS=("1" "2" "3" "4" "5" "6" "7")
for i in "${!SPACE_ICONS[@]}"; do
	sid=$(($i + 1))
	sketchybar --add space space.$sid left \
		--set space.$sid space=$sid \
		icon=${SPACE_ICONS[i]} \
		icon.font="SF Pro:Medium:13.0" \
		width=28 \
		padding_left=0 \
		padding_right=0 \
		script="$PLUGIN_DIR/space.sh" \
		click_script="/opt/homebrew/bin/yabai -m space --focus $sid" \
		--subscribe space.$sid space_change windows_on_spaces
done

# IP Address
sketchybar --add item ip left \
	--set ip script="$PLUGIN_DIR/ip.sh" \
	update_freq=1 \
	icon="􀤆" \
	icon.font="SF Symbols:Regular:13.0" \
	icon.color=0xffFFFFFF \
	label.font="SF Pro:Regular:13.0" \
	padding_right=6 \
	--subscribe ip wifi_change

# Network Stats - Separate items for independent coloring
sketchybar --add item network_down left \
	--set network_down icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label="↓ 0" \
	label.color=0xffF8F0E0 \
	padding_left=0 \
	padding_right=2 \
	update_freq=2 \
	script="$PLUGIN_DIR/network_stats.sh"

sketchybar --add item network_up left \
	--set network_up icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label="↑ 0" \
	label.color=0xffF8F0E0 \
	padding_left=0 \
	padding_right=8

# --- CENTER ITEMS --- #

# Window Title - with extra padding to avoid notch
# sketchybar --add item window_title center \
#            --set window_title script="$PLUGIN_DIR/window_title.sh" \
#                              icon.drawing=off \
#                              label.font="SF Pro:Regular:13.0" \
#                              label.color=0xff808080 \
#                              label.max_chars=30 \
#                              padding_left=50 \
#                              padding_right=50 \
#                              --subscribe window_title window_focus front_app_switched

# --- RIGHT SIDE ITEMS (minimal spacing) --- #

# Clock - 9 elements with gradient from kanagawa yellow to white
# Order: year week month day dow hour :min :sec .ms

# Milliseconds (white) - rightmost
sketchybar --add item clock_ms right \
	--set clock_ms update_freq=10 \
	icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label.color=0xffFFFFFF \
	padding_left=0 \
	padding_right=6 \
	script="$PLUGIN_DIR/clock_ms.sh"

# Seconds with colon (very light)
sketchybar --add item clock_sec right \
	--set clock_sec update_freq=1 \
	icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label.color=0xffFFF8F0 \
	padding_left=0 \
	padding_right=0 \
	script="$PLUGIN_DIR/clock_sec.sh"

# Minutes with colon (light gradient)
sketchybar --add item clock_min right \
	--set clock_min update_freq=1 \
	icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label.color=0xffF8F0E0 \
	padding_left=0 \
	padding_right=0 \
	script="$PLUGIN_DIR/clock_min.sh"

# Hour (lighter gradient)
sketchybar --add item clock_hour right \
	--set clock_hour update_freq=60 \
	icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label.color=0xffF0E8D0 \
	padding_left=0 \
	padding_right=3 \
	script="$PLUGIN_DIR/clock_hour.sh"

# Day of week (middle gradient)
sketchybar --add item clock_dow right \
	--set clock_dow update_freq=60 \
	icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label.color=0xffE8E0C0 \
	padding_left=0 \
	padding_right=3 \
	script="$PLUGIN_DIR/clock_dow.sh"

# Day (darker gradient)
sketchybar --add item clock_day right \
	--set clock_day update_freq=60 \
	icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label.color=0xffE0D8B0 \
	padding_left=0 \
	padding_right=3 \
	script="$PLUGIN_DIR/clock_day.sh"

# Month (darker gradient)
sketchybar --add item clock_month right \
	--set clock_month update_freq=60 \
	icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label.color=0xffE0D0A0 \
	padding_left=0 \
	padding_right=3 \
	script="$PLUGIN_DIR/clock_month.sh"

# Week (darker gradient)
sketchybar --add item clock_week right \
	--set clock_week update_freq=60 \
	icon.drawing=off \
	label.font="SF Pro:Regular:13.0" \
	label.color=0xffDDC890 \
	padding_left=0 \
	padding_right=3 \
	script="$PLUGIN_DIR/clock_week.sh"

# Year with analog clock icon (kanagawa yellow) - leftmost  
sketchybar --add item clock_year right \
	--set clock_year update_freq=30 \
	icon.drawing=on \
	icon="􀐬" \
	icon.font="SF Symbols:Regular:13.0" \
	icon.color=$MID_GRAY \
	icon.padding_right=1 \
	label.font="SF Pro:Regular:13.0" \
	label.color=$YELLOW \
	padding_left=2 \
	padding_right=3 \
	script="$PLUGIN_DIR/clock_year.sh"

# Battery
sketchybar --add item battery right \
	--set battery script="$PLUGIN_DIR/battery.sh" \
	update_freq=120 \
	icon.font="SF Pro:Regular:13.0" \
	label.font="SF Pro:Regular:13.0" \
	padding_right=6 \
	--subscribe battery system_woke power_source_change

# Disk
sketchybar --add item disk right \
	--set disk label.font="SF Pro:Regular:13.0" \
	icon="􀨪" \
	icon.font="SF Symbols:Regular:13.0" \
	padding_right=3 \
	update_freq=60 \
	script="$PLUGIN_DIR/disk.sh"

# Memory
sketchybar --add item memory right \
	--set memory label.font="SF Pro:Regular:13.0" \
	icon="􀫦" \
	icon.font="SF Symbols:Regular:13.0" \
	padding_right=3 \
	update_freq=5 \
	script="$PLUGIN_DIR/memory.sh"

# CPU
sketchybar --add item cpu right \
	--set cpu label.font="SF Pro:Regular:13.0" \
	icon="􀫥" \
	icon.font="SF Symbols:Regular:13.0" \
	padding_right=3 \
	update_freq=1 \
	script="$PLUGIN_DIR/cpu.sh"

# Temperature
sketchybar --add item temp right \
	--set temp label.font="SF Pro:Regular:13.0" \
	icon="􀇬" \
	icon.font="SF Symbols:Regular:13.0" \
	padding_right=3 \
	update_freq=5 \
	script="$PLUGIN_DIR/temp.sh"

# Menu Anywhere - First on right side before CPU
sketchybar --add item menuanywhere right \
	--set menuanywhere icon="􀍟" \
	icon.font="SF Symbols:Regular:13.0" \
	label="⌥M" \
	label.font="SF Pro:Light:12.0" \
	padding_right=6 \
	icon.color=$MID_GRAY \
	label.color=$MID_GRAY \
	click_script="$PLUGIN_DIR/launch_menuanywhere.sh"click_script="$PLUGIN_DIR/launch_menuanywhere.sh"

# Force update
sketchybar --update

echo "Sketchybar loaded - optimized configuration"
