#!/usr/bin/env sh

# Clock display - with visual distinction for week/dow
YEAR=$(date '+%Y')
MONTH=$(printf "%02d" $(date '+%-m'))
DAY=$(printf "%02d" $(date '+%-d'))
WEEK=$(date '+%V')
DOW=$(date '+%u')
TIME=$(date '+%H:%M:%S')
MILLIS=$(perl -MTime::HiRes=time -e 'printf "%.3f", time' | cut -d. -f2)
SECONDS=$(date '+%S')

# Create display with visual markers to show dimmed parts
# Using brackets to visually separate the dimmed week/dow
DISPLAY="$YEAR $MONTH $DAY [$WEEK $DOW] $TIME.$MILLIS"

# Flash Kanagawa color for 1 second at the start of each minute
if [ "$SECONDS" = "00" ]; then
    COLOR=0xffDDB670  # Kanagawa off-white flash
else
    COLOR=0xffFFFFFF  # White normally
fi

sketchybar --set clock label="$DISPLAY" \
                      label.color=$COLOR
