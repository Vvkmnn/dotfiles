# v.ghostty

# ============================================================================
# THEMES & COLORS
# ============================================================================

# Dark theme with vibrant colors
# theme = catppuccin-mocha

# Unified theme configuration - Kanagawa Wave for consistency
theme = Kanagawa Wave

# Force readable text on colored backgrounds (Claude Code diff blocks were
# dark-on-dark-red/green with Kanagawa's muted ANSI palette). Range 1.0-21.0.
# Ratio 3 forces legible glyphs on the diff green/red and lifts dim gray UI text;
# drop to 2 if it looks washed out, raise toward 4 if diffs are still hard to read.
minimum-contrast = 3

# Beautiful rose-pine theme switching
# theme = light:rose-pine-dawn,dark:rose-pine

# Custom background color (hex or X11 color name)
# background = #1e1e2e

# Custom foreground color (hex or X11 color name)
# foreground = #cdd6f4

# Custom color palette (0-255 indexed colors)
# palette = 0=#45475a
# palette = 1=#f38ba8

# Background transparency (0.0-1.0)
# background-opacity = 0.97

# Background blur - reduced for better performance
# background-blur-radius = 40

# Color space for rendering — display-p3 unlocks wide gamut on Apple Silicon P3 displays
window-colorspace = display-p3

# Alpha blending mode
# alpha-blending = true

# ============================================================================
# FONTS & TEXT
# ============================================================================

# Font family with fallbacks
# font-family = "Hack Nerd Font", "JetBrains Mono"
font-family = "SFMono Nerd Font"

# Your original font choice
# font-family = "TX-02"

# Additional font families for fallback
# font-family = "SF Mono"
# font-family = "Menlo"

# Font families for specific styles
# font-family-bold = 
# font-family-italic = 
# font-family-bold-italic = 

# Font size in points
font-size = 12.3

# Font style preferences
# font-style = default
# font-style-bold = default
# font-style-italic = default
# font-style-bold-italic = default

# Synthetic font styles (bold, italic, bold-italic)
# font-synthetic-style = true

# Font thickness (macOS only)
font-thicken = true

# Font thickness strength (integer 0-255, minimal visible effect on macOS CoreText/Retina)
# font-thicken-strength = 50

# Font feature settings (OpenType features)
font-feature = liga=0
font-feature = calt=0

# Font variation settings
# font-variation = wght=400

# Font codepoint mapping for specific characters
# font-codepoint-map = U+E0B0=SF Mono

# Adjust cell dimensions
adjust-cell-height = 1
# adjust-cell-width = 0%

# Fine-tune font positioning
# adjust-font-baseline = 0
# adjust-cursor-height = 0
# adjust-cursor-thickness = 0

# Line decoration adjustments
# adjust-underline-position = 0
# adjust-underline-thickness = 0
# adjust-strikethrough-position = 0
# adjust-strikethrough-thickness = 0
# adjust-overline-position = 0
# adjust-overline-thickness = 0

# Box drawing thickness
# adjust-box-thickness = 0

# ============================================================================
# CURSOR
# ============================================================================

# Cursor style (block, bar, underline, block_hollow)
cursor-style = block_hollow

# Cursor blinking
cursor-style-blink = true

# Cursor color
# cursor-color = #f5e0dc

# Text color under cursor
# cursor-text = #1e1e2e

# Cursor opacity (0.0-1.0)
# cursor-opacity = 1.0

# Invert foreground/background colors under cursor
# cursor-invert-fg-bg = false

# Click to move cursor in prompt (requires shell integration)
cursor-click-to-move = true

# ============================================================================
# WINDOW & DISPLAY
# ============================================================================

# Window decorations
window-decoration = auto

# Window title
# title = "Ghostty"

# Window subtitle
# window-subtitle = ""

# Window title font
# window-title-font-family = "System Font"

# Window titlebar colors
# window-titlebar-background = #1e1e2e
# window-titlebar-foreground = #cdd6f4

# Window dimensions
# window-width = 80
# window-height = 24

# Window position
# window-position-x = center
# window-position-y = center

# Window padding
window-padding-x = 7
window-padding-y = 7

# Asymmetric padding (matches your WezTerm's left=15)
# window-padding-x = 15

# Padding color behavior
window-padding-color = extend

# Balance padding when resizing
window-padding-balance = true

# Start maximized
# maximize = false

# Start fullscreen
# fullscreen = false

# Save window state between sessions
window-save-state = always

# Inherit font size from previous window
window-inherit-font-size = true

# Inherit working directory from previous window
window-inherit-working-directory = true

# Step resize (resize by character cells)
# window-step-resize = false

# VSync for maximum smoothness and performance
window-vsync = true

# Window theme (light, dark, auto)
# window-theme = auto

# New tab position (after, before, end)
# window-new-tab-position = after

# ============================================================================
# MACOS SPECIFIC
# ============================================================================

# Titlebar style (native, transparent, tabs, hidden)
macos-titlebar-style = hidden

# Show tabs in titlebar for better organization
# macos-titlebar-style = tabs

# Non-native fullscreen behavior
macos-non-native-fullscreen = visible-menu

# Option key behavior
macos-option-as-alt = true

# Custom app icon (official, blueprint, chalkboard, microchip, glass, holographic, paper, retro, xray, custom-style)
macos-icon = glass
# macos-icon = xray

# Icon frame color
# macos-icon-frame = #000000

# Icon ghost color
# macos-icon-ghost-color = #ffffff

# Icon screen color
# macos-icon-screen-color = #000000

# Auto secure input detection
macos-auto-secure-input = true

# Secure input indication
macos-secure-input-indication = true

# Titlebar proxy icon
macos-titlebar-proxy-icon = visible

# Window shadow
# macos-window-shadow = true

# ============================================================================
# GTK/LINUX SPECIFIC
# ============================================================================

# GTK Adwaita theme
# gtk-adwaita = true

# GTK single instance
gtk-single-instance = false

# Tab bar location (top, bottom, left, right, hidden)
# gtk-tabs-location = top

# Hide tab bar completely
# gtk-tabs-location = hidden

# Wide tabs
# gtk-wide-tabs = true

# GTK titlebar
# gtk-titlebar = true

# Hide titlebar when maximized
# gtk-titlebar-hide-when-maximized = false

# Custom CSS
# gtk-custom-css = ""

# Adwaita toolbar style
# adw-toolbar-style = raised

# GSK renderer
# gtk-gsk-renderer = auto

# OpenGL debug
# gtk-opengl-debug = false

# ============================================================================
# BEHAVIOR & INTERACTION
# ============================================================================

# Shell to run
command = /bin/zsh -l

# Initial command to run
# initial-command = ""

# Working directory
# working-directory = ""

# Wait after command exit
# wait-after-command = false

# Shell integration
shell-integration = zsh

# Shell integration features — no-cursor preserves block_hollow, no-title since titlebar hidden
# ssh-terminfo + ssh-env: for `jc`/plain ssh (NOT vssh/mosh — mosh isn't the ssh wrapper),
# auto-install xterm-ghostty via tic on off-fleet hosts (falls back to xterm-256color) and
# forward COLORTERM/TERM_PROGRAM* so truecolor + program detection survive the hop. On-fleet
# every Mac already has the terminfo, so this is insurance for new/off-fleet boxes. (2026-07-08)
shell-integration-features = no-cursor,sudo,no-title,ssh-terminfo,ssh-env

# Notify when commands finish in unfocused windows (10s+ commands only)
notify-on-command-finish = unfocused

# Copy on select
copy-on-select = true

# Hide mouse while typing
mouse-hide-while-typing = true

# Mouse scroll multiplier - optimized for smooth terminal scrolling
mouse-scroll-multiplier = 1.0

# Mouse shift capture
# mouse-shift-capture = true

# Focus follows mouse
# focus-follows-mouse = false

# Click repeat interval
# click-repeat-interval = 500

# ============================================================================
# CLIPBOARD
# ============================================================================

# Clipboard read permissions (allow, deny, ask)
# clipboard-read = ask

# Clipboard write permissions (allow, deny, ask)
clipboard-write = allow

# Paste bracketed safe mode
# clipboard-paste-bracketed-safe = true

# Paste protection
clipboard-paste-protection = true

# Trim trailing spaces when copying
clipboard-trim-trailing-spaces = true

# ============================================================================
# SCROLLBACK & HISTORY
# ============================================================================

# Scrollback buffer size
scrollback-limit = 10000

# Hide scrollbar — tmux handles scrollback
scrollbar = never

# ============================================================================
# TERMINAL BEHAVIOR
# ============================================================================

# Terminal type - use xterm-ghostty for better compatibility
term = xterm-ghostty

# Bold is bright colors
bold-is-bright = true

# Grapheme width method
# grapheme-width-method = unicode

# OSC color report format
# osc-color-report-format = 8-bit

# Enquiry response
# enquiry-response = ""

# VT KAM allowed
# vt-kam-allowed = true

# Title reporting
# title-report = true

# Abnormal command exit runtime
# abnormal-command-exit-runtime = 2000

# ============================================================================
# NOTIFICATIONS
# ============================================================================

# Desktop notifications
desktop-notifications = true

# App notifications
app-notifications = true

# ============================================================================
# RESIZE & OVERLAY
# ============================================================================

# Resize overlay (always, never, after-first)
resize-overlay = after-first

# Resize overlay - faster for better responsiveness
resize-overlay-duration = 200ms

# Resize overlay position
# resize-overlay-position = center

# ============================================================================
# SELECTION
# ============================================================================

# Selection background color
# selection-background = #3c4142

# Selection foreground color
# selection-foreground = #ffffff

# Invert selection colors
# selection-invert-fg-bg = false

# ============================================================================
# SPLITS
# ============================================================================

# Split divider color
# split-divider-color = #6c7086

# Unfocused split opacity
# unfocused-split-opacity = 0.7

# Unfocused split fill
# unfocused-split-fill = #1e1e2e

# ============================================================================
# ADVANCED
# ============================================================================

# Quit after last window closed
quit-after-last-window-closed = true

# Confirm close surface
confirm-close-surface = false

# Config file paths
# config-file = ~/.config/ghostty/config

# Config default files
# config-default-files = true

# Auto update
# auto-update = true

# Auto update channel (v1.3.0 stable fixes memory leak from v1.2.3, PR #10251/#10270)
auto-update-channel = stable

# Image storage limit - lowered from 160MB to 50MB to reduce memory pressure
# on 16GB system running multiple Claude Code sessions
image-storage-limit = 50000000

# Custom shaders — stack in order. Hot-reload on save, no restart needed.
# Static (no battery cost): bloom, bettercrt, retro-terminal, tft
# Animated (needs custom-shader-animation, uses GPU): cursor trails, starfield, water
# custom-shader = ~/.config/ghostty/shaders/community/bloom.glsl
# custom-shader = ~/.config/ghostty/shaders/cursor/cursor_tail.glsl
# custom-shader = ~/.config/ghostty/shaders/community/bettercrt.glsl

# Shader animation — only needed for cursor trail (renders every frame, uses GPU)
# custom-shader-animation = true

# Window class (X11)
# class = ghostty

# X11 instance name
# x11-instance-name = ghostty

# Initial window settings
# initial-window = true

# FreeType load flags
# freetype-load-flags = ""

# Linux cgroup settings
# linux-cgroup = ""
# linux-cgroup-hard-fail = false
# linux-cgroup-memory-limit = 0
# linux-cgroup-processes-limit = 0

# ============================================================================
# QUICK TERMINAL
# ============================================================================

# Quick terminal animation duration
# quick-terminal-animation-duration = 200

# Quick terminal autohide
# quick-terminal-autohide = true

# Quick terminal position
# quick-terminal-position = top

# Quick terminal screen
# quick-terminal-screen = default

# Quick terminal space behavior
# quick-terminal-space-behavior = current

# ============================================================================
# KEYBINDINGS & LINKS
# ============================================================================

# Custom keybindings
# keybind = ctrl+shift+n=new_window
# ignore (not unbind): unbind FORWARDS cmd+enter to the pty, where it reached tmux and doubled the
# Alt-Enter window-pop; ignore black-holes it at Ghostty so only Option+Enter (via macos-option-as-alt)
# pops a window. (Ghostty docs: unbind = send key through; ignore = do nothing.)
keybind = super+enter=ignore

# Link URL handling
link-url = true

