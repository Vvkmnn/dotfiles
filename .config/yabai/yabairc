################################################################################
# 2. WINDOW FOCUS BEHAVIOR
################################################################################
# Smart window focusing behavior when windows are closed/destroyed
# This ensures focus shifts to another window when the current one is closed
# https://github.com/koekeishiya/yabai/issues/1012
#
# When a window is destroyed, focus a window on the CURRENT space only (don't switch spaces)
/opt/homebrew/bin/yabai -m signal --add event=window_destroyed action='
  /opt/homebrew/bin/yabai -m query --windows --window &> /dev/null || {
    window_id=$(/opt/homebrew/bin/yabai -m query --windows --space | jq -r "[.[] | select(.\"is-visible\" == true)][0].id // empty")
    [ -n "$window_id" ] && /opt/homebrew/bin/yabai -m window --focus "$window_id"
  }
'
# Same behavior when an application is terminated - focus current space only (don't switch spaces)
/opt/homebrew/bin/yabai -m signal --add event=application_terminated action='
  /opt/homebrew/bin/yabai -m query --windows --window &> /dev/null || {
    window_id=$(/opt/homebrew/bin/yabai -m query --windows --space | jq -r "[.[] | select(.\"is-visible\" == true)][0].id // empty")
    [ -n "$window_id" ] && /opt/homebrew/bin/yabai -m window --focus "$window_id"
  }
'

################################################################################
# 3. WINDOW MANAGEMENT SIGNALS
################################################################################
# Focus handling when changing spaces
# https://github.com/koekeishiya/yabai/issues/719
#
# Focus the first VISIBLE window when switching spaces
# Filters out minimized and hidden windows to prevent focusing invisible windows
# Only focuses if a window exists (prevents errors on empty spaces)
# DISABLED: Causes random space switching on empty spaces - leaves focus undefined
#           which may trigger macOS to switch back to a space with windows.
#           Trade-off: You may need to click a window after switching spaces.
#           See: https://github.com/koekeishiya/yabai/issues/719
# /opt/homebrew/bin/yabai -m signal --add event=space_changed action='
#   window_id=$(/opt/homebrew/bin/yabai -m query --windows --space |
#     jq -r "[.[] | select(.\"is-visible\" == true and .\"is-minimized\" == false)][0].id // empty")
#   [ -n "$window_id" ] && /opt/homebrew/bin/yabai -m window --focus "$window_id"
# '

# Focus the first VISIBLE window when changing displays
# Only focuses if a window exists (prevents errors on empty spaces)
/opt/homebrew/bin/yabai -m signal --add event=display_changed action='
  window_id=$(/opt/homebrew/bin/yabai -m query --windows --space |
    jq -r "[.[] | select(.\"is-visible\" == true and .\"is-minimized\" == false)][0].id // empty")
  [ -n "$window_id" ] && /opt/homebrew/bin/yabai -m window --focus "$window_id"
'

