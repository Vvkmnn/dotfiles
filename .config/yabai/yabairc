################################################################################
# 5. APPLICATION-SPECIFIC RULES
################################################################################
# Set default layer for all applications
/opt/homebrew/bin/yabai -m rule --add app=".*" sub-layer=normal # All apps use normal sub-layer by default

# Handle floating windows automatically
# Detects windows that can't be resized or are already floating
# and makes them float with a nice position on the screen
# NOTE: We do NOT set --layer above because it causes child dialogs
# to appear behind the parent window
# See: https://github.com/koekeishiya/yabai/issues/987
# ACTIVE: explicit `if` — float ONLY windows that can't resize AND aren't already floating,
# at their natural macOS position (NO --grid). Fixes the precedence bug in the commented
# original below: `A || B && C` binds as `(A||B) && C`, so --grid ran on managed windows too
# ("cannot apply grid layout to a managed window" spam) and yanked floated dialogs off-screen.
/opt/homebrew/bin/yabai -m signal --add event=window_created action='
  info=$(/opt/homebrew/bin/yabai -m query --windows --window "$YABAI_WINDOW_ID")
  [ "$(echo "$info" | jq -r ".\"can-resize\"")" = "false" ] &&
  [ "$(echo "$info" | jq -r ".\"is-floating\"")" = "false" ] &&
    /opt/homebrew/bin/yabai -m window "$YABAI_WINDOW_ID" --toggle float
'

