################################################################################
# 4. GLOBAL CONFIGURATION SETTINGS
################################################################################
# Focus and mouse behavior.
# Mental model: tiled windows never overlap (BSP tiles them side-by-side), so z-order / "raise"
# is a no-op for them — autoraise's raise only ever affects FLOATING windows (Calculator, dialogs).
# So 'autoraise' is safe here and won't feel jumpy in normal 1-3 window tiling.
/opt/homebrew/bin/yabai -m config mouse_follows_focus on        # Keyboard focus warps the cursor to the newly-focused window
/opt/homebrew/bin/yabai -m config focus_follows_mouse autoraise # Hover a window on current space -> it gets focus (+raise; raise only matters for floaters)

# Window placement and appearance
/opt/homebrew/bin/yabai -m config window_origin_display default # Place new windows on the current display
/opt/homebrew/bin/yabai -m config window_placement second_child # Place new windows as the second child in BSP
# window_topmost — REMOVED in yabai v6 (errors 'unknown command'); kept commented for reference
# /opt/homebrew/bin/yabai -m config window_topmost off            # Windows won't stay on top by default
/opt/homebrew/bin/yabai -m config window_shadow float           # Shadows only on floating windows (visual distinction)

# Window animations
/opt/homebrew/bin/yabai -m config window_animation_duration 0.0         # Duration of window animations (0.0 = instant)
/opt/homebrew/bin/yabai -m config window_animation_easing ease_out_circ # Animation easing type
