# Single date call supplies every field every subcommand below needs (was up to 13
# separate `date` forks in `all` alone — one per field, plus 4 re-calls of `date +%Y`
# inside the leap-year ternary). One fork, parsed once, reused everywhere.
read -r _g _m _V _j _d _u _T _Y <<< "$(date '+%g %-m %V %-j %-d %-u %T %Y')"

# Leap-aware days-in-year, zero fork (pure arithmetic on $_Y from the read above).
# Verified against edge cases: 2024/leap, 2026/non-leap, 2000/leap(/400), 1900/non-leap(/100).
days_in_year() {
	if (( _Y % 400 == 0 || (_Y % 4 == 0 && _Y % 100 != 0) )); then echo 366; else echo 365; fi
}

# Days-in-month via static lookup, zero fork — replaces the old GNU/BSD `date --version`
# detection + `date -v+1m -v1d -v-1d` / `date -d ... +1 month -1 day` shell-out entirely.
# The lookup works identically on GNU and BSD date, so it's simpler AND more portable,
# not just faster.
days_in_month() {
	case "$_m" in
		1|3|5|7|8|10|12) echo 31 ;;
		4|6|9|11) echo 30 ;;
		2) [ "$(days_in_year)" = 366 ] && echo 29 || echo 28 ;;
	esac
}

zodiac_sign() {
	# MMDD as a number, built from the shared $_m/$_d (no separate date/sed forks)
	today_numeric=$((_m * 100 + _d))

	# Check the date against zodiac sign ranges using numeric comparison
	if [[ "$today_numeric" -lt 120 ]] || [[ "$today_numeric" -ge 1222 ]]; then
		echo "♑️" # Capricorn
	elif [[ "$today_numeric" -lt 219 ]]; then
		echo "♒️" # Aquarius
	elif [[ "$today_numeric" -lt 321 ]]; then
		echo "♓️" # Pisces
	elif [[ "$today_numeric" -lt 420 ]]; then
		echo "♈️" # Aries
	elif [[ "$today_numeric" -lt 521 ]]; then
		echo "♉️" # Taurus
	elif [[ "$today_numeric" -lt 621 ]]; then
		echo "♊️" # Gemini
	elif [[ "$today_numeric" -lt 723 ]]; then
		echo "♋️" # Cancer
	elif [[ "$today_numeric" -lt 823 ]]; then
		echo "♌️" # Leo
	elif [[ "$today_numeric" -lt 923 ]]; then
		echo "♍️" # Virgo
	elif [[ "$today_numeric" -lt 1023 ]]; then
		echo "♎️" # Libra
	elif [[ "$today_numeric" -lt 1122 ]]; then
		echo "♏️" # Scorpio
	elif [[ "$today_numeric" -lt 1222 ]]; then
		echo "♐️" # Sagittarius
	else
		echo "♑️" # Default to Capricorn if none of the above conditions are true
	fi
}

case "$1" in
day_of_week)
	echo "$_u|7"
	;;

day_of_month)
	echo "$_d|$(days_in_month)"
	;;

day_of_year)
	echo "$_j|$(days_in_year)"
	;;

week_of_year)
	echo "$_V|52"
	;;
current_month)
	echo "$_m|12"
	;;
year_week_based)
	# 63 == 2054
	# 72 == 2063
	echo "$_g|54"
	;;
time)
	echo "$_T"
	;;
zodiac)
	# Call the function to get zodiac sign emoji
	zodiac_sign
	;;
all)
	# Single call for all status components for performance
	# Order: biggest unit (year) → smallest unit (time), gradient stays the same
	echo "#[fg=#c0a36e]$_g|54 #[fg=#cda45c]$_m|12 #[fg=#d7af72]$_V|52 #[fg=#e0bc89]$_j|$(days_in_year) #[fg=#e8caa1]$_d|$(days_in_month) #[fg=#f0ddc6]$_u|7 #[fg=#fffaf0]$_T "
	;;
*)
	echo "Invalid argument: $1"
	exit 2
	;;
esac
