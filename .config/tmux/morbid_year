zodiac_sign() {
	# Today's month and day in MMDD format with leading zeros
	today=$(date +%m%d)

	# Convert today's date from MMDD format to a numeric value for comparison
	today_numeric=$(echo $today | sed 's/^0*//') # Remove leading zeros

	# Check the date against zodiac sign ranges using numeric comparison
	if [[ "$today_numeric" -lt 120 ]] || [[ "$today_numeric" -ge 1222 ]]; then
		echo "♑️" # Capricorn
	elif [[ "$today_numeric" -lt 219 ]]; then
		echo "♒️" # Aquarius
	elif [[ "$today_numeric" -lt 321 ]]; then
		echo "♓️" # Pisces
	elif [[ "$today_numeric" -lt 420 ]]; then
		echo "♈️" # Aries
	elif [[ "$today_numeric" -lt 521 ]]; then
		echo "♉️" # Taurus
	elif [[ "$today_numeric" -lt 621 ]]; then
		echo "♊️" # Gemini
	elif [[ "$today_numeric" -lt 723 ]]; then
		echo "♋️" # Cancer
	elif [[ "$today_numeric" -lt 823 ]]; then
		echo "♌️" # Leo
	elif [[ "$today_numeric" -lt 923 ]]; then
		echo "♍️" # Virgo
	elif [[ "$today_numeric" -lt 1023 ]]; then
		echo "♎️" # Libra
	elif [[ "$today_numeric" -lt 1122 ]]; then
		echo "♏️" # Scorpio
	elif [[ "$today_numeric" -lt 1222 ]]; then
		echo "♐️" # Sagittarius
	else
		echo "♑️" # Default to Capricorn if none of the above conditions are true
	fi
}

case "$1" in
day_of_week)
	echo "$(date +%-u)|7"
	# echo "$(date +%-u)⋮7"
	# echo "$(date +%-u)/7"
	# echo "$(date +%-u)"
	;;

day_of_month)
	# Current day of the month
	day=$(date +%-d)

	# Try to detect if we're using GNU date (Linux) or BSD date (macOS).
	if date --version >/dev/null 2>&1; then
		# GNU date command; likely a Linux system
		last_day=$(date -d "$(date +'%Y-%m-01') +1 month -1 day" +%d)
	else
		# BSD date command; likely a macOS system
		last_day=$(date -v+1m -v1d -v-1d +%d)
	fi

	# echo "$day/$last_day"
	echo "$day|$last_day"
	# echo "$day⋮$last_day"
	# echo "$day"
	;;

day_of_year)
	# Day of the year
	day=$(date +%-j)
	# Total days in the current year, accounting for leap years
	if (($(date +%Y) % 400 == 0)); then
		leap="true"
	elif (($(date +%Y) % 100 == 0)); then
		leap="false"
	elif (($(date +%Y) % 4 == 0)); then
		leap="true"
	else
		leap="false"
	fi
	total_days=$((leap ? 366 : 365))
	# echo "$day/$total_days"
	echo "$day|$total_days"
	# echo "$day⋮$total_days"
	# echo "$day"
	;;

week_of_year)
	# echo "$(date +%V)/52"
	echo "$(date +%V)|52"
	# echo "$(date +%V)⋮52"
	# ⫶
	# echo "$(date +%V)"
	;;
current_month)
	# echo "$(date +%-m)/12"
	echo "$(date +%-m)|12"
	# echo "$(date +%-m)⋮12"
	# echo "$(date +%-m)"
	;;
year_week_based)
	# 63 == 2054
	# 72 == 2063
	# echo "$(date +%g)/54"
	echo "$(date +%g)|54"
	# echo "$(date +%g)54"
	# echo "$(date +%g)"
	;;
time)
	echo "$(date +%T)"
	;;
zodiac)
	# Call the function to get zodiac sign emoji
	zodiac_sign
	;;
all)
	# Single call for all status components for performance
	echo "#[fg=#7A9FDB]$(date +%-u)|7 #[fg=#8CB0DC]$(date +%-d)|$(date -v+1m -v1d -v-1d +%d) #[fg=#9EC2DD]$(date +%-j)|$(((($(date +%Y) % 400 == 0)) || ((($(date +%Y) % 4 == 0)) && (($(date +%Y) % 100 != 0))) ? 366 : 365)) #[fg=#AED0E7]$(date +%V)|52 #[fg=#BFE3F1]$(date +%-m)|12 #[fg=#D0F0FA]$(date +%g)|54 #[fg=#FFFFFF]$(date +%T) "
	;;
*)
	echo "Invalid argument: $1"
	exit 2
	;;
esac
