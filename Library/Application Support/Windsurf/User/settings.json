{

  "editor.fontFamily": "'Hack Nerd Font', monospace", // Use Hack Nerd Font for excellent glyph/icon support.
  "editor.fontSize": 11.3, // A compact font size to maximize visible code.
  "editor.lineHeight": 1.2, // Tighter line spacing for a more compact view.
  "editor.fontLigatures": true, // Enable font ligatures for improved readability of operators.
  "editor.fontWeight": "normal", // Standard font weight.
  "editor.insertSpaces": true, // Use spaces for indentation for consistency across environments.
  "editor.tabSize": 2, // Set indentation to 2 spaces, a common standard.
  "editor.detectIndentation": true, // Automatically detect and adapt to the current file's indentation.
  "editor.glyphMargin": false, // Hide the glyph margin to save horizontal space.
  "editor.folding": false, // Disable code folding for a consistently expanded view.
  "editor.showFoldingControls": "never", // Hide folding controls to maintain a clean UI.
  "editor.wordWrap": "bounded", // Wrap lines that exceed the viewport width.
  "editor.renderWhitespace": "boundary", // Show whitespace characters only at the beginning and end of lines.
  "editor.renderFinalNewline": "on", // Ensure a final newline is rendered, preventing file truncation issues.
  "editor.linkedEditing": true, // Automatically rename matching HTML/XML tags.
  "editor.unfoldOnClickAfterEndOfLine": true, // Click after a folded line to expand it.
  "editor.guides.bracketPairs": true, // Show guides for matching bracket pairs.
  "editor.guides.highlightActiveIndentation": true, // Highlight the active indentation guide.
  "editor.bracketPairColorization.enabled": true, // Enable colorization for matching brackets.
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true, // Use a unique color pool for each bracket type.
  "editor.inlayHints.enabled": "on", // Display inline hints for parameters and types.
  "editor.scrollBeyondLastLine": true, // Allow scrolling past the last line of the file.
  "editor.smoothScrolling": true, // Enable smooth scrolling for a better visual experience.
  "editor.stickyScroll.enabled": true, // Keep parent scopes visible at the top when scrolling.
  "editor.stickyScroll.maxLineCount": 3, // Limit the number of sticky scroll lines to 3.
  "editor.scrollbar.horizontalScrollbarSize": 3, // Set a thin horizontal scrollbar to save space.
  "editor.scrollbar.verticalScrollbarSize": 3, // Set a thin vertical scrollbar to save space.
  "editor.scrollbar.scrollByPage": true, // Scroll by a full page for faster navigation.

  "editor.cursorStyle": "block-outline", // A distinct, outlined block cursor for better visibility.
  "editor.cursorBlinking": "solid", // A non-blinking, solid cursor to reduce visual distraction.
  "editor.cursorSmoothCaretAnimation": "on", // Animate cursor movement smoothly.
  "editor.multiCursorModifier": "alt", // Use the Alt/Option key to create multiple cursors.
  "editor.occurrencesHighlight": "singleFile", // Highlight occurrences of a selected symbol only within the current file.
  "editor.selectionHighlight": false, // Disable highlighting of other occurrences of the selected text.
  "editor.useTabStops": false, // Allow the cursor to move freely, not locked to tab stops.
  "editor.renderLineHighlightOnlyWhenFocus": true, // Highlight the current line only when the editor is focused.

  "vscode-neovim.neovimExecutablePaths.macOS": "/opt/homebrew/bin/nvim", // Defines the path to the Neovim executable on macOS.
  "vscode-neovim.useSystemClipboard": true, // Allows Neovim to use the system clipboard.
  "vscode-neovim.enableNeovim": true, // Enables the Neovim integration for modal editing.
  "experimental.affinity": {
    "vscode-neovim": 1 // Assigns a dedicated thread to the Neovim process for improved performance.
  },

  "editor.minimap.maxColumn": 77, // Set a maximum width for the minimap.
  "editor.minimap.showSlider": "always", // Always show the minimap's scroll slider.
  "editor.minimap.renderCharacters": false, // Do not render characters in the minimap for a cleaner look.
  "editor.minimap.scale": 1, // Set the scale of the minimap content.
  "editor.minimap.size": "fit", // The minimap will fit its size to the editor's height.
  
  "workbench.colorTheme": "Kanagawa Wave",         // Keep your beautiful dark theme
  "workbench.iconTheme": "chalice-icon-theme",     // Icon theme
  "chaliceIcons.showArrows": true,
  "workbench.productIconTheme": "bongocat",        // Product icon theme
  "workbench.colorCustomizations": {
    "foreground": "#DCD7BA", // Default foreground color for the entire workbench.
    "disabledForeground": "#727169AA", // Foreground color for disabled elements.
    "focusBorder": "#7E9CD8AA", // Overall border color for focused elements.
    "descriptionForeground": "#957FB8", // Foreground color for description text.
    "errorForeground": "#E82424", // Overall foreground color for error messages.

    "editor.background": "#16161D", // Editor background color.
    "editor.foreground": "#FFFFFF", // Editor default foreground color.
    "editorLineNumber.foreground": "#727169", // Color of editor line numbers.
    "editorLineNumber.activeForeground": "#DCA561", // Color of the active editor line number.
    "editor.lineHighlightBackground": "#3b1f02", // Background color for the highlight on the current line.
    "editorCursor.foreground": "#DCA561", // Color of the editor cursor.
    
    "editor.selectionBackground": "#DCD7BA17", // Color of the editor selection.
    "editor.inactiveSelectionBackground": "#2D4F6777", // Color of the selection in an inactive editor.
    "editor.selectionHighlightBackground": "#0049da66", // Color for regions with the same content as the selection.
    "editor.selectionHighlightBorder": "#7E9CD800", // Border color for regions with the same content as the selection.
    "editor.wordHighlightBackground": "#1616D833", // Background color of a symbol during read-access.
    "editor.wordHighlightStrongBackground": "#957FB833", // Background color of a symbol during write-access.

    "activityBar.background": "#16161D", // Activity bar background.
    "activityBar.foreground": "#DCD7BA", // Activity Bar foreground color (e.g., for icons).
    "activityBar.inactiveForeground": "#727169", // Activity Bar item foreground color when it is inactive.
    "activityBar.border": "#00000000", // Remove activity bar border.
    "activityBar.activeBorder": "#00000000", // Remove activity bar active item border.
    
  // ╭─────────────────────────────────────────────────────────╮
  // │ Workbench Layout & Panel Configuration                  │
  // ╰─────────────────────────────────────────────────────────╯
  "workbench.sideBar.location": "right",           // Sidebar on right
  "workbench.panel.defaultLocation": "bottom",     // Panel at bottom (hidden by default)
  "workbench.panel.opensMaximized": "always",      // Always maximize panel when opened
  "workbench.editor.showTabs": "multiple",               // Show editor tabs
  "workbench.editor.tabCloseButton": "right",      // Close button on tabs
  "workbench.editor.splitInGroupLayout": "vertical", // Vertical split for editor groups
  "workbench.panel.terminal.location": "left",     // Move terminal to left side
  "workbench.panel.terminal.size": 0.4,            // Terminal takes 40% of panel width
  "workbench.editor.showIcons": true,              // Show file icons in tabs
  "workbench.activityBar.location": "default",     // Activity bar in default position
  "workbench.list.smoothScrolling": true,          // Smooth scrolling in lists
  "workbench.panel.alignment": "left",             // Align panel to left side
    "python.experiments.optOutFrom": [
        "pythonTerminalEnvVarActivation"
    ],
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.terminal.activateEnvironment": true,
  "terminal.integrated.profiles.osx": {
  "zsh": {
    "path": "/bin/zsh",
    "args": ["-l"]
  }
},
"terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.splitCwd": "workspaceRoot",  // Open terminals in workspace root
  "workbench.editor.decorations.colors": true,     // Colorized decorations
  "workbench.editor.decorations.badges": false,    // No decorations badges
  "workbench.sash.hoverBorder": "transparent",     // Transparent sash borders
  "workbench.sash.size": 1,                        // Thin sashes
  "workbench.editor.enablePreview": true,          // Preview files without opening
  "workbench.tree.enableStickyScroll": true,       // Sticky scroll in trees
  "workbench.editor.pinnedTabsOnSeparateRow": false, // All tabs on same row
  "workbench.tree.renderIndentGuides": "onHover",  // Show indent guides on hover
  "workbench.tree.indent": 10,                     // Compact tree indentation
  "workbench.editor.preferredSideBySideGroupLocation": "right",
  "workbench.settings.editor": "json",             // Use JSON for settings
  "workbench.layoutControl.enabled": true,         // Show layout controls
  "workbench.editor.limit.enabled": true,          // Limit number of open editors
  "workbench.editor.limit.value": 10,              // Maximum 10 editors open
  "workbench.editor.limit.perEditorGroup": true,   // Apply limit per group
  "window.density.editorTabHeight": "compact",     // Compact tab height
  
  "terminal.integrated.fontFamily": "'Hack Nerd Font', monospace", // Use Hack Nerd Font in the integrated terminal.
  "terminal.integrated.fontSize": 11.3, // Set a compact font size for the terminal.
  "terminal.integrated.lineHeight": 1.2, // Use tighter line spacing in the terminal.
  "terminal.integrated.gpuAcceleration": "auto", // Let Windsurf decide whether to use GPU acceleration for the terminal.
  "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose", // Restore terminal sessions on restart.
  "terminal.integrated.scrollback": 5000, // Keep a large scrollback buffer of 5000 lines.
  "terminal.integrated.rightClickBehavior": "default", // Use the default right-click context menu.
  "terminal.integrated.tabs.enabled": true, // Enable tabs for the integrated terminal.

  "files.dialog.defaultPath": "/Users/v/Documents/cascade", // Set the default path for file dialogs.
  "files.autoSave": "afterDelay", // Automatically save files after a delay.
  "files.autoSaveDelay": 1000, // Set the auto-save delay to 1000ms (1 second).
  "files.enableTrash": true, // Move deleted files to the system trash.
  "files.refactoring.autoSave": true, // Automatically save files before refactoring.
  "files.saveConflictResolution": "overwriteFileOnDisk", // Automatically resolve save conflicts by overwriting.
  "files.watcherExclude": { // Exclude specific directories from file watching to improve performance.
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.hg/store/**": true,
    "**/tmp/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/.yarn/cache/**": true,
    "**/.webpack/**": true,
    "**/.next/**": true,
    "**/coverage/**": true,
    "**/.turbo/**": true
  },
  "search.exclude": { // Exclude specific directories from search results.
    "**/node_modules": true,
    "**/bower_components": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/tmp": true,
    "**/coverage": true
  },
  "search.smartCase": true, // Perform case-sensitive search only if the query contains uppercase letters.
  "search.quickAccess.preserveInput": true, // Preserve the input in quick access search boxes.

  "editor.experimental.asyncTokenization": true, // Enable experimental asynchronous tokenization for performance.
  "editor.experimentalWhitespaceRendering": "off", // Disable experimental whitespace rendering.

  "workbench.list.typeNavigationMode": "automatic", // Enable type-to-navigate in lists.
  "window.autoDetectColorScheme": false, // Do not automatically detect the OS color scheme.

  "editor.codeLens": true, // Enable CodeLens to show contextual info, like Git blame and references.

  "git.blame.editorDecoration.enabled": false, // Do not show Git blame information as an inline decoration.
  "git.blame.statusBarItem.enabled": true, // Show Git blame information in the status bar.
  "git.autofetch": true, // Automatically fetch from all remotes.
  "git.enableSmartCommit": true, // Commit all changes when there are no staged changes.
  "git.confirmSync": false, // Do not ask for confirmation before syncing.
  "git.mergeEditor.enableAutoCompleteMerge": true, // Enable auto-completion in the merge editor.
  "git.enableCommitSigning": false, // Do not sign Git commits.
  "git.openRepositoryInParentFolders": "never", // Do not scan parent folders for Git repositories.
  "git.untrackedChanges": "hidden", // Hide untracked changes in the source control view.
  "git.detectSubmodules": false, // Do not automatically detect submodules.

  "gitlens.hovers.enabled": true, // Enable GitLens hover annotations.
  "gitlens.codeLens.enabled": false, // Disable GitLens CodeLens annotations.
  "gitlens.mode.active": "zen", // Use Zen mode for a cleaner GitLens experience.
  "gitlens.currentLine.enabled": true, // Show blame annotation for the current line.
  "gitlens.statusBar.enabled": true, // Show blame information in the status bar.
  "gitlens.hovers.currentLine.over": "line", // Show the current line hover over the entire line.

  "diffEditor.renderSideBySide": false, // Use the inline view for the diff editor.
  "diffEditor.ignoreTrimWhitespace": false, // Do not ignore trim whitespace differences.
  "diffEditor.maxComputationTime": 5000, // Set the maximum time for diff computation to 5000ms.
  "diffEditor.removedTextBackground": "#00000000", // Use a transparent background for removed text in the diff editor.
  "diffEditor.insertedTextBackground": "#00000000", // Use a transparent background for inserted text in the diff editor.
  "diffEditor.diagonalFill": false, // Disable the diagonal fill pattern in the diff editor for a cleaner look.
  "debug.console.fontSize": 11.3, // Set the font size for the debug console.
  "debug.console.fontFamily": "'Hack Nerd Font', monospace", // Use Hack Nerd Font in the debug console.
  "debug.console.lineHeight": 1.2, // Set the line height for the debug console.
  "debug.toolBarLocation": "floating", // Display the debug toolbar as a floating element.

  "breadcrumbs.enabled": true, // Show breadcrumbs in the editor for easy navigation.
  "explorer.confirmDragAndDrop": false, // Do not ask for confirmation when dragging and dropping files.
  "explorer.confirmDelete": false, // Do not ask for confirmation when deleting files.

  "security.workspace.trust.untrustedFiles": "open", // Automatically open untrusted files without a prompt.
  "update.mode": "none", // Disable automatic updates for Windsurf.
  "extensions.ignoreRecommendations": true, // Do not show extension recommendations.

  "settingsSync.gist": "", // The Gist ID for settings sync (leave empty if not using Gist).
  "sync.autoUpload": true, // Automatically upload settings changes.
  "sync.autoDownload": false, // Do not automatically download settings changes.
  "sync.forceUpload": false, // Do not force upload on startup.
  "sync.forceDownload": false, // Do not force download on startup.
  "sync.quiet": true, // Perform sync operations quietly without verbose notifications.
  "sync.removeExtensions": false, // Do not remove extensions that are not in the synced list.
  "sync.syncExtensions": true, // Synchronize the list of installed extensions.
  "sync.host": "", // Custom host for settings sync (e.g., for self-hosted instances).
  "sync.pathPrefix": "", // Path prefix for the custom sync host.
  "sync.lastUpload": "", // Timestamp of the last successful upload (managed by the extension).
  "sync.lastDownload": "", // Timestamp of the last successful download (managed by the extension).
  "sync.log": false, // Disable verbose logging for settings sync.

  "settings.backup.path": "/Users/v/Library/Application Support/Code/User/sync/local-sync/backup/", // Specifies the local path for settings sync backups.

  "workbench.preferredHighContrastColorTheme": "Default High Contrast", // The default high contrast theme for accessibility.
  "accessibility.verbosity.diffEditor": true, // Enable verbose announcements in the diff editor for screen readers.

  "window.menuBarVisibility": "toggle", // Toggle the menu bar visibility with the Alt key.
  "customizeUI.titleBar": "frameless", // Use a frameless title bar for a custom look.

  "deepl.formality": "default", // Use the default formality for DeepL translations.
  "deepl.tagHandling": "off", // Disable special tag handling in DeepL.
  "deepl.splitSentences": "1", // Control sentence splitting in DeepL.
  "deepl.translationMode": "Replace", // Replace selected text with the translation.
  "editor.accessibilitySupport": "auto", // Automatically detect if accessibility support should be enabled.
  "editor.screenReaderAnnounceInlineSuggestion": true, // Announce inline suggestions for screen readers.

  "todohighlight.include": [
    "**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx",
    "**/*.html", "**/*.css", "**/*.scss", "**/*.php",
    "**/*.rb", "**/*.txt", "**/*.mdown", "**/*.md",
    "**/*.json", "**/.*", "**/*rc"
  ],
  "todohighlight.keywords": [
    {
      "text": "TODO:",
      "color": "#DCD7BA",
      "backgroundColor": "#7E9CD8",
      "overviewRulerColor": "rgba(126, 156, 216, 0.7)"
    },
    {
      "text": "FIX:",
      "color": "#DCD7BA",
      "backgroundColor": "#E82424",
      "overviewRulerColor": "rgba(232,36,36,0.8)"
    },
    {
      "text": "BUG:",
      "color": "#DCD7BA",
      "backgroundColor": "#C34043",
      "overviewRulerColor": "rgba(195,64,67,0.8)"
    },
    {
      "text": "NOTE:",
      "color": "#1F1F28",
      "backgroundColor": "#DCA561",
      "overviewRulerColor": "rgba(220,165,97,0.8)"
    },
    {
      "text": "REVIEW:",
      "color": "#DCD7BA",
      "backgroundColor": "#957FB8",
      "overviewRulerColor": "rgba(149,127,184,0.8)"
    },
    {
      "text": "WTF:",
      "color": "#DCD7BA",
      "backgroundColor": "#2D4F67",
      "overviewRulerColor": "rgba(45,79,103,0.8)"
    },
    {
      "text": "PERF:",
      "color": "#1F1F28",
      "backgroundColor": "#76946A",
      "overviewRulerColor": "rgba(118,148,106,0.8)"
    }
  ],
  "todohighlight.enableDiagnostics": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "scm.diffDecorationsGutterPattern": {
    "added": true
  },
  "diffEditor.experimental.showMoves": true,
  "editor.largeFileOptimizations": false,
  "workbench.editor.tabActionLocation": "right",
  "diffEditor.hideUnchangedRegions.enabled": true
}
