{
  // ╭─────────────────────────────────────────────────────────╮
  // │ Editor Suggestions & Completions                        │
  // ╰─────────────────────────────────────────────────────────╯
  "editor.acceptSuggestionOnEnter": "on", // Controls if suggestions are accepted on Enter key press
  "editor.suggestSelection": "first", // Controls which suggestion is selected when the list is displayed
  "editor.acceptAllSuggestionsOnEnter": true, // Accept all suggestions at once using Enter
  "editor.quickSuggestions": {
    "other": true, // Show suggestions while typing in code blocks
    "comments": false, // Don't show suggestions while typing in comments
    "strings": false // Don't show suggestions while typing in string literals
  },
  "editor.inlineSuggest.enabled": true, // Shows AI-powered inline code suggestions as ghost text
  "editor.suggest.preview": true, // Shows a preview of the selected suggestion inline
  "editor.suggest.shareSuggestSelections": true, // Share selected suggestions across editor windows
  "editor.snippetSuggestions": "inline", // Places snippet suggestions alongside other suggestions
  "editor.suggest.insertMode": "replace", // When inserting a suggestion, replace text rather than overtyping
  "editor.inlineSuggest.showToolbar": "always", // Controls when to show the inline suggestion toolbar

  // ╭─────────────────────────────────────────────────────────╮
  // │ Editor Typography & Visual Design                       │
  // ╰─────────────────────────────────────────────────────────╯
  "editor.fontFamily": "'Hack Nerd Font', monospace", // Font used in the editor
  "editor.fontSize": 12.3, // Size of the editor font in pixels
  "editor.lineHeight": 1.2, // Height of a line in the editor relative to the font size
  "editor.fontLigatures": true, // Enables font ligatures for more readable code symbols
  "editor.fontWeight": "normal", // Controls the font weight/thickness
  "editor.insertSpaces": true, // Insert spaces when Tab key is pressed
  "editor.tabSize": 2, // Number of spaces a tab is equal to
  "editor.detectIndentation": true, // Automatically detect file indentation from content
  "editor.glyphMargin": false, // Hides the glyph margin used for breakpoints and other indicators
  "editor.folding": false, // Disables code folding capability
  "editor.showFoldingControls": "never", // Removes the controls for folding/unfolding code regions

  // ╭─────────────────────────────────────────────────────────╮
  // │ Cursor & Selection Behavior                             │
  // ╰─────────────────────────────────────────────────────────╯
  "editor.cursorStyle": "block-outline", // Sets cursor to a solid block with outline for better visibility
  "editor.cursorBlinking": "solid", // Controls if the cursor blinks, solid means no blinking
  "editor.multiCursorModifier": "ctrlCmd", // Modifier key to add multiple cursors (Alt or Ctrl/Cmd)
  "editor.occurrencesHighlight": "singleFile", // Highlight symbol occurrences only in current file
  "editor.selectionHighlight": false, // Don't highlight matches of current selection
  "editor.useTabStops": false, // When disabled, cursor moves more naturally across tab stops

  // ╭─────────────────────────────────────────────────────────╮
  // │ Text Visualization & Guides                             │
  // ╰─────────────────────────────────────────────────────────╯
  "editor.wordWrap": "bounded", // Wrap long lines at the viewport width rather than horizontally scrolling
  "editor.renderWhitespace": "boundary", // Shows whitespace characters only at the beginning/end of words
  "editor.guides.bracketPairs": true, // Displays vertical lines to help match opening and closing brackets
  "editor.guides.highlightActiveIndentation": true, // Highlights the active indentation level with a different color
  "editor.bracketPairColorization.enabled": true, // Gives matching brackets the same color for easier identification
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true, // Uses different color sets for different bracket types
  "editor.renderFinalNewline": "on", // Shows the final newline at the end of a file
  "editor.renderLineHighlightOnlyWhenFocus": true, // Only highlights the current line when the editor has focus
  "editor.inlayHints.enabled": "on", // Shows additional type information inline with your code
  "editor.unfoldOnClickAfterEndOfLine": true, // Clicking after line end expands folded code blocks

  // ╭─────────────────────────────────────────────────────────╮
  // │ Scrolling & Navigation                                  │
  // ╰─────────────────────────────────────────────────────────╯
  "editor.scrollBeyondLastLine": false, // Prevents scrolling past the end of the file
  "editor.smoothScrolling": true, // Enables animated scrolling for smoother visual experience
  "editor.scrollbar.horizontalScrollbarSize": 2, // Sets horizontal scrollbar to minimal 2px thickness
  "editor.scrollbar.verticalScrollbarSize": 5, // Sets vertical scrollbar to compact 5px width
  "editor.stickyScroll.enabled": true, // Keeps parent scopes (functions/classes) visible at top while scrolling
  "editor.linkedEditing": true, // Automatically edits matching HTML/XML tags when one is modified
  "editor.stickyScroll.maxLineCount": 3, // Maximum number of sticky lines shown at the top
  "editor.scrollbar.scrollByPage": true, // Clicking scrollbar jumps by full page rather than by position
  "editor.fastScrollSensitivity": 5, // Higher sensitivity for faster scrolling with mouse wheel

  // ╭─────────────────────────────────────────────────────────╮
  // │ Minimap Configuration                                   │
  // ╰─────────────────────────────────────────────────────────╯
  "editor.minimap.maxColumn": 70, // Maximum number of columns to display in the minimap (width limitation)
  "editor.minimap.showSlider": "always", // Always shows the minimap slider regardless of mouse position
  "editor.minimap.renderCharacters": false, // Uses color blocks instead of tiny characters for better performance
  "editor.minimap.scale": 1, // Controls the scale of the minimap (1 is standard size)
  "editor.minimap.size": "fit", // Automatically sizes the minimap to fit the height of the editor view
  
  // ╭─────────────────────────────────────────────────────────╮
  // │ Workbench Theme & Visual Style                          │
  // ╰─────────────────────────────────────────────────────────╯
  "workbench.colorTheme": "Kanagawa Wave", // Japanese-inspired dark theme with calming blue and earth tones
  "workbench.iconTheme": "chalice-icon-theme", // File and folder icon set for better visual recognition
  "chaliceIcons.showArrows": true, // Displays navigation arrows in the chalice icon theme
  "workbench.productIconTheme": "bongocat", // Sets custom product icons for UI elements
  "workbench.colorCustomizations": {
    "editor.lineHighlightBackground": "#282834", // Subtle dark blue highlight for the current line
    "terminal.border": "#00000000", // Transparent terminal borders for clean UI (alpha=0)
    "panel.border": "#00000000", // Transparent panel borders for seamless look
    "sideBar.border": "#00000000", // Transparent sidebar borders to reduce visual noise
    "editorGroup.border": "#00000000", // Transparent editor group dividers for cleaner splits
    "tab.activeBorderTop": "#7E9CD8", // Kanagawa blue accent for indicating active tab
    "tab.activeBackground": "#1F1F28", // Kanagawa dark background for active tab
    "tab.inactiveBackground": "#16161D", // Slightly darker background for inactive tabs
    "editor.background": "#1F1F28", // Main editor background in Kanagawa dark tone
    "sideBar.background": "#16161D", // Slightly darker sidebar background for contrast
    "activityBar.background": "#16161D", // Matching dark background for activity bar
    "statusBar.background": "#16161D", // Consistent dark background for status bar
    "panel.background": "#16161D", // Matching dark background for bottom panels
    // "terminal.background": "#16161D", // Terminal background color (commented out)
    "terminal.tab.activeBorder": "#00000000", // Transparent border for active terminal tab
    "panelTitle.activeBorder": "#00000000", // Transparent border for active panel title
    "panelTitle.activeForeground": "#16161D", // Darker text color for active panel titles
    "terminal.tab.activeBackground": "#16161D", // Background color for active terminal tab
    "activityBar.border": "#00000000", // Transparent border for activity bar
    "activityBar.activeBorder": "#00000000", // Transparent border for active item in activity bar
    "activityBar.activeFocusBorder": "#00000000", // Transparent focus border in activity bar
    "activityBar.activeBackground": "#16161D" // Background color for active item in activity bar
  },

  // ╭─────────────────────────────────────────────────────────╮
  // │ Workbench Layout & Panel Configuration                  │
  // ╰─────────────────────────────────────────────────────────╯
  "workbench.panel.defaultLocation": "bottom", // Positions panel section at the bottom of the window
  "workbench.sideBar.location": "left", // Places the sidebar on the left side of the window
  "workbench.editor.showIcons": true, // Shows file type icons in editor tabs for quick identification
  "workbench.activityBar.location": "default", // Places activity bar in standard position (left side)
  "workbench.list.smoothScrolling": true, // Enables smooth animated scrolling in list/tree views
  "workbench.editor.decorations.colors": true, // Shows colorized decorations (e.g., git changes)
  "workbench.editor.decorations.badges": false, // Disables badge decorations for cleaner UI
  "workbench.sash.hoverBorder": "transparent", // Makes the border that appears when hovering over sash invisible
  "workbench.sash.size": 1, // Sets resize handles (sashes) to minimal 1px thickness
  "workbench.editor.enablePreview": true, // Opens files in preview mode when clicked once
  "workbench.tree.enableStickyScroll": true, // Keeps parent folders visible when scrolling tree views
  "workbench.editor.pinnedTabsOnSeparateRow": false, // Keeps all tabs in a single row for compact layout
  "workbench.tree.renderIndentGuides": "onHover", // Shows tree indentation guides only when hovering
  "workbench.tree.indent": 10, // Sets tree indent to 10px for better space utilization
  "workbench.editor.preferredSideBySideGroupLocation": "right", // New editor groups open to the right
  "workbench.settings.editor": "json", // Uses JSON mode for editing settings instead of UI
  "workbench.layoutControl.enabled": true, // Shows layout control buttons in the UI
  "workbench.editor.limit.enabled": true, // Enables the limit on number of open editor tabs
  "workbench.editor.limit.value": 10, // Sets maximum number of open editors to 10
  "workbench.editor.limit.perEditorGroup": true, // Applies the tab limit separately to each editor group
  "window.density.editorTabHeight": "compact", // Reduces the height of editor tabs for denser UI
  
  // ╭─────────────────────────────────────────────────────────╮
  // │ Terminal Configuration                                  │
  // ╰─────────────────────────────────────────────────────────╯
  "terminal.integrated.automaticRenderRequestDelay": 0, // No render delay
  "terminal.integrated.fontFamily": "'Hack Nerd Font', monospace",
  "terminal.integrated.fontSize": 12.3,            // Match editor font size
  "terminal.integrated.lineHeight": 1.2,           // Compact line height
  "terminal.integrated.minimumContrastRatio": 4.5, // Better contrast
  "terminal.integrated.customGlyphs": false,       // No custom glyphs
  "terminal.integrated.enableColorization": true,  // Colorize terminal output
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
  "terminal.integrated.tabs.enabled": true,        // Enable terminal tabs
  "terminal.integrated.cursorBlinking": true,      // Blinking cursor in terminal
  "terminal.integrated.shellIntegration.enabled": true, // Shell integration
  "terminal.integrated.scrollback": 7777,          // Generous scrollback
  "terminal.integrated.scrollbar.vertical": "hidden", // Hide scrollbar until needed
  "terminal.integrated.rightClickBehavior": "default", // Default right-click
  "terminal.integrated.enableRightClickSelection": true, // Right-click selection
  "terminal.integrated.gpuAcceleration": "on",     // Use GPU acceleration
  "terminal.integrated.fastScrollSensitivity": 5,  // Fast scrolling
  "terminal.integrated.defaultProfile.osx": "zsh", // Use zsh on macOS
  "terminal.integrated.tabs.showActiveTerminal": "singleTerminalOrNarrow",

  // ╭─────────────────────────────────────────────────────────╮
  // │ File Handling & Auto Save                               │
  // ╰─────────────────────────────────────────────────────────╯
  "files.dialog.defaultPath": "/Users/v/Documents/cascade", // Default location for open/save dialogs
  "files.autoSave": "afterDelay",                  // Auto save files
  "files.autoSaveDelay": 1000,                     // 1 second delay
  "files.enableTrash": true,                       // Use trash for deleted files
  "files.refactoring.autoSave": true,              // Auto-save on refactoring
  "files.saveConflictResolution": "overwriteFileOnDisk", // Avoid prompts

  // ╭─────────────────────────────────────────────────────────╮
  // │ Performance & Resource Optimization                     │
  // ╰─────────────────────────────────────────────────────────╯
  "files.watcherExclude": {                        // Exclude from file watching
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.hg/store/**": true,
    "**/tmp/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/.yarn/cache/**": true,
    "**/.webpack/**": true,
    "**/.next/**": true,
    "**/coverage/**": true,
    "**/.turbo/**": true
  },
  "search.exclude": {                              // Exclude from search
    "**/node_modules": true,
    "**/bower_components": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/tmp": true,
    "**/coverage": true
  },
  "search.smartCase": true,                        // Smart case search
  "editor.experimental.asyncTokenization": true,   // Async tokenization
  "editor.experimentalWhitespaceRendering": "off", // Disable experimental whitespace
  "workbench.list.typeNavigationMode": "automatic", // Faster navigation
  "window.autoDetectColorScheme": false,           // Don't auto-detect color scheme
  "search.quickAccess.preserveInput": true,        // Preserve search terms

  // ╭─────────────────────────────────────────────────────────╮
  // │ Git Integration                                         │
  // ╰─────────────────────────────────────────────────────────╯
  "git.blame.editorDecoration.enabled": false,     // No inline blame decorations
  "git.blame.statusBarItem.enabled": true,         // Show blame in status bar
  "git.autofetch": true,                           // Auto-fetch changes
  "git.enableSmartCommit": true,                   // Smart git commits
  "git.confirmSync": false,                        // No sync confirmation
  "git.mergeEditor.enableAutoCompleteMerge": true, // Auto-complete merges
  "editor.codeLens": true,                         // Enable code lens
  "git.enableCommitSigning": true,                 // Sign commits
  "gitlens.hovers.enabled": true,                  // GitLens hovers
  "gitlens.codeLens.enabled": false,               // No GitLens code lens
  "gitlens.mode.active": "zen",                    // Zen mode for GitLens
  "gitlens.currentLine.enabled": true,             // Current line blame
  "gitlens.statusBar.enabled": true,               // Status bar blame
  "gitlens.hovers.currentLine.over": "line",       // Line hover only
  "diffEditor.renderSideBySide": false,            // Inline diff view
  "git.openRepositoryInParentFolders": "never",    // Don't scan parent folders
  "git.untrackedChanges": "hidden",                // Hide untracked changes
  "git.detectSubmodules": false,                   // No submodule detection

  // ╭─────────────────────────────────────────────────────────╮
  // │ Debugging & Diagnostics                                 │
  // ╰─────────────────────────────────────────────────────────╯
  "debug.console.fontSize": 12.3,                  // Debug console font size
  "debug.console.fontFamily": "'Hack Nerd Font', monospace",
  "debug.toolBarLocation": "docked",               // Docked debug toolbar
  "debug.inlineValues": true,                      // Show inline values
  "debug.showInStatusBar": "always",               // Always show debug status

  // ╭─────────────────────────────────────────────────────────╮
  // │ Windsurf/Cascade Specific Settings                      │
  // ╰─────────────────────────────────────────────────────────╯
  "cascade.gitignoreAccess": true,                 // Access gitignore files
  "cascade.panelLocation": "right",                // Cascade panel on right
  
  // ╭─────────────────────────────────────────────────────────╮
  // │ Neovim Integration                                      │
  // ╰─────────────────────────────────────────────────────────╯
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1                 // Neovim extension affinity
  },
  "keyboard.dispatch": "keyCode",                  // Better key handling for Neovim

  // ╭─────────────────────────────────────────────────────────╮
  // │ Workspace & Security                                    │
  // ╰─────────────────────────────────────────────────────────╯
  "security.workspace.trust.untrustedFiles": "open",
  "sync.autoUpload": true,                         // Auto-upload settings
  "local-sync.backupPath": ".config/windsurf",     // Local backup path
  "sync.gist": "9b2d4665d1b0ab0e667ec0d5654038c6",
  "sync.quietSync": true,
  
  // ╭─────────────────────────────────────────────────────────╮
  // │ Translation & Accessibility                             │
  // ╰─────────────────────────────────────────────────────────╯
  "deepl.formality": "default",
  "deepl.tagHandling": "off",
  "deepl.splitSentences": "1",
  "deepl.translationMode": "Replace",
  "editor.accessibilitySupport": "auto",           // Respect OS settings
  "editor.screenReaderAnnounceInlineSuggestion": true, // Announce suggestions
  "workbench.preferredHighContrastColorTheme": "Default High Contrast",
  "accessibility.verbosity.diffEditor": true,      // Verbose diff editor

  // ╭─────────────────────────────────────────────────────────╮
  // │ Custom UI                                               │
  // ╰─────────────────────────────────────────────────────────╯
  "window.menuBarVisibility": "toggle",            // Toggle menu bar
  "customizeUI.titleBar": "frameless",             // Frameless title bar

  // ╭─────────────────────────────────────────────────────────╮
  // │ TODO Highlighting                                       │
  // ╰─────────────────────────────────────────────────────────╯
  "todohighlight.include": [
    "**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx",
    "**/*.html", "**/*.css", "**/*.scss", "**/*.php",
    "**/*.rb", "**/*.txt", "**/*.mdown", "**/*.md",
    "**/*.json", "**/.*", "**/*rc"
  ],
  "todohighlight.keywords": [
    {
      "text": "TODO:",
      "color": "#DCD7BA",
      "backgroundColor": "#7E9CD8",
      "overviewRulerColor": "rgba(126,156,216,0.8)"
    },
    {
      "text": "FIX:",
      "color": "#DCD7BA",
      "backgroundColor": "#E82424",
      "overviewRulerColor": "rgba(232,36,36,0.8)"
    },
    {
      "text": "BUG:",
      "color": "#DCD7BA",
      "backgroundColor": "#C34043",
      "overviewRulerColor": "rgba(195,64,67,0.8)"
    },
    {
      "text": "NOTE:",
      "color": "#1F1F28",
      "backgroundColor": "#DCA561",
      "overviewRulerColor": "rgba(220,165,97,0.8)"
    },
    {
      "text": "REVIEW:",
      "color": "#DCD7BA",
      "backgroundColor": "#957FB8",
      "overviewRulerColor": "rgba(149,127,184,0.8)"
    },
    {
      "text": "WTF:",
      "color": "#DCD7BA",
      "backgroundColor": "#2D4F67",
      "overviewRulerColor": "rgba(45,79,103,0.8)"
    },
    {
      "text": "PERF:",
      "color": "#1F1F28",
      "backgroundColor": "#76946A",
      "overviewRulerColor": "rgba(118,148,106,0.8)"
    }
  ],
  "todohighlight.enableDiagnostics": true
}
